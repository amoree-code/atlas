# atlas — PUBLIC repository. No private user data, ever.
#
# The private user workspace lives at ~/atlas and is a separate, local-only git
# repository. It must never appear here. These entries are a safety net, not the
# mechanism — the real separation is that the two live in different trees, and
# `atlas workspace status` / `atlas-doctor` check for violations.

# --- private workspace, if it is ever copied or symlinked in by mistake ---
# Generated local Atlas workspace data. Keep the directory names available in clones,
# but never commit user-owned contents.
personal/*
projects/*
!personal/.gitkeep
!projects/.gitkeep

# Private/machine-local application state now lives inside kernel/bridge/ (was system/,
# a sibling of engine/, before the Ocean T-224 rename) — never commit any of it.
#
# No exceptions, deliberately (T-243). T-240 carved one skill out of this rule so it could
# be version-controlled; that made a file the running client reads a tracked file, and the
# next branch switch deleted it from disk and broke /session-end. Live state under version
# control in a branchy repo means branch operations mutate the machine.
#
# Publishable content does not belong here at all — it belongs in kernel/ proper. That is
# what T-243 moves, and it is what makes this line safe to leave absolute.
bridge/*

# --- credentials ---
.env
.env.*
# Anchored (T-243). Unanchored, this negation reached into bridge/ and re-included
# bridge/.env.example despite the bridge/* rule above — a committable path inside the
# machine-local tree, in a repo whose whole premise is that none of it can publish.
!/.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
.netrc
.npmrc

# --- OS / editor ---
.DS_Store
._*
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/settings.json
# --- test scratch ---
# tests/_tmp/ is working material the suites write and rewrite. Nothing under it is
# source, reproducible or reviewable, so none of it is committed. (A negation for its
# README would not work anyway: git cannot re-include a file inside an excluded
# directory.)
tests/_tmp/

# --- build / deps ---
node_modules/
dist/
build/
coverage/
*.log
__pycache__/
*.py[cod]

# --- NOT ignored, deliberately ---
# Nested .git directories are NOT ignored. Ignoring one would hide it; we want a nested
# repository to be found and reported, not silently excluded. atlas-doctor fails loudly
# on any unexpected nested repository.

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
/graphify-out/

# graft shims bake an absolute npx cache path (leaks local username) — regenerate per machine
/.claude/helpers/graft-hooks.cjs
/.claude/helpers/graft-statusline.cjs
/.cursor/hooks/graft-hooks.cjs

# graft's Cursor hook config bakes this machine's absolute repo path (leaks local
# username, won't resolve on another machine) — regenerate per machine with `graft init`
/.cursor/hooks.json
