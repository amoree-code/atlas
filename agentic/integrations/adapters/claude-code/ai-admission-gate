#!/usr/bin/env python3
"""ai-admission-gate — PreToolUse hook (matcher: Write|Edit|MultiEdit|NotebookEdit).

T-125's provider-hook enforcement point for Claude Code. A write-capable tool call is
allowed only when the calling session currently holds an open Atlas admission whose live
run/lease/claim state still validates and whose exact scope is the file the tool is about
to touch — enforced by `cli/atlas_admission.verify_write`, never reimplemented here.

Reads a PreToolUse payload on stdin, emits a permission decision on stdout. This hook is
fail-closed the opposite way `ai-guard-push` is: that hook only inspects for a fixed set of
dangerous patterns and no-ops otherwise (allow-by-default); this hook denies on every
missing, malformed, or unverifiable condition and allows only the one proven-good case. A
tool this hook does not recognize (Read, Glob, Grep, Bash, ...) is left alone entirely —
never inspected, never blocked.

Exit 0 always: a crashed gate still emits an explicit `deny` on stdout first, so a bug in
this file cannot silently grant every write.
"""
import json
import sys
from pathlib import Path

# engine/agentic/integrations/adapters/claude-code/ai-admission-gate -> engine/cli
CLI_DIR = Path(__file__).resolve().parents[4] / "cli"
if str(CLI_DIR) not in sys.path:
    sys.path.insert(0, str(CLI_DIR))

WRITE_TOOLS = {"Write", "Edit", "MultiEdit", "NotebookEdit"}
CLIENT_ID = "claude-code"


def _target_path(tool_name, tool_input):
    if tool_name == "NotebookEdit":
        return tool_input.get("notebook_path")
    return tool_input.get("file_path")


def decide(payload):
    """(decision, reason) — decision is None for "not a write-capable tool, no-op",
    otherwise "allow" or "deny" with a human-readable reason."""
    tool_name = payload.get("tool_name")
    if tool_name not in WRITE_TOOLS:
        return None, None

    session_id = payload.get("session_id")
    tool_input = payload.get("tool_input") or {}
    target = _target_path(tool_name, tool_input)

    if not session_id or not str(session_id).strip():
        return "deny", "admission gate: no session_id in the PreToolUse payload — refused"
    if not target or not str(target).strip():
        return "deny", (f"admission gate: no target file path found in the {tool_name} "
                         f"tool_input — refused")

    try:
        import atlas_admission as admission
        import atlas_coordination as coord
    except Exception as exc:
        return "deny", f"admission gate: could not load the admission library ({exc}) — refused"

    try:
        admission.verify_write(CLIENT_ID, str(session_id).strip(), str(target).strip())
    except coord.CoordinationError as exc:
        return "deny", f"admission gate: {exc}"
    except Exception as exc:
        return "deny", (f"admission gate: unexpected error verifying admission ({exc}) — "
                         f"refused")

    return "allow", "admitted write within its exact admitted scope"


def _emit(decision, reason):
    json.dump({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": decision,
        "permissionDecisionReason": reason,
    }}, sys.stdout)


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        _emit("deny", "admission gate: malformed PreToolUse payload — refused")
        return

    decision, reason = decide(payload)
    if decision is None:
        return
    _emit(decision, reason)


if __name__ == "__main__":
    try:
        main()
    except Exception:
        _emit("deny", "admission gate: unhandled internal error — refused")
    sys.exit(0)
