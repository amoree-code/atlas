#!/usr/bin/env python3
"""ai-guard-push — PreToolUse hook. The local/remote trust boundary.

Implements the Atlas git policy (see internal/governance/policies/git.yaml) for Claude Code
specifically. Local git is fully autonomous. Anything that writes to a REMOTE stops and
asks a human. Glob permissions miss compound commands (`cd x && git push`), so this
inspects the whole command string instead.

Reads a PreToolUse payload on stdin, emits a permission decision on stdout.
Exit 0 always — a crashed guard must never block ordinary work.
"""
import json, re, sys

# A command only counts at a command position: start of string, or right after a shell
# operator. Without this, prose that merely *mentions* a command matches.
CMD_POS = r"(?:^|[;&|(\n]|&&|\|\||\$\()\s*"


def strip_noise(cmd: str) -> str:
    """Remove heredoc bodies and quoted strings — text, not commands.

    Writing a file that documents `git push` must not trip the guard; running `git push`
    must. Only executable text survives this.
    """
    # heredoc bodies:  <<'EOF' ... EOF   /   <<EOF ... EOF   /   <<-"EOF" ... EOF
    cmd = re.sub(r"<<-?\s*(['\"]?)(\w+)\1.*?^\s*\2\s*$", " HEREDOC_BODY ", cmd,
                 flags=re.S | re.M)
    # an unterminated heredoc (still being written) — drop everything after it
    cmd = re.sub(r"<<-?\s*(['\"]?)\w+\1.*", " HEREDOC_BODY ", cmd, flags=re.S)
    # single-quoted strings are never expanded; they are data
    cmd = re.sub(r"'[^']*'", " '' ", cmd)
    return cmd

# Never, without being asked for it explicitly by name.
FORBIDDEN = [
    (CMD_POS + r"git\s+push\b[^;&|\n]*(--force(?!-with-lease)|(?<![\w-])-f(?![\w-]))",
     "force push rewrites remote history"),
    (CMD_POS + r"git\s+push\b[^;&|\n]*--mirror", "mirror push overwrites every remote ref"),
    (CMD_POS + r"git\s+push\b[^;&|\n]*(--delete|\s:[\w./-]+)", "this deletes a remote branch"),
    (CMD_POS + r"gh\s+pr\s+merge\b", "merging a PR is the human's call"),
    (CMD_POS + r"gh\s+pr\s+close\b", "closing a PR is the human's call"),
    (CMD_POS + r"gh\s+repo\s+delete\b", "repository deletion is irreversible"),
]

# Touches a remote — always confirm first.
REMOTE_WRITE = [
    (CMD_POS + r"git\s+push\b", "pushes commits to a remote"),
    (CMD_POS + r"git\s+remote\s+(add|set-url|remove|rm)\b", "changes where the remote points"),
    (CMD_POS + r"gh\s+(pr\s+(create|edit|reopen)|release\s+create|repo\s+create)\b",
     "creates or edits something on GitHub"),
]


def decide(raw: str):
    cmd = strip_noise(raw)
    for pat, why in FORBIDDEN:
        if re.search(pat, cmd, re.I):
            return "deny", f"Blocked: {why}. Ask the user for this one by name."
    for pat, why in REMOTE_WRITE:
        if re.search(pat, cmd, re.I):
            return "ask", (
                f"Remote write — {why}.\n"
                "Per the Atlas git policy (git.push: approval: always), remote "
                "operations need explicit human approval.\n"
                "Report branch, commit, tests and changed files, then wait for a yes.")
    return None, None


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return
    if payload.get("tool_name") != "Bash":
        return
    cmd = (payload.get("tool_input") or {}).get("command", "")
    if not cmd:
        return
    decision, reason = decide(cmd)
    if not decision:
        return
    json.dump({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": decision,
        "permissionDecisionReason": reason,
    }}, sys.stdout)


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
