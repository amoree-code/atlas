#!/usr/bin/env python3
"""browser-verify — deterministic verification for the Browser capability.

Core runs this after an operation and feeds it the operation's own JSON on stdin. It
does not believe that JSON. It reconnects to the browser, re-reads live state, and exits
0 only when the claimed post-condition is observably true.

    exit 0  verified — live state confirms it
    exit 1  NOT verified — it may still have happened; nothing here confirmed it

There is deliberately no path by which a caller's assertion of success reaches exit 0.
"""
import importlib.util, json, os, sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
AI_OS_HOME = Path(os.environ.get("AI_OS_HOME", Path.home() / ".ai-os"))
RUNTIME = Path(os.environ.get("AI_OS_BROWSER_RUNTIME", AI_OS_HOME / "runtime" / "browser"))
SESSION = RUNTIME / "session.json"
# The default provider name lives in providers/default, so this file names no
# browser technology at all. Swapping providers is a one-line change in that
# directory and nothing above it moves.
PROVIDER = os.environ.get("BROWSER_PROVIDER") or (
    (Path(__file__).resolve().parent / "providers" / "default").read_text().strip())


def out(ok, why):
    print(json.dumps({"verified": ok, "evidence": why}))
    sys.exit(0 if ok else 1)


def load_provider():
    f = HERE / "providers" / f"{PROVIDER}_provider.py"
    spec = importlib.util.spec_from_file_location(f"_prov_{PROVIDER}", f)
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


def main():
    op = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        claim = json.loads(sys.stdin.read().strip() or "{}")
    except json.JSONDecodeError:
        out(False, "the operation produced no readable result to check")
    if claim.get("ok") is not True:
        out(False, "the operation did not report success")

    if op == "open":
        if not SESSION.exists():
            out(False, "no session file exists")
        s = json.loads(SESSION.read_text())
        try:
            os.kill(int(s["pid"]), 0)
        except OSError:
            out(False, f"recorded session pid {s.get('pid')} is not running")
        out(True, f"session pid {s['pid']} is live")

    if op == "close":
        if SESSION.exists():
            out(False, "session file still present after close")
        out(True, "session file removed and browser released")

    if op == "download":
        p = Path(claim.get("path", ""))
        if p.is_file() and p.stat().st_size > 0:
            out(True, f"file exists on disk: {p} ({p.stat().st_size} bytes)")
        out(False, f"no non-empty file at {p}")

    if not SESSION.exists():
        out(False, "no live session to verify against")
    prov = load_provider()
    h = prov.connect(json.loads(SESSION.read_text()))
    try:
        live = prov.state(h)
        expect = claim.get("expect") or {}

        # An explicit expectation always wins: it is what the caller said would be true.
        if expect.get("url_contains"):
            ok = expect["url_contains"] in live["url"]
            out(ok, f"live url {live['url']!r} "
                    f"{'contains' if ok else 'does not contain'} {expect['url_contains']!r}")
        if expect.get("selector"):
            n = len(prov.extract(h, expect["selector"])["values"])
            out(n > 0, f"{n} element(s) match {expect['selector']!r} in the live page")
        if expect.get("text_contains"):
            body = prov.read_text(h)["text"]
            ok = expect["text_contains"] in body
            out(ok, f"page text {'contains' if ok else 'does not contain'} "
                    f"{expect['text_contains']!r}")

        # Otherwise fall back to the strongest evidence the operation itself makes checkable.
        if op == "navigate":
            ok = live["url"] == claim.get("url")
            out(ok, f"live url {live['url']!r} vs reported {claim.get('url')!r}")
        if op in ("type", "select"):
            want = claim.get("value")
            got = prov.extract(h, claim.get("selector", ""), None)["values"]
            ok = bool(got) and got[0] == want
            out(ok, f"live field value {got[:1]} vs reported {want!r}")
        if op == "upload":
            got = prov.extract(h, claim.get("selector", ""), None)
            out(got["count"] > 0, f"file input still present with {got['count']} match(es)")
        if op == "scroll":
            live_y = prov.scroll(h, 0)["scrollY"]
            out(live_y == claim.get("scrollY"),
                f"live scrollY {live_y} vs reported {claim.get('scrollY')}")
        if op in ("read", "observe", "extract", "wait"):
            out(live["url"] == claim.get("url", live["url"]),
                f"page still at {live['url']!r} — read-only operation, state unchanged")

        # click and submit have no universal post-condition. Saying so is the honest
        # outcome; inventing one would be the failure this whole contract prevents.
        out(False, f"{op} has no declared post-condition — pass expect.url_contains, "
                   f"expect.selector or expect.text_contains to make it verifiable")
    finally:
        h.release()


if __name__ == "__main__":
    main()
