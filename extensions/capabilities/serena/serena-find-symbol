#!/usr/bin/env bash
# serena-find-symbol — capability op "serena.find_symbol" / "serena.find_references".
# Usage: serena-find-symbol <symbol> [path]
# Falls back to grep when serena is absent; malformed requests fail loudly.
set -euo pipefail
payload=$(cat)
if ! command -v serena >/dev/null 2>&1; then
  exec python3 -c 'import json, subprocess, sys
p = json.loads(sys.argv[1])
symbol, path = p.get("symbol"), p.get("path", ".")
if not isinstance(symbol, str) or not symbol or not isinstance(path, str):
    print("invalid fallback request: expected symbol and optional path", file=sys.stderr)
    raise SystemExit(2)
raise SystemExit(subprocess.call(["grep", "-R", "-n", "--", symbol, path]))' "$payload"
fi
exec serena find-symbol "$@" "$payload"
