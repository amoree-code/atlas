{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "packages/core": {
      "entry": ["tests/*.test.mjs", "scripts/*.mjs"],
      "project": ["src/**/*.ts", "tests/**/*.mjs", "scripts/**/*.mjs"],
      "ignore": ["tests/fixtures/**"]
    }
  }
}
