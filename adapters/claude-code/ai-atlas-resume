#!/usr/bin/env python3
"""ai-atlas-resume — SessionStart hook. Surfaces a pending Atlas handoff automatically.

## Why this exists, and why it is safe to believe

`SessionStart` supporting `hookSpecificOutput.additionalContext` was not assumed here — it
was verified twice before this file was written:

  1. `ai-response-gate` (this same adapter directory) already proves the JSON envelope for
     `UserPromptSubmit` in daily use — Arabic mode activating automatically, every
     session, is that mechanism working, observed, not read about.
  2. `SessionStart` specifically was checked with a real, isolated, headless run:
     `claude --settings <probe>.json -p "<report a marker only a hook could have added>"`
     in an empty directory, with a throwaway settings file registering exactly one
     `SessionStart` hook that emits a distinctive marker via this same envelope shape and
     nothing else. The prompt never contained the marker. The response did. That proves
     the contract for `SessionStart`, not just for `UserPromptSubmit`.

Without step 2 this file would be an assumption wearing a docstring. It is not run as
part of the automated suite (it needs a real `claude` invocation, a real API call, and is
slow) — see `tests/test-session-handoff.py` for the reasoning, and reproduce it by hand
whenever the contract needs re-proving on a new Claude Code version.

## What this hook does, exactly

Runs `ai-os context --resume --json` through the standard launcher (the same one every
other Claude Code hook in this adapter uses) and, only when it reports a pending handoff,
emits that information as `additionalContext` for the new session's first turn. Emits
nothing when there is no pending handoff, when the pointer is malformed, or when Atlas
cannot be resolved at all on this machine — a broken or absent installation must never
block a session from starting.

Reads nothing from stdin. `SessionStart`'s own payload (session id, source: startup /
resume / clear / compact) is not needed — a pending handoff is checked unconditionally on
every trigger, the same way a human running `ai-os context --resume` by hand would not
care why the session just started.

Read-only with respect to project work: this is the exact same read `ai-os context
--resume` performs for a human, run automatically instead of by request. It does not run,
approve, or commit anything, and it never executes any value found inside the pointer
(ticket id, next action, blockers, read_with) — those are only ever interpolated into a
text string for the model to read, never passed to a shell or subprocess.

Exit 0 always — a crashed or missing hook must never fail session startup.
"""
import json
import subprocess
import sys
from pathlib import Path

TIMEOUT_SECONDS = 5


def resume_argv():
    launcher = Path.home() / ".claude" / "ai-os-hook"
    if not launcher.is_file():
        return None
    return [str(launcher), "cli/atlas", "context", "--resume", "--json"]


def fetch_pending():
    argv = resume_argv()
    if not argv:
        return None
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=TIMEOUT_SECONDS)
    except Exception:
        return None
    if r.returncode != 0:
        return None
    try:
        data = json.loads(r.stdout)
    except Exception:
        return None
    return data if data.get("pending") else None


def build_context(data):
    ticket = data.get("ticket") or "?"
    lines = [f"Atlas: a previous session left a pending checkpoint for {ticket}.",
             "This is routing information only — read the ticket before acting on it."]
    if data.get("checkpointed_at"):
        lines.append(f"Checkpointed: {data['checkpointed_at']}")
    if data.get("state"):
        lines.append(f"State: {data['state']}")
    if data.get("next_action"):
        lines.append(f"Next action: {data['next_action']}")
    if data.get("blockers"):
        lines.append(f"Blockers: {data['blockers']}")
    read_with = data.get("read_with") or f"ai-os context {ticket}"
    lines.append(f"Read the full ticket with: {read_with}")
    return "\n".join(lines)


def main():
    data = fetch_pending()
    if not data:
        return
    json.dump({"hookSpecificOutput": {
        "hookEventName": "SessionStart",
        "additionalContext": build_context(data),
    }}, sys.stdout)


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
