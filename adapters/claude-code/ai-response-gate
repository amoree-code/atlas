#!/usr/bin/env python3
"""ai-response-gate — UserPromptSubmit hook. Deterministic trigger for the response policy.

core.md's routing table ("`response` — a substantial report, or bilingual output beyond a
sentence") depends on the model noticing it should run `ai-os policy response`. That is a
prose suggestion, not a guarantee, and the one case in it that is NOT a judgement call is
whether the user just wrote in Arabic — the literal bytes either are Arabic script or they
are not. This hook decides that one case deterministically instead of asking a model to
catch it under context pressure.

Detection is intentionally narrow: Arabic-script characters in the prompt. The fuzzier
English trigger phrases in the language rule ("answer", "reply", "then me", "any phrasing
that implies it") are left to model judgement — matching those as bare substrings would
misfire on nearly every unrelated English message, which is worse than not gating at all.

On a match, the full response policy (internal/governance/policies/response.md) is injected
as additionalContext for this turn only — paid for on the turns where Arabic mode actually
applies, not on every turn, so core.md stays lean the rest of the time.

Reads a UserPromptSubmit payload on stdin, emits additionalContext on stdout when the
policy applies, emits nothing otherwise. Exit 0 always — a crashed gate must never block
the user's prompt.
"""
import json, re, sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent / "cli"))

ARABIC_RE = re.compile(r"[؀-ۿݐ-ݿ]")


def policy_text():
    try:
        from aios_paths import private_path_or_die
        return (private_path_or_die("policies") / "response.md").read_text()
    except Exception:
        return None


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return
    prompt = payload.get("prompt") or ""
    if not ARABIC_RE.search(prompt):
        return
    text = policy_text()
    if not text:
        return
    note = (
        "Arabic detected in the user's message — Arabic mode is active for this and every "
        "following reply this session unless told otherwise. Apply this response policy:\n\n"
        + text
    )
    json.dump({"hookSpecificOutput": {
        "hookEventName": "UserPromptSubmit",
        "additionalContext": note,
    }}, sys.stdout)


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
