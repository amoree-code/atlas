#!/usr/bin/env python3
"""Read-only Markdown to SQLite knowledge index for `atlas knowledge-index`.

Walks a source directory recursively for Markdown notes, extracts frontmatter
tags, frontmatter references (project/ticket ids), inline `#tags`, and
Obsidian `[[wikilinks]]`, and persists deterministic rows into a SQLite
database. Never mutates files under --source-dir.

Also supports read-only query modes (`--search`, `--graph`) that read the
existing SQLite index without re-indexing, opening the database read-only.
"""

import argparse
import hashlib
import json
import os
import re
import sqlite3
import sys
from datetime import datetime, timezone

WIKILINK_RE = re.compile(r"\[\[([^\[\]\|]+)(?:\|[^\[\]]+)?\]\]")
TAG_RE = re.compile(r"(?<![\w#])#([A-Za-z][A-Za-z0-9_/\-]*)")
URL_RE = re.compile(r"https?://\S+")
HEADING_RE = re.compile(r"(?m)^\s{0,3}#{1,6}(?=\s)")
FRONTMATTER_RE = re.compile(r"^---\s*\n(.*?\n)---\s*\n", re.DOTALL)
FM_TAGS_LINE_RE = re.compile(r"(?m)^tags:\s*(.*)$")
FM_LIST_ITEM_RE = re.compile(r"^\s*-\s*(.+)$")
FM_REF_KEYS = ("project", "project_id", "ticket", "ticket_id")
SENSITIVE_PATH_SEGMENTS = {
    "secret", "secrets", "credential", "credentials", "private", "vault", "keys", "key", ".ssh",
}
SENSITIVE_PATH_PARTS = ("secret", "credential", "token", "private-key")


def strip_code_fences(text):
    lines = text.split("\n")
    out = []
    in_fence = False
    fence_marker = None
    for line in lines:
        stripped = line.strip()
        if not in_fence and (stripped.startswith("```") or stripped.startswith("~~~")):
            in_fence = True
            fence_marker = stripped[:3]
            continue
        if in_fence:
            if stripped.startswith(fence_marker):
                in_fence = False
            continue
        out.append(line)
    return "\n".join(out)


def strip_inline_code(text):
    return re.sub(r"`[^`]*`", " ", text)


def strip_urls(text):
    return URL_RE.sub(" ", text)


def strip_heading_markers(text):
    return HEADING_RE.sub("", text)


def parse_frontmatter_refs(block):
    """Return sorted (kind, value) pairs for project/ticket refs in a frontmatter block."""
    refs = []
    for key in FM_REF_KEYS:
        match = re.search(r"(?m)^%s:\s*(.+)$" % re.escape(key), block)
        if not match:
            continue
        value = match.group(1).strip().strip("\"'")
        if value:
            refs.append((key, value))
    return sorted(set(refs))


def parse_frontmatter(text):
    """Return (tags, refs, body) extracted from a leading YAML-ish frontmatter block."""
    if not text.startswith("---"):
        return [], [], text

    match = FRONTMATTER_RE.match(text)
    if not match:
        return [], [], text

    block = match.group(1)
    body = text[match.end():]
    refs = parse_frontmatter_refs(block)

    tags_match = FM_TAGS_LINE_RE.search(block)
    if not tags_match:
        return [], refs, body

    rest = tags_match.group(1).strip()
    tags = []
    if rest.startswith("["):
        inner = rest.strip("[]")
        tags = [t.strip().strip("\"'") for t in inner.split(",") if t.strip()]
    elif rest:
        tags = [t.strip().strip("\"'") for t in rest.split(",") if t.strip()]
    else:
        after = block[tags_match.end():]
        for line in after.split("\n"):
            item_match = FM_LIST_ITEM_RE.match(line)
            if item_match:
                tags.append(item_match.group(1).strip().strip("\"'"))
            elif line.strip() == "":
                continue
            else:
                break

    return [t for t in tags if t], refs, body


def extract_wikilinks(text):
    targets = set()
    for match in WIKILINK_RE.finditer(text):
        target = match.group(1).strip()
        if target.lower().endswith(".md"):
            target = target[:-3]
        if target:
            targets.add(target)
    return sorted(targets)


def extract_inline_tags(text):
    scrubbed = strip_urls(text)
    scrubbed = strip_heading_markers(scrubbed)
    return sorted(set(TAG_RE.findall(scrubbed)))


def sha256_bytes(data):
    return hashlib.sha256(data).hexdigest()


def path_without_ext(path):
    if path.lower().endswith(".md"):
        return path[:-3]
    return path


def path_basename_without_ext(path):
    return path_without_ext(os.path.basename(path))


def is_sensitive_path(path):
    normalized = path.replace("\\", "/")
    for segment in normalized.split("/"):
        lowered = segment.lower()
        if lowered in SENSITIVE_PATH_SEGMENTS or lowered.startswith(".env") or any(part in lowered for part in SENSITIVE_PATH_PARTS):
            return True
    return False


def ensure_schema(conn, rebuild):
    if rebuild:
        for table in ("backlinks", "links", "tags", "note_refs", "note_events", "index_runs", "notes"):
            conn.execute("DROP TABLE IF EXISTS %s" % table)
    conn.execute(
        """
        CREATE TABLE IF NOT EXISTS notes (
            path TEXT PRIMARY KEY,
            content_hash TEXT NOT NULL,
            size_bytes INTEGER NOT NULL,
            mtime REAL NOT NULL,
            tags TEXT NOT NULL,
            links TEXT NOT NULL,
            indexed_at TEXT NOT NULL,
            removed INTEGER NOT NULL DEFAULT 0
        )
        """
    )
    conn.execute("CREATE TABLE IF NOT EXISTS tags (path TEXT NOT NULL, tag TEXT NOT NULL, PRIMARY KEY (path, tag))")
    conn.execute("CREATE TABLE IF NOT EXISTS links (source_path TEXT NOT NULL, target TEXT NOT NULL, PRIMARY KEY (source_path, target))")
    conn.execute("CREATE TABLE IF NOT EXISTS backlinks (target TEXT NOT NULL, source_path TEXT NOT NULL, PRIMARY KEY (target, source_path))")
    conn.execute("CREATE TABLE IF NOT EXISTS note_refs (path TEXT NOT NULL, kind TEXT NOT NULL, value TEXT NOT NULL, PRIMARY KEY (path, kind, value))")
    conn.execute("CREATE TABLE IF NOT EXISTS note_events (path TEXT NOT NULL, event TEXT NOT NULL, occurred_at TEXT NOT NULL)")
    conn.execute("CREATE TABLE IF NOT EXISTS index_runs (run_id INTEGER PRIMARY KEY AUTOINCREMENT, indexed_at TEXT NOT NULL, source_dir TEXT NOT NULL)")
    conn.commit()


def iter_markdown_files(source_dir):
    found = []
    for root, dirs, files in os.walk(source_dir):
        dirs.sort()
        for name in sorted(files):
            if name.lower().endswith(".md"):
                full_path = os.path.join(root, name)
                rel_path = os.path.relpath(full_path, source_dir)
                found.append((rel_path, full_path))
    found.sort(key=lambda item: item[0])
    return found


def fetch_note_record(conn, path):
    row = conn.execute(
        "SELECT content_hash FROM notes WHERE path = ? AND removed = 0", (path,)
    ).fetchone()
    if row is None:
        return None
    tags = sorted(r[0] for r in conn.execute("SELECT tag FROM tags WHERE path = ?", (path,)).fetchall())
    links = sorted(r[0] for r in conn.execute("SELECT target FROM links WHERE source_path = ?", (path,)).fetchall())
    ref_rows = conn.execute(
        "SELECT kind, value FROM note_refs WHERE path = ? ORDER BY kind, value", (path,)
    ).fetchall()
    references = [{"kind": kind, "value": value} for kind, value in ref_rows]
    return {
        "path": path,
        "content_hash": row[0],
        "tags": tags,
        "references": references,
        "links": links,
    }


def cmd_search(conn, term, include_sensitive):
    active_paths = {row[0] for row in conn.execute("SELECT path FROM notes WHERE removed = 0")}

    matched = {path for path in active_paths if term.lower() in path.lower()}
    like_term = "%" + term + "%"
    for row in conn.execute("SELECT DISTINCT path FROM tags WHERE tag LIKE ?", (like_term,)):
        if row[0] in active_paths:
            matched.add(row[0])
    for row in conn.execute("SELECT DISTINCT path FROM note_refs WHERE value LIKE ?", (like_term,)):
        if row[0] in active_paths:
            matched.add(row[0])

    if not include_sensitive:
        matched = {path for path in matched if not is_sensitive_path(path)}

    notes = [record for record in (fetch_note_record(conn, path) for path in sorted(matched)) if record is not None]

    return {
        "status": "ok",
        "mode": "search",
        "term": term,
        "notes": notes,
    }


def cmd_graph(conn, target, include_sensitive):
    active_paths = {row[0] for row in conn.execute("SELECT path FROM notes WHERE removed = 0")}

    candidates = set()
    for path in active_paths:
        if path == target or path_without_ext(path) == target or path_basename_without_ext(path) == target:
            candidates.add(path)

    if not include_sensitive:
        candidates = {path for path in candidates if not is_sensitive_path(path)}

    target_names = {target}
    for path in candidates:
        target_names.add(path_without_ext(path))
        target_names.add(path_basename_without_ext(path))

    linked_to = set()
    for path in candidates:
        for row in conn.execute("SELECT target FROM links WHERE source_path = ?", (path,)):
            linked_to.add(row[0])

    linked_from = set()
    placeholders = ",".join("?" for _ in target_names)
    for row in conn.execute(
        "SELECT DISTINCT source_path FROM links WHERE target IN (%s)" % placeholders,
        tuple(target_names),
    ):
        if row[0] in active_paths:
            linked_from.add(row[0])

    if not include_sensitive:
        linked_from = {path for path in linked_from if not is_sensitive_path(path)}

    notes = [record for record in (fetch_note_record(conn, path) for path in sorted(candidates)) if record is not None]

    return {
        "status": "ok",
        "mode": "graph",
        "target": target,
        "notes": notes,
        "linked_to": sorted(linked_to),
        "linked_from": sorted(linked_from),
    }


def parse_args(argv):
    parser = argparse.ArgumentParser(
        prog="atlas knowledge-index",
        description="Build a read-only Markdown knowledge index into SQLite.",
    )
    parser.add_argument("--source-dir", help="Directory of Markdown notes to scan (required unless --search/--graph)")
    parser.add_argument("--db", required=True, help="Path to the SQLite database file")
    parser.add_argument("--rebuild", action="store_true", help="Drop and rebuild the index from scratch")
    parser.add_argument("--search", help="Query the existing index for notes matching a search term (read-only)")
    parser.add_argument("--graph", help="Query the existing index for notes linked to a path or link target (read-only)")
    parser.add_argument(
        "--include-sensitive-paths",
        action="store_true",
        help="Include sensitive paths in query results (excluded by default)",
    )
    return parser.parse_args(argv)


def main(argv=None):
    args = parse_args(argv if argv is not None else sys.argv[1:])

    if args.search is not None and args.graph is not None:
        print(json.dumps({"status": "error", "error": "cannot combine --search and --graph"}, sort_keys=True))
        return 1

    db_path = os.path.abspath(args.db)

    if args.search is not None or args.graph is not None:
        if not os.path.isfile(db_path):
            print(json.dumps({"status": "error", "error": f"db not found: {db_path}"}, sort_keys=True))
            return 1
        conn = sqlite3.connect("file:%s?mode=ro" % db_path, uri=True)
        try:
            if args.search is not None:
                result = cmd_search(conn, args.search, args.include_sensitive_paths)
            else:
                result = cmd_graph(conn, args.graph, args.include_sensitive_paths)
        finally:
            conn.close()
        print(json.dumps(result, sort_keys=True))
        return 0

    if not args.source_dir:
        print(
            json.dumps(
                {"status": "error", "error": "--source-dir is required unless --search or --graph is given"},
                sort_keys=True,
            )
        )
        return 1

    source_dir = os.path.abspath(args.source_dir)

    if not os.path.isdir(source_dir):
        print(json.dumps({"status": "error", "error": f"source-dir not found: {source_dir}"}, sort_keys=True))
        return 1

    db_dir = os.path.dirname(db_path)
    if db_dir:
        os.makedirs(db_dir, exist_ok=True)

    indexed_at = datetime.now(timezone.utc).isoformat()

    conn = sqlite3.connect(db_path)
    try:
        ensure_schema(conn, args.rebuild)

        files = iter_markdown_files(source_dir)
        seen_paths = set()

        created = 0
        updated = 0
        unchanged = 0
        all_tags = set()
        all_links = set()

        for rel_path, full_path in files:
            seen_paths.add(rel_path)
            stat = os.stat(full_path)
            with open(full_path, "rb") as handle:
                raw = handle.read()
            content_hash = sha256_bytes(raw)
            text = raw.decode("utf-8", errors="replace")

            frontmatter_tags, refs, body = parse_frontmatter(text)
            clean_body = strip_inline_code(strip_code_fences(body))

            links = extract_wikilinks(clean_body)
            inline_tags = extract_inline_tags(clean_body)
            tags = sorted(set(frontmatter_tags) | set(inline_tags))

            all_tags.update(tags)
            all_links.update(links)

            tags_json = json.dumps(tags, sort_keys=True)
            links_json = json.dumps(links, sort_keys=True)

            existing = conn.execute(
                "SELECT content_hash, removed FROM notes WHERE path = ?", (rel_path,)
            ).fetchone()

            if existing is None:
                conn.execute(
                    """
                    INSERT INTO notes (path, content_hash, size_bytes, mtime, tags, links, indexed_at, removed)
                    VALUES (?, ?, ?, ?, ?, ?, ?, 0)
                    """,
                    (rel_path, content_hash, stat.st_size, stat.st_mtime, tags_json, links_json, indexed_at),
                )
                created += 1
            elif existing[0] != content_hash or existing[1]:
                conn.execute(
                    """
                    UPDATE notes
                    SET content_hash = ?, size_bytes = ?, mtime = ?, tags = ?, links = ?, indexed_at = ?, removed = 0
                    WHERE path = ?
                    """,
                    (content_hash, stat.st_size, stat.st_mtime, tags_json, links_json, indexed_at, rel_path),
                )
                updated += 1
            else:
                unchanged += 1

            conn.execute("DELETE FROM tags WHERE path = ?", (rel_path,))
            conn.execute("DELETE FROM links WHERE source_path = ?", (rel_path,))
            conn.execute("DELETE FROM backlinks WHERE source_path = ?", (rel_path,))
            conn.execute("DELETE FROM note_refs WHERE path = ?", (rel_path,))
            conn.executemany("INSERT INTO tags (path, tag) VALUES (?, ?)", ((rel_path, tag) for tag in tags))
            conn.executemany("INSERT INTO links (source_path, target) VALUES (?, ?)", ((rel_path, target) for target in links))
            conn.executemany("INSERT INTO backlinks (target, source_path) VALUES (?, ?)", ((target, rel_path) for target in links))
            conn.executemany(
                "INSERT INTO note_refs (path, kind, value) VALUES (?, ?, ?)",
                ((rel_path, kind, value) for kind, value in refs),
            )

        active_paths = [
            row[0] for row in conn.execute("SELECT path FROM notes WHERE removed = 0").fetchall()
        ]
        removed_count = 0
        for path in active_paths:
            if path not in seen_paths:
                conn.execute(
                    "UPDATE notes SET removed = 1, indexed_at = ? WHERE path = ?",
                    (indexed_at, path),
                )
                conn.execute(
                    "INSERT INTO note_events (path, event, occurred_at) VALUES (?, 'removed', ?)",
                    (path, indexed_at),
                )
                removed_count += 1

        conn.execute("INSERT INTO index_runs (indexed_at, source_dir) VALUES (?, ?)", (indexed_at, source_dir))
        conn.commit()
    finally:
        conn.close()

    summary = {
        "status": "ok",
        "source_dir": source_dir,
        "db": db_path,
        "rebuild": bool(args.rebuild),
        "indexed_at": indexed_at,
        "files_scanned": len(files),
        "notes_created": created,
        "notes_updated": updated,
        "notes_unchanged": unchanged,
        "notes_removed": removed_count,
        "unique_tags": len(all_tags),
        "unique_links": len(all_links),
    }
    print(json.dumps(summary, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
