#!/usr/bin/env bash
# atlas — the single entry point. Everything else is a subcommand of exactly one verb,
# so the documented `atlas init` is the command that actually exists.
#
# T-031 (Phase H, Slice 2): this is now the canonical CLI name. `cli/atlas` is kept as a
# thin compatibility alias that execs this same file — both names resolve identically
# during the deprecation window (migration-plan.md §Compatibility shims). Internal
# subcommand scripts (`atlas-doctor`, `atlas-tickets`, ...) keep their current filenames;
# renaming them is out of this ticket's scope (implementation detail, not a user-facing
# name) and would multiply risk for no behavior change.
set -euo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION="$(cat "$SELF_DIR/../VERSION" 2>/dev/null || echo unknown)"

usage() { cat <<EOF
atlas v$VERSION — a portable operating layer for AI coding agents.

New machine? Run:  atlas setup apply --approve
That one command does init + structure + adapters + onboard + doctor for you —
the four setup commands below exist as its named parts, not four separate first steps.

SETUP — first run, once per machine
  atlas setup <cmd>         plan | apply --approve — the one first-run command, above
  atlas init [--dry-run]     create/verify the private workspace's folders (no interview)
  atlas onboard [cmd]        the interview: who you are, so the rest has a starting point
  atlas structure <cmd>      plan | apply --approve | check — adopt/verify the layout
  atlas migrate <cmd>       plan | apply | rollback — one-time old-layout data move
  atlas update <cmd>        check | plan | apply --approve — local engine-version bookkeeping

HEALTH — read-only checks, run anytime
  atlas status               one-screen dashboard: where each layer is, contract holding?
  atlas doctor [--quiet]     deep audit of the public/private/runtime boundary
  atlas privacy-scan [path]  check the public repo for credentials and personal data before publishing
  atlas docs <cmd>          check | build | sync — generated Atlas Environment guidance

WORKSPACE — where things live
  atlas root                 resolve the canonical Atlas root
  atlas project <id>         resolve one canonical project directory
  atlas workspace <cmd>      local git versioning of the private workspace

MEMORY & KNOWLEDGE
  atlas memory <cmd>         status | doctor | attach — the memory engine
  atlas knowledge-index      index Markdown knowledge into SQLite (source stays read-only)
  atlas render <skill>       resolve a canonical skill for one client
  atlas policy <name>        list | doctor | <module> — governance, loaded on demand

TICKETS & SESSIONS
  atlas tickets <cmd>        list | index | doctor | log | checkpoint — task records
  atlas context [ticket]     the cold-start packet: project, live tickets, git state
  atlas activity              read-only live ticket and agent activity snapshot
  atlas lifecycle [effort]   continue, checkpoint, compact, restart or hand off
  atlas usage [--json]       measured token spend per session, from client transcripts
  atlas observe -- <cmd>     run it, keep the output, return only what decides

AGENTIC RUNS — layered: run < agentic < mission < coordinator
  atlas run <cmd>            create | step | status | list — bounded execution boundary
  atlas agentic <cmd>        create | show | validate | list | transition | capture |
                             check | approve — bounded controller envelope, one run
  atlas mission <cmd>        create | approve | show | status — T-051-S1 owner-approved
                             mission contract and durable run state ONLY; no planner,
                             executor, verifier, or continuation loop runs yet
  atlas coordinator <cmd>    route | prepare | dispatch | review | cost | lease | claim |
                             transition | begin | finalize — T-050 owner-gated auto-route +
                             lease/claim/state + the S7 begin/finalize workflow
  atlas handoff <cmd>        prepare | approve | send | receive | show | list — handoffs

INTEGRATIONS — clients, capabilities, channels
  atlas adapter <cmd>        list | doctor — the client adapter registry
  atlas integration <cmd>    detect | inventory | register | list — provider-neutral records
  atlas capability <cmd>     list | doctor — the capability registry (what Atlas can do)
  atlas capability-route     choose a declared provider for one capability (read-only)
  atlas domain <cmd>         list | doctor — the domain registry (declarations only)
  atlas channel resolve      bind a channel to an explicit project and session
  atlas channel packet       create a read-only extension/desktop/Obsidian packet

  atlas version

Deprecated: 'atlas plugin' is a compatibility alias for 'capability' — use 'capability'.

Two layers, two owners:
  public   this repository   reusable software — publishable
  private  \$ATLAS_HOME, default ~/atlas   your memory, knowledge, projects — never published

The runtime layer at ~/.ai is retired: its engine is this cli/, its client integration is
adapters/<client>/, and its transient state is \$ATLAS_HOME/runtime/.

See docs/design/public-private.md, contracts/adapter.schema.md,
contracts/capability.schema.md, contracts/domain.schema.md and contracts/run.schema.md.
EOF
}

cmd="${1:-status}"; shift || true
export ATLAS_HOME="${ATLAS_HOME:-$HOME/atlas}"
case "$cmd" in
  structure|init|setup|doctor|help|--help|-h|version|--version|-V) ;;
  *)
    if [ -e "$ATLAS_HOME/.atlas-workspace.json" ] || [ -L "$ATLAS_HOME/.atlas-workspace.json" ]; then
      python3 "$SELF_DIR/atlas-structure" check --quiet || exit $?
    fi
    ;;
esac
case "$cmd" in
  structure) exec python3 "$SELF_DIR/atlas-structure" "$@" ;;
  root)
    root_path="${ATLAS_HOME:-$HOME/atlas}"
    [ -d "$root_path" ] || { echo "atlas root: canonical root is missing: $root_path" >&2; exit 4; }
    (cd "$root_path" && pwd -P)
    ;;
  project) exec "$SELF_DIR/atlas-paths" project "$@" ;;
  channel) exec "$SELF_DIR/atlas-channel" "$@" ;;
  capability-route) exec "$SELF_DIR/atlas-capability-route" "$@" ;;
  knowledge-index) exec "$SELF_DIR/atlas-knowledge-index" "$@" ;;
  docs) exec "$SELF_DIR/atlas-docs" "$@" ;;
  activity) exec "$SELF_DIR/atlas-activity" "$@" ;;
  # T-015/016/017/018 cut context/observe/usage/lifecycle over to a workspace-owned copy
  # under ${ATLAS_HOME}/context/, kept in step with this repo's copy by hand until parity
  # was proven (test-context-parity.py, T-105). T-118 retired that copy and the parity
  # mechanism once the proof held: engine/cli/ is the sole implementation of all four now,
  # dispatched exactly like every other command below.
  init|onboard|doctor|status|workspace|privacy-scan|adapter|integration|migrate|setup|update|capability|domain|run|agentic|render|memory|handoff|coordinator|mission|tickets|policy|context|observe|usage|lifecycle) exec "$SELF_DIR/atlas-$cmd" "$@" ;;
  # Compatibility alias, kept for one version. `capability` is the current name.
  plugin) exec "$SELF_DIR/atlas-plugin" "$@" ;;
  version|--version|-V) echo "$VERSION" ;;
  help|--help|-h)       usage ;;
  *) echo "atlas: unknown command '$cmd'" >&2; echo >&2; usage >&2; exit 2 ;;
esac
