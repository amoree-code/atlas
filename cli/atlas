#!/usr/bin/env bash
# atlas — the single entry point. Everything else is a subcommand of exactly one verb,
# so the documented `atlas init` is the command that actually exists.
#
# T-031 (Phase H, Slice 2): this is now the canonical CLI name. `cli/ai-os` is kept as a
# thin compatibility alias that execs this same file — both names resolve identically
# during the deprecation window (migration-plan.md §Compatibility shims). Internal
# subcommand scripts (`ai-os-doctor`, `ai-os-tickets`, ...) keep their current filenames;
# renaming them is out of this ticket's scope (implementation detail, not a user-facing
# name) and would multiply risk for no behavior change.
set -euo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION="$(cat "$SELF_DIR/../VERSION" 2>/dev/null || echo unknown)"

usage() { cat <<EOF
atlas v$VERSION — a portable operating layer for AI coding agents.

  atlas init [--dry-run]     create/verify your private workspace (never overwrites)
  atlas onboard [cmd]        first-run setup: who you are, so the rest has a starting point
  atlas doctor [--quiet]     verify the public/private contract (reports only)
  atlas status               where each layer is and whether the contract holds
  atlas root                 resolve the canonical Atlas root
  atlas project <id>         resolve one canonical project directory
  atlas channel resolve      bind a channel to an explicit project and session
  atlas channel packet       create a read-only extension/desktop/Obsidian packet
  atlas capability-route     choose a declared provider for one capability (read-only)
  atlas knowledge-index      index Markdown knowledge into SQLite (source remains read-only)
  atlas workspace <cmd>      local versioning of the private workspace
  atlas adapter <cmd>        list | doctor — the client adapter registry
  atlas capability <cmd>     list | doctor — the capability registry
  atlas plugin <cmd>         compatibility alias for 'capability'
  atlas domain <cmd>         list | doctor — the domain registry (declarations only)
  atlas run <cmd>            create | step | status | list — bounded execution boundary
  atlas handoff <cmd>        prepare | approve | send | receive | show | list — handoffs
  atlas coordinator <cmd>    route | prepare | dispatch | review | cost | lease | claim |
                             transition | begin | finalize — T-050 owner-gated auto-route +
                             lease/claim/state + the S7 begin/finalize workflow
  atlas mission <cmd>        create | approve | show | status — T-051-S1 owner-approved
                             mission contract and durable run state ONLY; no planner,
                             executor, verifier, or continuation loop runs yet
  atlas render <skill>       resolve a canonical skill for one client
  atlas memory <cmd>         status | doctor | attach — the memory engine
  atlas context [ticket]     the cold-start packet: project, live tickets, git state
  atlas observe -- <cmd>     run it, keep the output, return only what decides
  atlas policy <name>        list | doctor | <module> — governance, loaded on demand
  atlas tickets <cmd>        list | index | doctor | log | checkpoint — task records
  atlas usage [--json]       measured token spend per session, from client transcripts
  atlas lifecycle [effort]   continue, checkpoint, compact, restart or hand off
  atlas privacy-scan [path]  check the public repo for credentials and personal data
  atlas version

  Compatibility: \`ai-os\` is a temporary alias for \`atlas\` (T-031, Phase H) — both names
  resolve identically. It is not removed by this transition; removal is a later,
  separately-approved deprecation-window ticket (migration-plan.md Phase I3).

Two layers, two owners:
  public   this repository   reusable software — publishable
  private  \$ATLAS_HOME, default ~/atlas   your memory, knowledge, projects — never published
           (compatibility fallback: \$AI_OS_HOME, default ~/.ai-os, used only where Atlas
           lacks the requested resource — see cli/ai-os-paths)

The runtime layer at ~/.ai is retired: its engine is this cli/, its client integration is
adapters/<client>/, and its transient state is \$ATLAS_HOME/internal/runtime/ (compatibility
fallback: \$AI_OS_HOME/internal/runtime/).

See docs/design/public-private.md, schemas/adapter.schema.md,
schemas/capability.schema.md, schemas/domain.schema.md and schemas/run.schema.md.
EOF
}

cmd="${1:-status}"; shift || true
case "$cmd" in
  root)
    root_path="${ATLAS_HOME:-$HOME/atlas}"
    [ -d "$root_path" ] || { echo "atlas root: canonical root is missing: $root_path" >&2; exit 4; }
    (cd "$root_path" && pwd -P)
    ;;
  # T-015: observe's canonical implementation and write destination are now Atlas-owned
  # (~/atlas/context/ai-os-observe -> ~/atlas/runtime/observations/). This line is a thin
  # compatibility handoff; ai-os-observe under cli/ is historical only, no longer invoked.
  # No other command's dispatch changed.
  observe) exec "${ATLAS_HOME:-$HOME/atlas}/context/ai-os-observe" "$@" ;;
  # T-016: context's canonical implementation is now Atlas-owned
  # (${ATLAS_HOME:-~/atlas}/context/ai-os-context); durable data authority
  # (projects/personal/governance) is unchanged — this implementation still resolves
  # those through the same legacy sources ai-os-context always has. cli/ai-os-context is
  # historical only, no longer invoked. usage and lifecycle are untouched and remain
  # legacy canonical.
  context) exec "${ATLAS_HOME:-$HOME/atlas}/context/ai-os-context" "$@" ;;
  # T-017: usage's canonical implementation is now Atlas-owned
  # (${ATLAS_HOME:-~/atlas}/context/ai-os-usage). It reads client transcripts and, via
  # --baseline, caller-provided files, exactly as before — no telemetry writer was added
  # and no data authority changed. cli/ai-os-usage is historical only, no longer invoked.
  # lifecycle remains untouched and legacy canonical; usage's import of aios_lifecycle.py
  # is a pure-function library (no filesystem/subprocess), not the dispatched lifecycle
  # command, so this does not cut lifecycle over.
  usage) exec "${ATLAS_HOME:-$HOME/atlas}/context/ai-os-usage" "$@" ;;
  # T-018: lifecycle's canonical implementation is now Atlas-owned
  # (${ATLAS_HOME:-~/atlas}/context/ai-os-lifecycle). Its sibling() loader resolves
  # "ai-os-context"/"ai-os-usage" relative to its own file location, so running from
  # context/ makes it load the Atlas ai-os-context/ai-os-usage (already canonical since
  # T-016/T-017) with no legacy fallback possible — verified by direct execution, not
  # inferred. All four context mechanisms are now Atlas canonical; durable/runtime data
  # authority (tickets, projects, transcripts) is unchanged. cli/ai-os-lifecycle is
  # historical only, no longer invoked.
  lifecycle) exec "${ATLAS_HOME:-$HOME/atlas}/context/ai-os-lifecycle" "$@" ;;
  project) exec "$SELF_DIR/ai-os-paths" project "$@" ;;
  channel) exec "$SELF_DIR/ai-os-channel" "$@" ;;
  capability-route) exec "$SELF_DIR/ai-os-capability-route" "$@" ;;
  knowledge-index) exec "$SELF_DIR/ai-os-knowledge-index" "$@" ;;
  init|onboard|doctor|status|workspace|privacy-scan|adapter|capability|domain|run|render|memory|handoff|coordinator|mission|tickets|policy) exec "$SELF_DIR/ai-os-$cmd" "$@" ;;
  # Compatibility alias, kept for one version. `capability` is the current name.
  plugin) exec "$SELF_DIR/ai-os-plugin" "$@" ;;
  version|--version|-V) echo "$VERSION" ;;
  help|--help|-h)       usage ;;
  *) echo "atlas: unknown command '$cmd'" >&2; echo >&2; usage >&2; exit 2 ;;
esac
