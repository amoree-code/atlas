#!/usr/bin/env python3
"""atlas channel resolve: read-only resolver for a project/session channel."""

import json
import os
import re
import subprocess
import sys

TOKEN_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$")


def fail(message):
    sys.stderr.write("atlas channel resolve: %s\n" % message)
    sys.exit(1)


def validate_token(name, value):
    if value is None or value == "":
        fail("missing --%s" % name)
    if ".." in value or "/" in value or "\\" in value:
        fail("invalid --%s: path-like values are not allowed" % name)
    if not TOKEN_RE.match(value):
        fail("invalid --%s: must be a single safe token" % name)
    return value


def validate_relative_path(name, value):
    if value is None or value == "":
        fail("missing --%s" % name)
    if value.startswith("/") or value.startswith("\\") or ":" in value:
        fail("invalid --%s: absolute paths are not allowed" % name)
    for part in value.replace("\\", "/").split("/"):
        if part in ("", ".", ".."):
            fail("invalid --%s: path traversal is not allowed" % name)
    return value


def parse_args(argv):
    if len(argv) < 1 or argv[0] != "resolve":
        fail(
            "usage: atlas channel resolve --project <id> --session <id> "
            "--ticket <id> --mission <id> --scope <path>"
        )

    values = {
        "project": None,
        "session": None,
        "ticket": None,
        "mission": None,
        "scope": None,
    }
    rest = argv[1:]
    i = 0
    while i < len(rest):
        arg = rest[i]
        if arg.startswith("--") and arg[2:] in values:
            key = arg[2:]
            if i + 1 >= len(rest):
                fail("missing value for --%s" % key)
            values[key] = rest[i + 1]
            i += 2
        else:
            fail("unrecognized argument: %s" % arg)

    values["project"] = validate_token("project", values["project"])
    values["session"] = validate_token("session", values["session"])
    values["ticket"] = validate_token("ticket", values["ticket"])
    values["mission"] = validate_relative_path("mission", values["mission"])
    values["scope"] = validate_relative_path("scope", values["scope"])
    return values


def run_paths_tool(script_dir, args, missing_message):
    paths_tool = os.path.join(script_dir, "atlas-paths")
    try:
        result = subprocess.run(
            [paths_tool] + args,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except OSError as exc:
        fail("failed to invoke atlas-paths: %s" % exc)

    if result.returncode != 0:
        fail(missing_message)

    path = result.stdout.decode("utf-8", "strict").strip()
    if not path:
        fail("atlas-paths returned an empty path")
    return path


def resolve_project_path(script_dir, project_id):
    return run_paths_tool(
        script_dir, ["project", project_id], "unknown project: %s" % project_id
    )


def resolve_ticket_path(script_dir, project_id, ticket_id):
    project_path = resolve_project_path(script_dir, project_id)
    ticket_path = run_paths_tool(
        script_dir, ["ticket", ticket_id], "unknown ticket: %s" % ticket_id
    )
    project_real = os.path.realpath(project_path)
    ticket_real = os.path.realpath(ticket_path)
    if ticket_real != project_real and not ticket_real.startswith(project_real + os.sep):
        fail("ticket %s does not belong to project %s" % (ticket_id, project_id))
    return ticket_real


def resolve_contained_path(base_dir, relative_id, kind):
    base_real = os.path.realpath(base_dir)
    candidate = os.path.join(base_dir, relative_id)
    candidate_real = os.path.realpath(candidate)
    if candidate_real != base_real and not candidate_real.startswith(
        base_real + os.sep
    ):
        fail("invalid --%s: resolves outside of its parent directory" % kind)
    if not os.path.exists(candidate_real):
        fail("%s path does not exist: %s" % (kind, relative_id))
    return candidate_real


def main():
    script_path = os.path.realpath(__file__)
    script_dir = os.path.dirname(script_path)
    atlas_root = os.path.dirname(os.path.dirname(script_dir))

    if len(sys.argv) > 1 and sys.argv[1] in ("pilot", "packet"):
        pilot = os.path.join(script_dir, "atlas-channel-pilot")
        os.execv(sys.executable, [sys.executable, pilot, *sys.argv[2:]])

    values = parse_args(sys.argv[1:])
    project_id = values["project"]
    session_id = values["session"]
    ticket_id = values["ticket"]
    mission_id = values["mission"]
    scope_value = values["scope"]

    project_path = resolve_project_path(script_dir, project_id)
    ticket_path = resolve_ticket_path(script_dir, project_id, ticket_id)
    mission_path = resolve_contained_path(ticket_path, mission_id, "mission")
    scope_path = resolve_contained_path(atlas_root, scope_value, "scope")

    output = {
        "atlas_root": atlas_root,
        "project_id": project_id,
        "project_path": project_path,
        "session_id": session_id,
        "ticket_id": ticket_id,
        "ticket_path": ticket_path,
        "mission_id": mission_id,
        "mission_path": mission_path,
        "scope": scope_value,
        "scope_path": scope_path,
    }
    print(json.dumps(output))


if __name__ == "__main__":
    main()
