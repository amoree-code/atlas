#!/usr/bin/env python3
"""ai-os-render — resolve a canonical skill for one client.

One skill body lives in the public repo. Two things make it yours:

  {{profile.*}}   your values, from the workspace's config/profile.yaml — PRIVATE
  {{client.*}}    the client's filesystem conventions, from its plugin manifest

That is the whole mechanism. It exists so there is exactly one skill to maintain rather
than a generic public copy and a personalised runtime copy drifting apart — which is the
state this migration found and is undoing.

  ai-os-render <skill> [--client ID]        render one skill to stdout
  ai-os-render --all   [--client ID]        render every skill (headers to stderr)
  ai-os-render --check DIR [--client ID]    compare renders against DIR, report differences

An unresolved placeholder renders as [[profile.x unset]] — visible, never a silent blank.
Exit: 0 ok · 1 differences found (--check) · 2 usage.  Zero dependencies.
"""
import os, re, sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
SKILLS = REPO / "skills"
AI_OS_HOME = Path(os.environ.get("AI_OS_HOME", Path.home() / ".ai-os"))
# config/ is mid-migration. The profile is optional, but *which* directory holds it is not
# a question to guess at: two profiles in two layouts would render two different skills.
sys.path.insert(0, str(Path(__file__).resolve().parent))
from aios_paths import private_path_or_die  # noqa: E402

PROFILE = private_path_or_die("config") / "profile.yaml"
G, Y, R, D, X = "\033[32m", "\033[33m", "\033[31m", "\033[2m", "\033[0m"
if not sys.stdout.isatty():
    G = Y = R = D = X = ""

# The manifest parser already exists and is already tested; reuse it rather than
# writing a second one that can disagree with the first.
_pl = {"__file__": str(REPO / "cli" / "ai-os-capability")}
exec(compile((REPO / "cli" / "ai-os-capability").read_text().split("if __name__")[0],
             "ai-os-capability", "exec"), _pl)
parse = _pl["parse"]

TOKEN = re.compile(r"\{\{\s*(profile|client)\.([a-z0-9_.]+)\s*\}\}", re.I)


def dig(d, dotted):
    cur = d
    for part in dotted.split("."):
        if not isinstance(cur, dict) or part not in cur:
            return None
        cur = cur[part]
    return cur


def load_profile():
    if not PROFILE.exists():
        return {}
    return parse(PROFILE.read_text(), str(PROFILE))


def load_conventions(client_id):
    f = REPO / "adapters" / client_id / "adapter.yaml"
    if not f.exists():
        raise SystemExit(f"no plugin manifest for client {client_id!r}")
    return parse(f.read_text(), str(f)).get("conventions") or {}


def render(text, profile, conventions, unresolved=None):
    def sub(m):
        ns, key = m.group(1).lower(), m.group(2)
        v = dig(profile, key) if ns == "profile" else dig(conventions, key)
        if v is None or v == "" or v == []:
            if unresolved is not None:
                unresolved.append(f"{ns}.{key}")
            return f"[[{ns}.{key} unset]]"
        if isinstance(v, list):
            return "|".join(str(x) for x in v)
        return str(v)
    return TOKEN.sub(sub, text)


def reflow(text):
    """Collapse newlines inside paragraphs; keep blank lines, list items and code fences.

    Used only to classify a difference as line wrapping. It never rewrites a file.
    """
    out, buf, fence = [], [], False
    for line in text.split("\n"):
        if line.strip().startswith("```"):
            fence = not fence
        if fence or not line.strip() or line.lstrip().startswith(("-", "*", "|", "#", ">", ">")) \
           or re.match(r"^\s*\d+\.", line):
            if buf:
                out.append(" ".join(buf)); buf = []
            out.append(line)
        else:
            buf.append(line.strip())
    if buf:
        out.append(" ".join(buf))
    return "\n".join(out)


def skills():
    return sorted(d.name for d in SKILLS.iterdir() if (d / "SKILL.md").exists())


def main(argv):
    client = "claude-code"
    if "--client" in argv:
        i = argv.index("--client"); client = argv[i + 1]; del argv[i:i + 2]
    profile, conv = load_profile(), load_conventions(client)

    if "--check" in argv:
        i = argv.index("--check"); ref = Path(argv[i + 1]).expanduser(); del argv[i:i + 2]
        bad = 0
        reflowed = []
        print(f"\n  equivalence check  {D}client={client}  profile={PROFILE}{X}")
        print(f"  {D}rendered public skills  vs  {ref}{X}\n")
        for name in skills():
            src = (SKILLS / name / "SKILL.md").read_text()
            un = []
            out = render(src, profile, conv, un)
            other = ref / name / "SKILL.md"
            if not other.exists():
                print(f"  {R}MISSING{X} {name}: no counterpart in {ref}"); bad += 1; continue
            cur = other.read_text()
            n = len(TOKEN.findall(src))
            if out == cur:
                print(f"  {G}identical{X}  {name}  {D}({n} substitution(s) resolved){X}")
            elif reflow(out) == reflow(cur):
                # A profile value is one string; it cannot reproduce an arbitrary line
                # wrap in the paragraph that used to spell it out. Collapsing newlines
                # WITHIN a paragraph changes no instruction, so this is equivalence, not
                # loss. It is reported separately rather than folded into "identical",
                # because a gate that quietly widens is not a gate.
                reflowed.append(name)
                print(f"  {G}equivalent{X} {name}  {D}({n} resolved; differs only by "
                      f"Markdown line wrapping){X}")
            else:
                bad += 1
                print(f"  {R}DIFFERS{X}    {name}")
                import difflib
                for l in list(difflib.unified_diff(cur.splitlines(), out.splitlines(),
                                                   "runtime", "rendered", lineterm=""))[2:]:
                    if l.startswith(("+", "-")):
                        col = G if l.startswith("+") else R
                        print(f"      {col}{l[:150]}{X}")
            if un:
                print(f"      {Y}unresolved:{X} {', '.join(sorted(set(un)))}"); bad += 1
        print()
        if bad:
            print(f"  {R}{bad} skill(s) not equivalent{X} — the gate is NOT met\n"); return 1
        note = (f"  {D}{len(reflowed)} of them differ only by line wrapping: "
                f"{', '.join(reflowed)}{X}\n" if reflowed else "")
        print(f"  {G}all {len(skills())} skills equivalent{X} — no semantic loss")
        print(note); return 0

    if "--all" in argv:
        for name in skills():
            print(f"\n===== {name} =====", file=sys.stderr)
            print(render((SKILLS / name / "SKILL.md").read_text(), profile, conv))
        return 0

    args = [a for a in argv if not a.startswith("-")]
    if len(args) != 1:
        print(__doc__); return 2
    f = SKILLS / args[0] / "SKILL.md"
    if not f.exists():
        raise SystemExit(f"no such skill: {args[0]}")
    print(render(f.read_text(), profile, conv), end="")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
