#!/usr/bin/env python3
"""atlas-plugin — compatibility alias for atlas-capability.

The capability surface was named `plugin` until 2026-09-03. This file exists so that
`atlas plugin ...`, and anything invoking `cli/atlas-plugin` by path, keeps working
unchanged for one version. It adds no behaviour of its own and never will: it replaces
its own process with atlas-capability, so exit status, stdin, stdout and stderr are the
real command's, not a wrapper's copy of them.

The current name is `atlas capability` / `cli/atlas-capability`. Prefer it. This alias is
scheduled for removal, and removing it is a deliberate decision the owner makes — not
something that happens quietly.

Anything that needs the registry's FUNCTIONS (rather than its command line) must import
cli/atlas-capability directly. This file is a process-level alias only, and deliberately
carries no importable definitions to drift from the real one.
"""
import os
import sys
from pathlib import Path

TARGET = Path(__file__).resolve().parent / "atlas-capability"

if not TARGET.exists():
    sys.exit(f"atlas-plugin: {TARGET} is missing — this alias forwards to it")

os.execv(sys.executable, [sys.executable, str(TARGET), *sys.argv[1:]])
