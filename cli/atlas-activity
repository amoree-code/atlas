#!/usr/bin/env python3
"""Read-only live ticket and agent activity snapshot."""
import argparse, json, os, sys, time
from datetime import datetime, timezone
from pathlib import Path

CLI_DIR = Path(__file__).resolve().parent
if str(CLI_DIR) not in sys.path:
    sys.path.insert(0, str(CLI_DIR))
import atlas_client_activity as client_activity

HOME = Path(os.environ.get("ATLAS_HOME", Path.home() / "atlas"))

def stamp(value):
    if not value:
        return 0
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return 0

def frontmatter(path):
    fields = {}
    for line in path.read_text(errors="replace").split("---", 2)[1].splitlines():
        if ":" in line and not line.startswith(" "):
            key, value = line.split(":", 1)
            fields[key.strip()] = value.strip().strip("\"'")
    return fields

def snapshot(project, stale_seconds):
    root = HOME / "projects" / project / "tickets"
    rows = []
    for task in sorted(root.glob("*/task.md")) if root.is_dir() else []:
        fields = frontmatter(task)
        coord = task.parent / "coordination"
        events = []
        audit = coord / "audit.log"
        if audit.is_file():
            for line in audit.read_text(errors="replace").splitlines():
                try:
                    event = json.loads(line)
                except json.JSONDecodeError:
                    continue
                events.append({"at": event.get("at"), "op": event.get("op"),
                               "client_id": event.get("client_id")})
        lease = None
        lease_path = coord / "lease.json"
        if lease_path.is_file():
            try:
                lease = json.loads(lease_path.read_text())
            except json.JSONDecodeError:
                lease = {"state": "corrupt"}
        heartbeat = lease.get("heartbeat") if lease else (events[-1]["at"] if events else None)
        age = max(0, time.time() - stamp(heartbeat)) if heartbeat else None
        ticket_id = fields.get("id", task.parent.name)
        clients = client_activity.list_activity(ticket_id, stale_seconds=stale_seconds)
        rows.append({"ticket": ticket_id,
                     "state": fields.get("state", "unknown"),
                     "activity": events,
                     "lease": {"state": lease.get("state"),
                               "client_id": lease.get("client_id"),
                               "heartbeat": heartbeat} if lease else None,
                     "stale": bool(age is not None and age > stale_seconds),
                     "last_activity_at": heartbeat,
                     "clients": [{"client_id": c.get("client_id"),
                                  "status": c.get("status"),
                                  "last_seen": c.get("last_seen")} for c in clients]})
    return rows

parser = argparse.ArgumentParser(prog="atlas activity")
parser.add_argument("--project", default="atlas")
parser.add_argument("--stale-seconds", type=int, default=900)
parser.add_argument("--json", action="store_true")
args = parser.parse_args()
if args.stale_seconds < 1:
    parser.error("--stale-seconds must be positive")
result = {"project": args.project, "read_only": True,
          "generated_at": datetime.now(timezone.utc).isoformat(),
          "tickets": snapshot(args.project, args.stale_seconds)}
if args.json:
    print(json.dumps(result, sort_keys=True))
else:
    for row in result["tickets"]:
        print(f"{row['ticket']}  {row['state']}  stale={str(row['stale']).lower()} "
              f"events={len(row['activity'])}")
        for c in row["clients"]:
            print(f"    client={c['client_id']}  status={c['status']}  "
                  f"last_seen={c['last_seen']}")
