#!/usr/bin/env python3
"""ai-os-plugin — compatibility alias for ai-os-capability.

The capability surface was named `plugin` until 2026-09-03. This file exists so that
`ai-os plugin ...`, and anything invoking `cli/ai-os-plugin` by path, keeps working
unchanged for one version. It adds no behaviour of its own and never will: it replaces
its own process with ai-os-capability, so exit status, stdin, stdout and stderr are the
real command's, not a wrapper's copy of them.

The current name is `ai-os capability` / `cli/ai-os-capability`. Prefer it. This alias is
scheduled for removal, and removing it is a deliberate decision the owner makes — not
something that happens quietly.

Anything that needs the registry's FUNCTIONS (rather than its command line) must import
cli/ai-os-capability directly. This file is a process-level alias only, and deliberately
carries no importable definitions to drift from the real one.
"""
import os
import sys
from pathlib import Path

TARGET = Path(__file__).resolve().parent / "ai-os-capability"

if not TARGET.exists():
    sys.exit(f"ai-os-plugin: {TARGET} is missing — this alias forwards to it")

os.execv(sys.executable, [sys.executable, str(TARGET), *sys.argv[1:]])
