#!/usr/bin/env python3
"""Show or update the metadata-only provider selection."""
import json, os, sys
from pathlib import Path

HOME = Path(os.environ.get("ATLAS_HOME", Path.home() / "atlas"))
STATE = HOME / "internal" / "config" / "providers.json"

def load():
    try:
        return json.loads(STATE.read_text())
    except (OSError, json.JSONDecodeError):
        return {"primary_provider": "other", "providers": [], "privacy": "metadata-only"}

def save(value):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(value, indent=2) + "\n")

args = sys.argv[1:]
if not args or args[0] == "status":
    print(json.dumps(load(), indent=2, sort_keys=True))
    raise SystemExit(0)
if args[0] not in ("add", "remove") or len(args) != 2:
    print("usage: atlas providers [status|add <client>|remove <client>]", file=sys.stderr)
    raise SystemExit(2)

client = args[1]
state = load()
items = [item for item in state.get("providers", []) if item.get("id") != client]
if args[0] == "add":
    items.append({"id": client, "status": "pending", "reason": "added; run atlas setup preflight"})
state["providers"] = sorted(items, key=lambda item: item["id"])
save(state)
print(json.dumps(state, indent=2, sort_keys=True))
