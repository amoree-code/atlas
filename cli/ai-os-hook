#!/bin/sh
# ai-os-hook — resolve the AI OS repository at runtime, then run one of its commands.
#
# A client's hooks run in a non-login shell with a minimal PATH and no guaranteed working
# directory, so they cannot find the repository themselves. The obvious fix — writing the
# repository's path into the hook — is wrong twice over: it encodes the machine it was
# written on, and it breaks the moment the repository moves.
#
# So the hook holds no path at all. It calls this launcher at a fixed, $HOME-relative
# location, and the launcher looks the repository up every time it runs. Moving the
# repository needs no edit here and no edit to any hook — only the recorded location
# changes, and `ai-os init` records that automatically.
#
#   ai-os-hook <repo-relative-command> [args...]
#
# Resolution order:
#   1. $AI_OS_REPO                                              explicit override
#   2. ai_os_repo: in ${AI_OS_HOME:-$HOME/.ai-os}/internal/config/settings.yaml
#      falling back to the pre-move .../system/config/settings.yaml
#
# Those two paths are the one place in AI-OS that may not ask cli/ai-os-paths which layout
# the workspace is in: the resolver lives inside the repository, and this file runs before
# the repository has been found. So it checks both, newest first — the same order the
# resolver itself uses — and the duplication is deliberate, not an oversight.
#
# Nothing here names a client. Every adapter installs the same file into its own client's
# configuration domain; which client is calling is not a question this needs to answer.
#
# Exit 78 (EX_CONFIG) on any resolution failure, loudly on stderr. A hook that wants to
# tolerate that appends `|| true`; a hook enforcing a policy deliberately should not, so
# that a broken installation fails closed rather than silently granting.
#
# POSIX sh, no dependencies beyond sed.

set -u

die() { printf 'ai-os-hook: %s\n' "$*" >&2; exit 78; }

[ $# -ge 1 ] || die "usage: ai-os-hook <repo-relative-command> [args...]"

repo="${AI_OS_REPO:-}"

if [ -z "$repo" ]; then
    home="${AI_OS_HOME:-$HOME/.ai-os}"
    cfg="$home/internal/config/settings.yaml"
    [ -f "$cfg" ] || cfg="$home/system/config/settings.yaml"
    [ -f "$cfg" ] || die "no AI_OS_REPO set and no workspace settings at $home/internal/config/settings.yaml or $home/system/config/settings.yaml"
    # First ai_os_repo: line; strip an inline comment, surrounding quotes, trailing space.
    repo=$(sed -n 's/^ai_os_repo:[[:space:]]*//p' "$cfg" | head -n 1 | sed \
        -e 's/[[:space:]]*#.*$//' \
        -e 's/^"\(.*\)"$/\1/' \
        -e "s/^'\(.*\)'\$/\1/" \
        -e 's/[[:space:]]*$//')
    [ -n "$repo" ] || die "ai_os_repo is empty in $cfg — run 'ai-os init' to record it"
fi

# A leading ~ is the user's own shorthand in a config file; nothing expanded it for us.
case "$repo" in
    "~")   repo="$HOME" ;;
    "~/"*) repo="$HOME/${repo#\~/}" ;;
esac

[ -d "$repo" ] || die "recorded repository does not exist: $repo"

cmd="$1"
shift
target="$repo/$cmd"
[ -x "$target" ] || die "not executable inside the repository: $cmd  (looked in $repo)"

exec "$target" "$@"
