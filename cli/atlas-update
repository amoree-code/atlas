#!/usr/bin/env python3
"""Local Atlas update check/plan/apply boundary."""
import json, os, re, subprocess, sys, time
from pathlib import Path

HERE = Path(__file__).resolve().parent
ATLAS = Path(os.environ.get("ATLAS_HOME", Path.home() / "atlas"))
VERSION = (HERE.parent / "VERSION").read_text().strip()
WORKSPACE = ATLAS / "internal/config/workspace.yaml"

def die(msg):
    print(f"update: {msg}", file=sys.stderr); raise SystemExit(2)

def current():
    old = None
    if WORKSPACE.is_file():
        for line in WORKSPACE.read_text().splitlines():
            if line.startswith("workspace_version:"):
                old = line.split(":", 1)[1].strip().strip("\"'"); break
    return {"engine_version": VERSION, "workspace_version": old,
            "update_available": old != VERSION}

def output(value, as_json):
    if as_json: print(json.dumps(value, sort_keys=True))
    else:
        print(f"engine: {value['engine_version']}\nworkspace: {value.get('workspace_version') or '(not initialized)'}")
        print("update: " + ("available" if value.get("update_available") else "current"))

def opts(args, approve=False):
    as_json = "--json" in args
    if any(a not in ("--json", "--approve") for a in args): die("unknown argument")
    if approve and "--approve" not in args: die("apply requires explicit --approve")
    return as_json

def cmd_check(args):
    output(current(), opts(args)); return 0

def cmd_plan(args):
    value = current(); value["action"] = "update workspace_version" if value["update_available"] else "none"
    output(value, opts(args)); return 0

def cmd_apply(args):
    as_json = opts(args, approve=True); value = current()
    if not WORKSPACE.is_file(): die("workspace is not initialized: run atlas init")
    text = WORKSPACE.read_text()
    if value["update_available"]:
        if re.search(r"^workspace_version:", text, re.M):
            text = re.sub(r"^workspace_version:.*$", f"workspace_version: {VERSION}", text, count=1, flags=re.M)
        else: text += f"\nworkspace_version: {VERSION}\n"
        tmp = WORKSPACE.with_suffix(".yaml.update.tmp"); tmp.write_text(text); tmp.replace(WORKSPACE)
    receipt = ATLAS / "runtime/updates" / f"update-{time.strftime('%Y%m%d-%H%M%S')}-{os.urandom(3).hex()}.json"
    receipt.parent.mkdir(parents=True, exist_ok=True)
    doctor = subprocess.run([str(HERE / "atlas-doctor"), "--quiet"], env=os.environ.copy(),
                            capture_output=True, text=True)
    result = {"kind": "atlas-update", "engine_version": VERSION,
              "changed": value["update_available"], "receipt": str(receipt),
              "doctor_exit": doctor.returncode, "created_at": time.strftime("%Y-%m-%d %H:%M:%S")}
    receipt.write_text(json.dumps(result, indent=2) + "\n"); output(result, as_json); return 0

CMDS = {"check": cmd_check, "plan": cmd_plan, "apply": cmd_apply}
if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in CMDS:
        print("usage: atlas update check | plan | apply --approve", file=sys.stderr); raise SystemExit(2)
    raise SystemExit(CMDS[sys.argv[1]](sys.argv[2:]))
