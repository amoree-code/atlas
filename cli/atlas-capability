#!/usr/bin/env python3
"""atlas-capability — the capability registry. Reads manifests; enforces the contract.

  atlas capability list              what capabilities exist, and whether each is available
  atlas capability doctor            validate every manifest against schemas/capability.schema.md
  atlas capability invoke <id>.<op>  run ONE declared operation, and stop

A CAPABILITY is what Atlas can do. An ADAPTER is how one AI client reaches Atlas and lives
in adapters/ — see cli/atlas-adapter. Until 2026-08-31 those two meanings were inverted;
task AIOS-005 resolved it.

Compatibility window. The capability surface was named `plugin` until 2026-09-03. Both
spellings still work, and the old ones are compatibility only:

  registry      capabilities/   preferred      plugins/         still read if pointed at
  env var       ATLAS_CAPABILITIES preferred   ATLAS_PLUGINS    honoured as a fallback
  manifest      capability.yaml preferred      plugin.yaml      still accepted
  command       atlas capability                atlas plugin    alias, cli/atlas-plugin
  manifest key  plugin:         unchanged — renaming it is a contract v2 change, not this

Both manifest filenames present in one directory with DIFFERENT content is a conflict and
is reported, never merged: two sources of truth for one manifest is exactly the failure
the contract exists to prevent.

Core owns the mechanism: capability, availability, authority, invocation, result,
verification, persistence. It never learns the capability's domain — not what a PRD is,
not what a browser engine is. That boundary is mechanically checked here: a manifest that
names an AI client is rejected, because naming one means the capability is doing an
adapter's job.

Zero dependencies: stdlib only. The manifest parser is the one atlas-adapter already owns
— both contracts use the same small YAML subset, and two parsers would drift.
"""
import importlib.util, json, os, re, subprocess, sys, time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
# Overridable so the test suite can point at fixtures instead of the real registry.
# ATLAS_CAPABILITIES is the current name; ATLAS_PLUGINS is honoured for one version so a
# caller written against the old name keeps working. New name wins when both are set.
CAPS = Path(os.environ.get("ATLAS_CAPABILITIES")
            or os.environ.get("ATLAS_PLUGINS")
            or REPO / "capabilities")
# The manifest filename, new then old. Order is the precedence.
MANIFEST_NAMES = ("capability.yaml", "plugin.yaml")
ATLAS_HOME = Path(os.environ.get("ATLAS_HOME", os.environ.get("ATLAS_HOME", Path.home() / "atlas")))
CORE_CONTRACT_RANGE = (1, 1)

# The whole ladder. Ordered: an operation may not exceed its capability's rung.
AUTHORITY = ["observe", "propose", "execute", "execute-with-approval", "autonomous"]
# Nothing grants this yet. A manifest asking for it is refused, never quietly downgraded.
UNGRANTABLE = {"autonomous"}
# A capability that names a client is doing an adapter's job. Checked, not trusted.
CLIENT_NAMES = re.compile(r"\b(claude|claude-code|codex|cursor|gemini|opencode|chatgpt)\b", re.I)
# A dependency names a capability by id. Never a path — that is the whole point of the shape.
CAP_ID = re.compile(r"^[a-z0-9][a-z0-9-]*$")

G, Y, R, B, D, X = "\033[32m", "\033[33m", "\033[31m", "\033[34m", "\033[2m", "\033[0m"
if not sys.stdout.isatty():
    G = Y = R = B = D = X = ""


# config/ is mid-migration, and this file is the grant ledger: read it from a path that
# merely used to be right and every grant reads as absent — so every operation is refused
# while the workspace still looks healthy. The root is asked for, never assumed.
sys.path.insert(0, str(Path(__file__).resolve().parent))
from atlas_paths import private_path_or_die  # noqa: E402

AUTHORITY_FILE = private_path_or_die("config") / "authority.yaml"


def die(msg):
    print(f"  {R}ERROR{X} {msg}", file=sys.stderr)
    sys.exit(2)


def granted_rung(cap_id):
    """What the USER has granted this capability. Absent file or key => the floor.

    Core reads a grant; it never infers one. A capability asking for more than it was
    granted is refused, which is the whole reason `invoke` may exist at all.
    """
    default, per_cap = "observe", {}
    if AUTHORITY_FILE.exists():
        section = False
        for line in AUTHORITY_FILE.read_text().splitlines():
            if line.startswith("#") or not line.strip():
                continue
            if re.match(r"^default:", line):
                default = line.split(":", 1)[1].split("#")[0].strip() or "observe"
            elif re.match(r"^capabilities:", line):
                section = True
                rest = line.split(":", 1)[1].strip()
                if rest and rest != "{}":
                    section = False
            elif section and re.match(r"^\s+\S+\s*:", line):
                k, _, v = line.strip().partition(":")
                v = v.split("#")[0].strip()
                if v:
                    per_cap[k.strip()] = v
    rung = per_cap.get(cap_id, default)
    # An unknown rung, or one this core cannot grant at all, falls back to the floor.
    # Honouring `autonomous` here would hand out every rung from a single line of config —
    # the precise bypass the ladder exists to make impossible.
    if rung not in AUTHORITY or rung in UNGRANTABLE:
        return "observe"
    return rung


def _load_parser():
    """Borrow the manifest parser from atlas-adapter — one parser, not two."""
    src = Path(__file__).resolve().parent / "atlas-adapter"
    if not src.exists():
        raise SystemExit("atlas-capability: cli/atlas-adapter is missing; it owns the manifest parser")
    spec = importlib.util.spec_from_loader("_atlas_adapter",
                                           importlib.machinery.SourceFileLoader("_atlas_adapter", str(src)))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod.parse, mod.ManifestError


parse, ManifestError = _load_parser()

REQUIRED = ("plugin", "name", "contract", "capability")


def validate(pid, m, raw="", known=None):
    """Return (errors, warnings). Never raises; never executes anything.

    `known` is the set of capability ids present in the registry, or None to skip the
    availability check entirely (a caller validating one manifest in isolation).
    """
    err, warn = [], []
    for k in REQUIRED:
        if k not in m:
            err.append(f"missing required key: {k}")
    if err:
        return err, warn

    if m["plugin"] != pid:
        err.append(f"plugin id {m['plugin']!r} != directory name {pid!r}")

    lo, hi = CORE_CONTRACT_RANGE
    c = m["contract"]
    if not isinstance(c, int):
        err.append(f"contract must be an integer, got {c!r}")
    elif not (lo <= c <= hi):
        err.append(f"requires contract {c}; this core supports {lo}..{hi} — DISABLED")

    cap = m["capability"] if isinstance(m["capability"], dict) else {}
    if not isinstance(m["capability"], dict):
        err.append("capability: must be a map")
        return err, warn

    cap_auth = cap.get("authority")
    if cap_auth is None:
        err.append("capability.authority is required — an unstated rung is not a default")
    elif cap_auth not in AUTHORITY:
        err.append(f"capability.authority {cap_auth!r} is not a rung: {' -> '.join(AUTHORITY)}")
    elif cap_auth in UNGRANTABLE:
        err.append(f"capability.authority {cap_auth!r} cannot be granted by this core — "
                   f"refused rather than silently downgraded")

    ops = m.get("operations") or {}
    if ops and not isinstance(ops, dict):
        err.append("operations: must be a map")
        ops = {}
    if not ops:
        warn.append("declares no operations — discoverable, but there is nothing to invoke")

    for name, spec in (ops.items() if isinstance(ops, dict) else []):
        if not isinstance(spec, dict):
            err.append(f"operations.{name}: must be a map"); continue
        for field in ("summary", "command"):
            if field not in spec:
                err.append(f"operations.{name}: missing required field {field!r}")
        cmd = str(spec.get("command") or "")
        # A bare filename inside the capability's own directory. Never a path, never an escape.
        if cmd and ("/" in cmd or cmd.startswith(".")):
            err.append(f"operations.{name}.command must be a bare filename inside "
                       f"capabilities/{pid}/ — got {cmd!r}")
        ver = str(spec.get("verify") or "")
        if ver and ("/" in ver or ver.startswith(".")):
            err.append(f"operations.{name}.verify must be a bare filename inside "
                       f"capabilities/{pid}/ — got {ver!r}")
        if not ver:
            warn.append(f"operations.{name} has no verify: — its result can only ever be "
                        f"'executed', never 'verified'")
        idem = spec.get("idempotent", False)
        if not isinstance(idem, bool):
            err.append(f"operations.{name}.idempotent must be true or false, got {idem!r}")
        oa = spec.get("authority", cap_auth)
        if oa not in AUTHORITY:
            err.append(f"operations.{name}.authority {oa!r} is not a rung")
        elif cap_auth in AUTHORITY and AUTHORITY.index(oa) > AUTHORITY.index(cap_auth):
            err.append(f"operations.{name}.authority {oa!r} exceeds capability.authority "
                       f"{cap_auth!r}")
        elif oa in UNGRANTABLE:
            err.append(f"operations.{name}.authority {oa!r} cannot be granted by this core")

    # Dependencies. A capability may name other capabilities it needs, by id and only by
    # id. No resolver exists and none is needed yet: what must be impossible is a
    # dependency that quietly resolves to a filesystem path.
    req = m.get("requires")
    if req is not None:
        if not isinstance(req, list):
            err.append("requires: must be a list of capability ids")
        else:
            for dep in req:
                d = str(dep)
                if "/" in d or ".." in d or d.startswith("."):
                    err.append(f"requires: {d!r} looks like a path — a dependency names a "
                               f"capability by id, never a location")
                elif not CAP_ID.match(d):
                    err.append(f"requires: {d!r} is not a valid capability id "
                               f"(lowercase, digits and dashes)")
                elif d == pid:
                    err.append(f"requires: {d!r} is itself")
                elif known is not None and d not in known:
                    # Declared before the thing it needs is installed is legitimate, so this
                    # stays visible rather than fatal — the same treatment verified:false gets.
                    warn.append(f"requires {d!r}, which is not in the registry — the "
                                f"capability is declared but its dependency is unavailable")

    # The Core/capability boundary, mechanically enforced.
    hit = CLIENT_NAMES.search(raw)
    if hit:
        err.append(f"names an AI client ({hit.group(0)!r}) — a capability is client-agnostic; "
                   f"client integration belongs in adapters/")
    return err, warn


def available(m):
    """detect: absent means 'no machine precondition', which is available."""
    det = (m.get("capability") or {}).get("detect")
    if not det:
        return True
    return any(Path(os.path.expanduser(str(p))).exists() for p in det)


def manifest_path(d):
    """Resolve one capability's manifest. Returns (path, conflict_message).

    capability.yaml is the current name; plugin.yaml is accepted for one version. Both
    present with identical content is the harmless case a migration produces, so the new
    name simply wins. Both present with DIFFERENT content is a conflict: there is no
    correct guess, nothing is merged, and the caller reports it instead of picking one.
    """
    present = [(n, d / n) for n in MANIFEST_NAMES if (d / n).exists()]
    if len(present) == 2:
        (_, new), (_, old) = present
        if new.read_text() != old.read_text():
            return None, ("both capability.yaml and plugin.yaml exist and differ — "
                          "remove one; nothing is merged")
        return new, None
    if present:
        return present[0][1], None
    return None, None


def load_all():
    out = []
    if not CAPS.is_dir():
        return out
    for d in sorted(CAPS.iterdir()):
        if not d.is_dir():
            continue
        f, conflict = manifest_path(d)
        if conflict:
            out.append((d.name, None, "", conflict)); continue
        if f:
            raw = f.read_text()
            try:
                out.append((d.name, parse(raw, f"capabilities/{d.name}"), raw, None))
            except ManifestError as e:
                out.append((d.name, None, raw, str(e)))
    return out


def cmd_list(_):
    rows = load_all()
    if not rows:
        print(f"\n  no capabilities in {CAPS}")
        print(f"  {D}nothing declared here — see {CAPS}/README.md{X}\n")
        return 0
    print(f"\n  {B}capabilities{X}  {D}{CAPS}{X}\n")
    print(f"  {'ID':<20} {'AVAILABLE':<11} {'AUTHORITY':<22} {'REQUIRES':<24} OPERATIONS")
    for pid, m, _raw, e in rows:
        if e:
            print(f"  {pid:<20} {R}unreadable manifest{X}"); continue
        av = f"{G}yes{X}" if available(m) else f"{D}no{X}"
        auth = (m.get("capability") or {}).get("authority", "?")
        ops = ", ".join((m.get("operations") or {}).keys()) or f"{D}none{X}"
        req = ", ".join(str(x) for x in (m.get("requires") or [])) or f"{D}nothing{X}"
        print(f"  {pid:<20} {av:<20} {auth:<22} {req:<24} {ops}")
    print(f"\n  {D}available != allowed != executed != verified — see "
          f"schemas/capability.schema.md{X}\n")
    return 0


def cmd_doctor(_):
    rows = load_all()
    known = {pid for pid, m, _r, e in rows if not e}
    fails = warns = 0
    print(f"\n  {B}capability doctor{X}  {D}contract range {CORE_CONTRACT_RANGE[0]}.."
          f"{CORE_CONTRACT_RANGE[1]} · registry {CAPS}{X}\n")
    if not rows:
        print(f"  {D}no capabilities declared — nothing to validate{X}\n")
        return 0
    for pid, m, raw, e in rows:
        if e:
            print(f"  {R}FAIL{X}  {pid}: {e}"); fails += 1; continue
        errs, ws = validate(pid, m, raw, known)
        for x in errs:
            print(f"  {R}FAIL{X}  {pid}: {x}"); fails += 1
        for x in ws:
            print(f"  {Y}WARN{X}  {pid}: {x}"); warns += 1
        if not errs:
            print(f"  {G}ok{X}    {pid}: manifest valid"
                  f"{'' if available(m) else f'  {D}(not available on this machine){X}'}")
    print()
    if fails:
        print(f"  {R}{fails} failure(s){X}, {Y}{warns} warning(s){X}\n")
    else:
        print(f"  {G}all capability manifests valid{X}"
              f"{f', {Y}{warns} warning(s){X}' if warns else ''}\n")
    return fails


def cmd_invoke(args):
    """available -> allowed -> invocable -> executed -> verified. In that order, always.

    Each arrow is a separate refusal point. Collapsing any two of them is how a system
    ends up reporting success for something that never happened, or performing something
    it was never granted.
    """
    if not args or "." not in args[0]:
        die("usage: atlas capability invoke <capability>.<operation> [--json '<args>'] [--dry-run]")
    cap_id, _, op_name = args[0].partition(".")
    payload, dry = "{}", False
    rest = args[1:]
    i = 0
    while i < len(rest):
        if rest[i] == "--json" and i + 1 < len(rest):
            payload = rest[i + 1]; i += 2
        elif rest[i] == "--dry-run":
            dry = True; i += 1
        else:
            die(f"unknown argument {rest[i]!r}")

    # --- available -------------------------------------------------------------------
    d = CAPS / cap_id
    f, conflict = manifest_path(d) if d.is_dir() else (None, None)
    if conflict:
        print(f"  {R}unavailable{X}  {cap_id}: {conflict}"); return 4
    if not f:
        print(f"  {R}unavailable{X}  no capability {cap_id!r} in {CAPS}"); return 4
    raw = f.read_text()
    try:
        m = parse(raw, f"capabilities/{cap_id}")
    except ManifestError as e:
        print(f"  {R}unavailable{X}  {cap_id}: unreadable manifest — {e}"); return 4
    errs, _ = validate(cap_id, m, raw)
    if errs:
        print(f"  {R}unavailable{X}  {cap_id}: manifest invalid — {errs[0]}"); return 4
    if not available(m):
        print(f"  {R}unavailable{X}  {cap_id}: its detect: paths are not present"); return 4
    op = (m.get("operations") or {}).get(op_name)
    if not isinstance(op, dict):
        print(f"  {R}unavailable{X}  {cap_id} declares no operation {op_name!r}"); return 4

    # --- allowed ---------------------------------------------------------------------
    need = op.get("authority", (m.get("capability") or {}).get("authority"))
    have = granted_rung(cap_id)
    if AUTHORITY.index(need) > AUTHORITY.index(have):
        print(f"  {R}denied{X}  {cap_id}.{op_name} needs {need!r}; granted {have!r}")
        print(f"  {D}grant it in {AUTHORITY_FILE} under capabilities: — never with a flag{X}")
        return 5
    if need == "execute-with-approval":
        if not sys.stdin.isatty():
            print(f"  {R}denied{X}  {cap_id}.{op_name} needs approval and there is no terminal")
            return 5
        print(f"  {Y}approval required{X}  {cap_id}.{op_name} — {op.get('summary','')}")
        if input("  type 'yes' to allow this one action: ").strip() != "yes":
            print(f"  {R}denied{X}  not approved"); return 5

    # --- invocable -------------------------------------------------------------------
    exe = d / str(op.get("command"))
    if not exe.exists() or not os.access(exe, os.X_OK):
        print(f"  {R}not invocable{X}  {cap_id}.{op_name}: {op.get('command')!r} is missing "
              f"or not executable"); return 6
    if dry:
        print(f"  {G}invocable{X}  {cap_id}.{op_name}  {D}(dry run — nothing executed){X}")
        print(f"  needs {need!r} · granted {have!r} · idempotent={bool(op.get('idempotent', False))}")
        return 0

    # --- executed --------------------------------------------------------------------
    started = time.time()
    try:
        proc = subprocess.run([str(exe), op_name], input=payload, capture_output=True,
                              text=True, cwd=str(d), timeout=300)
    except subprocess.TimeoutExpired:
        print(f"  {R}failed{X}  {cap_id}.{op_name} timed out"); return 7
    out = (proc.stdout or "").strip()
    if proc.returncode != 0:
        print(f"  {R}failed{X}  {cap_id}.{op_name} exited {proc.returncode}")
        if proc.stderr.strip():
            print("\n".join("        " + l for l in proc.stderr.strip().splitlines()[:8]))
        return 7
    print(f"  {G}executed{X}  {cap_id}.{op_name}  {D}({time.time()-started:.1f}s){X}")
    if out:
        print("\n".join("        " + l for l in out.splitlines()[:20]))

    # --- verified --------------------------------------------------------------------
    # The one rule the whole contract exists for: a capability's own exit code is NOT
    # verification. Only a separate deterministic check may promote executed -> verified.
    ver = op.get("verify")
    if not ver:
        print(f"  {Y}not verified{X}  this operation declares no verify: — its result is "
              f"'executed', and must not be reported as verified")
        return 0
    vexe = d / str(ver)
    if not vexe.exists() or not os.access(vexe, os.X_OK):
        print(f"  {Y}not verified{X}  verify command {ver!r} is missing or not executable")
        return 0
    v = subprocess.run([str(vexe), op_name], input=out, capture_output=True, text=True,
                       cwd=str(d), timeout=120)
    if v.returncode == 0:
        print(f"  {G}verified{X}  deterministic check passed")
        return 0
    print(f"  {R}NOT verified{X}  it ran, but the check did not confirm it")
    if v.stdout.strip():
        print("\n".join("        " + l for l in v.stdout.strip().splitlines()[:8]))
    return 8


CMDS = {"list": cmd_list, "doctor": cmd_doctor}
if __name__ == "__main__":
    a = sys.argv[1:] or ["list"]
    if a[0] == "invoke":
        sys.exit(cmd_invoke(a[1:]))
    if a[0] not in CMDS:
        print(__doc__); sys.exit(2)
    sys.exit(CMDS[a[0]](a[1:]))
