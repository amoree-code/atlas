#!/usr/bin/env python3
"""atlas-policy — read one governance module, when it applies.

  atlas policy list          what exists, and when each applies
  atlas policy <name>        print one module
  atlas policy doctor        every module the bootstrap routes to exists, and vice versa

`governance/rules/core.md` is rendered into every AI client's system prompt, so
every byte of it is paid for on every request of every session. It is a bootstrap: identity,
the hard authority and security boundaries, the language and direction rules that would
corrupt a reply if got wrong, the minimum-context principle, and a table saying which module
answers which kind of work.

Everything conditional lives here and is read on demand. Splitting the rules and then
pre-loading all the pieces would save nothing at all — the saving is entirely in *not*
reading the ones this task does not need.

Deterministic: a name maps to a file. Nothing here calls a model, and the routing table is
literal text in `core.md` rather than a judgement about the request.

Zero non-stdlib dependencies.
"""
import argparse, re, sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from atlas_paths import private_path_or_die

# What each module is for. The one-liners are the routing table a caller reads before
# deciding to open anything, so they say WHEN to load, not what the module contains.
WHEN = {
    "task": "starting, checkpointing or completing a unit of work",
    "context": "deciding what to read, how much, and when to stop",
    "lifecycle": "continuing, checkpointing, compacting, restarting or handing off",
    "memory": "recording or retrieving a durable fact about the owner",
    "knowledge": "recording or retrieving what past work taught",
    "git": "anything beyond reading git state",
    "models": "choosing a model, an effort level, or delegating",
    "concise-output": "producing any response",
    "minimal-change": "writing new code, or adding a file/dependency",
    "skill-observer": "a checkpoint, a handoff, or session end",
    "verification": "proving a change works",
    "response": "formatting a substantial or bilingual reply",
    "graph": "navigating an unfamiliar or large tree",
    "stack": "choosing libraries or scaffolding a project",
}


def policies_dir():
    return private_path_or_die("policies")


def modules(d):
    return sorted(p.stem for p in d.glob("*.md") if p.stem != "README")


def cmd_list(d):
    print("\n  policy modules — read one when it applies, never all of them\n")
    for name in modules(d):
        size = (d / f"{name}.md").stat().st_size
        print(f"  {name:<14} {WHEN.get(name, ''):<52} {size:>6,} b")
    total = sum((d / f"{n}.md").stat().st_size for n in modules(d))
    core = private_path_or_die("rules") / "core.md"
    if core.exists():
        print(f"\n  always loaded   core.md {core.stat().st_size:,} b"
              f"   ·   on demand   {total:,} b across {len(modules(d))} modules")
    print()
    return 0


def cmd_show(d, name):
    p = d / f"{name}.md"
    if not p.exists():
        near = [m for m in modules(d) if m.startswith(name[:3])]
        print(f"atlas policy: no module '{name}'"
              + (f" — did you mean {' or '.join(near)}?" if near else ""), file=sys.stderr)
        print(f"  available: {', '.join(modules(d))}", file=sys.stderr)
        return 1
    sys.stdout.write(p.read_text())
    return 0


def cmd_doctor(d):
    """The bootstrap's routing table and the modules on disk must agree.

    A name in the table with no file sends a reader nowhere; a file no table names is
    unreachable, which is the same as not existing. Both are failures.
    """
    core = private_path_or_die("rules") / "core.md"
    errors = []
    have = set(modules(d))
    if not core.exists():
        errors.append("no core.md — nothing routes to these modules")
        routed = set()
    else:
        text = core.read_text()
        routed = {m for m in re.findall(r"`([a-z][a-z-]*)`(?:\s*·\s*`([a-z][a-z-]*)`)?", text)
                  for m in m if m} & set(WHEN)
    for name in sorted(routed - have):
        errors.append(f"core.md routes to '{name}', which has no module")
    for name in sorted(have - routed):
        errors.append(f"'{name}.md' exists but core.md routes nothing to it")
    for name in sorted(have - set(WHEN)):
        errors.append(f"'{name}.md' has no entry in the routing table")
    for e in errors:
        print(f"  ✗ {e}")
    if core.exists():
        print(f"\n  core.md {core.stat().st_size:,} b always loaded · "
              f"{len(have)} module(s) on demand · {len(errors)} error(s)")
    return 1 if errors else 0


def main(argv):
    ap = argparse.ArgumentParser(prog="atlas policy")
    ap.add_argument("name", nargs="?", default="list")
    a = ap.parse_args(argv)
    d = policies_dir()
    if a.name == "list":
        return cmd_list(d)
    if a.name == "doctor":
        return cmd_doctor(d)
    return cmd_show(d, a.name)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))