#!/usr/bin/env bash
# atlas-init — create the private workspace for a new user.
#
# THE ONE RULE: this never destroys anything. It creates what is missing and reports what
# is different. It does not overwrite, does not merge, does not "fix" a file the user has
# edited. Running it a hundred times is the same as running it once.
#
#   atlas-init            create/verify the workspace
#   atlas-init --dry-run  print exactly what would happen, touch nothing
#
# Direction of flow is public -> private, only here, only at initialization. Nothing in
# this script ever reads private content into the public repository.
# See internal/governance/policies/public-private-contract.yaml.

set -euo pipefail

# T-046: the legacy ~/atlas default would recreate a just-deleted root if this ever runs
# again with no override set. Default to $ATLAS_HOME (~/atlas) instead; an explicit
# ATLAS_HOME still wins, same precedence every other tool in this repo uses.
ATLAS_HOME="${ATLAS_HOME:-${ATLAS_HOME:-$HOME/atlas}}"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(dirname "$SELF_DIR")"
TEMPLATES="$REPO/templates"
VERSION="$(cat "$REPO/VERSION" 2>/dev/null || echo unknown)"

DRY=0
for a in "$@"; do
  case "$a" in
    --dry-run|-n) DRY=1 ;;
    *) echo "usage: atlas-init [--dry-run]" >&2; exit 2 ;;
  esac
done

if [ -t 1 ]; then G=$'\033[32m'; Y=$'\033[33m'; B=$'\033[34m'; D=$'\033[2m'; X=$'\033[0m'
else G=; Y=; B=; D=; X=; fi

created=0; existed=0; seeded=0; diverged=0

say() { printf '  %s\n' "$1"; }
act() { [ "$DRY" -eq 0 ]; }

printf '\natlas init  %sv%s%s\n' "$D" "$VERSION" "$X"
printf '  public   %s  %s(software — read from)%s\n'  "$REPO"        "$D" "$X"
printf '  private  %s  %s(your data — written to)%s\n' "$ATLAS_HOME" "$D" "$X"
[ "$DRY" -eq 1 ] && printf '  %sdry run — nothing will be written%s\n' "$Y" "$X"
printf '\n'

# --- refuse to initialize somewhere that is not a workspace -------------------------
# Pointing ATLAS_HOME at the public repo, or at the runtime, would scatter user data
# through software. Cheap to check, expensive to undo.
for forbidden in "$REPO" "$HOME/.ai"; do
  if [ "$(cd "$ATLAS_HOME" 2>/dev/null && pwd || echo "$ATLAS_HOME")" = "$forbidden" ]; then
    printf '  REFUSED: ATLAS_HOME points at %s\n' "$forbidden" >&2
    printf '           The private workspace must be its own directory.\n' >&2
    exit 1
  fi
done

# --- which layout is this workspace in? ---------------------------------------------
# Several private roots are being relocated one reversible slice at a time, so init must
# not assume either layout: re-creating an old root next to a live new one would quietly
# manufacture a second store. It asks, and it refuses outright when a root already exists
# in both places — deciding which of two real stores is current is not init's call.
. "$SELF_DIR/atlas-paths"
if ! conflicts="$(atlas_paths_check)"; then
  printf '  REFUSED: the workspace holds a private root in two layouts at once.\n' >&2
  printf '%s\n' "$conflicts" | sed 's/^/           /' >&2
  printf '           Resolve it by hand, then re-run init. Nothing was created.\n' >&2
  exit 1
fi
# Old section name -> the moving root it belongs to. Anything absent from this list has
# not moved and is created exactly as before.
root_of() {
  case "$1" in
    system/rules)      echo rules ;;
    system/schemas)    echo schemas ;;
    user/02-personal)  echo memory ;;
    user/03-professional) echo professional ;;
    user/04-projects)  echo projects ;;
    user/05-knowledge) echo knowledge ;;
    runtime)           echo runtime ;;
    system/config)     echo config ;;
    system/policies)   echo policies ;;
    user/01-daily)     echo daily ;;
    user/06-templates) echo templates ;;
    skills)             echo skills ;;
    agents)             echo agents ;;
    scripts)            echo helpers ;;
    user/00-inbox)      echo inbox ;;
    sessions)           echo sessions ;;
  esac
}

# --- structure: system-default, always safe to create -------------------------------
# A directory carries no content, so creating one can never overwrite a fact.
printf '%sstructure%s\n' "$B" "$X"
for section in system/config system/rules system/policies system/schemas \
               user/00-inbox user/01-daily user/02-personal user/03-professional \
               user/04-projects user/05-knowledge user/06-templates \
               skills agents scripts sessions runtime; do
  root="$(root_of "$section")"
  if [ -n "$root" ]; then
    dir="$(atlas_path "$root")" || exit $?
    at="${dir#"$ATLAS_HOME"/}"
    if [ -d "$dir" ]; then
      say "exists   $at/"; existed=$((existed+1))
    else
      act && mkdir -p "$dir"
      say "created  $at/"; created=$((created+1))
    fi
    continue
  fi
  dir="$ATLAS_HOME/$section"
  if [ -d "$dir" ]; then
    say "exists   $section/"; existed=$((existed+1))
  else
    act && mkdir -p "$dir"
    say "created  $section/"; created=$((created+1))
  fi
done

# Transient intake is runtime state, distinct from durable personal/inbox.
dispatch_inbox="$(atlas_path runtime)/dispatch-inbox"
if [ ! -d "$dispatch_inbox" ]; then
  act && mkdir -p "$dispatch_inbox"
  say "created  ${dispatch_inbox#"$ATLAS_HOME"/}/"
fi

# The 8 memory sections and 7 knowledge kinds are structure, not content.
MEM="$(atlas_path memory)"; KNOW="$(atlas_path knowledge)"
for s in identity education career projects goals travel preferences interests; do
  [ -d "$MEM/$s" ] || { act && mkdir -p "$MEM/$s"; created=$((created+1)); }
done
for k in task-results technical-solutions decisions architecture research discoveries failures; do
  [ -d "$KNOW/$k" ] || { act && mkdir -p "$KNOW/$k"; created=$((created+1)); }
done
say "${D}memory: 8 sections · knowledge: 7 kinds${X}"

# --- seeds: system-default on first write, user-owned forever after -----------------
# A template is a seed, not a synchronized file. Once a destination exists it belongs to
# the user, and divergence from the template is the expected steady state — not a defect
# to repair. We report it so the user can decide; we never decide for them.
printf '\n%sseeds%s %s(copied only where nothing exists)%s\n' "$B" "$X" "$D" "$X"
if [ -d "$TEMPLATES/workspace" ]; then
  while IFS= read -r tpl; do
    rel="${tpl#"$TEMPLATES"/workspace/}"
    # Templates are written against the old layout; a seed still has to land in the store
    # this workspace actually has, or init would create a second one beside it.
    dest="$(atlas_path_rewrite "$rel")"
    # Report where the file actually went, not where the template said it would.
    at="${dest#"$ATLAS_HOME"/}"
    if [ ! -e "$dest" ]; then
      act && { mkdir -p "$(dirname "$dest")"; cp "$tpl" "$dest"; }
      say "seeded   $at"; seeded=$((seeded+1))
    elif cmp -s "$tpl" "$dest"; then
      say "${D}unchanged $at${X}"
    else
      say "${Y}yours${X}    $at  ${D}(differs from the template — kept, not touched)${X}"
      diverged=$((diverged+1))
    fi
  done < <(find "$TEMPLATES/workspace" -type f | sort)
fi

# --- record where this repository actually is ----------------------------------------
# Client hooks cannot discover the repository: they run in a non-login shell with a
# minimal PATH. So the location is written down once, here, by the only thing that
# reliably knows it — this script, from its own path. Clone anywhere, at any depth,
# under any name; run init; the hooks resolve it. Moving the repository means re-running
# init, never editing a hook.
#
# An explicitly configured value is the user's and is never overwritten. If it disagrees
# with where init is running from, that is reported and left alone: silently rewriting it
# would break a deliberate override, and guessing which one is right is not init's call.
printf '\n%srepository location%s\n' "$B" "$X"
cfg="$(atlas_path config)/settings.yaml"
if [ -f "$cfg" ]; then
  cur="$(sed -n 's/^atlas_repo:[[:space:]]*//p' "$cfg" | head -n 1 | sed \
        -e 's/[[:space:]]*#.*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/" \
        -e 's/[[:space:]]*$//')"
  case "$cur" in "~")   cur_abs="$HOME" ;;
                 "~/"*) cur_abs="$HOME/${cur#\~/}" ;;
                 *)     cur_abs="$cur" ;; esac
  if [ -z "$cur" ]; then
    if act; then
      tmp="$cfg.init.$$"
      awk -v v="$REPO" '\
        !d && /^atlas_repo:/ { print "atlas_repo: " v; d=1; next } { print }' \
        "$cfg" > "$tmp" && mv "$tmp" "$cfg"
    fi
    say "recorded  atlas_repo: $REPO"
  elif [ "$cur_abs" = "$REPO" ]; then
    say "${D}unchanged atlas_repo already points here${X}"
  else
    say "${Y}yours${X}    atlas_repo: $cur"
    say "${D}         ${X}  init is running from $REPO — kept your value, not overwritten."
    say "${D}         ${X}  If the repository moved, update it or clear it and re-run init."
  fi
else
  say "${Y}no ${cfg#"$ATLAS_HOME"/} — cannot record the repository location${X}"
fi

# --- what init deliberately does NOT do ---------------------------------------------
printf '\n%snot copied, deliberately%s\n' "$B" "$X"
say "${D}public skills${X}   stay in $REPO/skills — copying them here would turn"
say "${D}             ${X}   software into your files and make them un-updatable."
say "${D}             ${X}   Your own skills go in $(atlas_path skills 2>/dev/null || echo "$ATLAS_HOME/internal/extensions/skills") and win on name."
say "${D}runtime scripts${X} belong to the runtime layer, not your data."
say "${D}profile.yaml${X}    seeded blank. Fill it in: it is what makes the canonical"
say "${D}            ${X}    skills yours, and it never leaves this workspace."
say "${D}git${X}             the workspace repo is local-only and set up separately;"
say "${D}   ${X}             see docs/workspace-versioning.md. init never creates a remote."

printf '\n%s%d created · %d already present · %d seeded · %d yours (kept)%s\n' \
  "$D" "$created" "$existed" "$seeded" "$diverged" "$X"
if [ "$diverged" -gt 0 ]; then
  printf '  %s%d file(s) differ from their template. That is normal after first use —%s\n' "$D" "$diverged" "$X"
  printf '  %stemplates seed a workspace once and are never reapplied.%s\n' "$D" "$X"
fi
printf '\nRun %satlas doctor%s to verify.\n\n' "$B" "$X"
