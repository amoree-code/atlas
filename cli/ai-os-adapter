#!/usr/bin/env python3
"""ai-os-adapter — the adapter registry. Reads manifests; enforces the contract.

  ai-os adapter list             what is declared, what is installed, what gets written
  ai-os adapter doctor           validate every manifest against schemas/adapter.schema.md
  ai-os adapter enable  <id>     not wired yet — see below
  ai-os adapter disable <id>     not wired yet — see below

An ADAPTER connects one AI client to AI-OS. A CAPABILITY is what AI-OS can do and lives in
plugins/ — see cli/ai-os-plugin. Until 2026-08-31 those two meanings were inverted; this
file was cli/ai-os-plugin and read plugins/. Task AIOS-005 resolved it.

Core resolves, adapters integrate: an adapter declares paths only inside its OWN client's
config domain, and never inside $AI_OS_HOME. That rule is mechanically checkable, so it is
checked here and failed hard.

Zero dependencies: stdlib only, like every other tool in this system. That means a small
strict parser for the manifest subset rather than pyyaml — it REJECTS anything it does not
understand instead of guessing, because a silently mis-parsed manifest is worse than an
unreadable one.

Strict about meaning, not about layout: a flow collection is read whether it sits on its
key's line or on the line(s) below it, because a code formatter moves it and the document
is unchanged either way. A collection that never closes is still an error.
"""
import os, re, sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
# Overridable so the test suite can point at fixtures instead of the real registry.
ADAPTERS = Path(os.environ.get("AI_OS_ADAPTERS", REPO / "adapters"))
AI_OS_HOME = Path(os.environ.get("AI_OS_HOME", Path.home() / ".ai-os"))
CORE_CONTRACT_RANGE = (1, 1)          # this core supports contract 1..1
CORE_RESOURCES = {"rules.render", "skills.list", "workspace.memory.path",
                  "workspace.knowledge.path", "policies.list"}
# Integration points core delegates to an adapter. Core defines the point and owns the
# behaviour; the adapter supplies only its own client's facts. It may not invent one.
CORE_INTEGRATIONS = {"memory.mounts"}
CLIENT_DOMAIN = re.compile(r"^~?/?\.?(claude|codex|gemini|cursor|config/opencode|opencode)")

G, Y, R, B, D, X = "\033[32m", "\033[33m", "\033[31m", "\033[34m", "\033[2m", "\033[0m"
if not sys.stdout.isatty():
    G = Y = R = B = D = X = ""


class ManifestError(Exception):
    pass


# ------------------------------------------------------------------ parser
def _scalar(tok):
    t = tok.strip()
    if len(t) >= 2 and t[0] == t[-1] and t[0] in "\"'":
        return t[1:-1]
    low = t.lower()
    if low in ("null", "~", ""):
        return None
    if low == "true":
        return True
    if low == "false":
        return False
    if re.fullmatch(r"-?\d+", t):
        return int(t)
    return t


def _split_flow(body):
    """Split a flow collection on top-level commas only."""
    out, depth, cur, quote = [], 0, "", None
    for ch in body:
        if quote:
            cur += ch
            if ch == quote:
                quote = None
            continue
        if ch in "\"'":
            quote = ch; cur += ch; continue
        if ch in "{[":
            depth += 1
        elif ch in "}]":
            depth -= 1
        if ch == "," and depth == 0:
            out.append(cur); cur = ""
        else:
            cur += ch
    if cur.strip():
        out.append(cur)
    return out


def _flow(tok):
    t = tok.strip()
    if t.startswith("{") and t.endswith("}"):
        d = {}
        for part in _split_flow(t[1:-1]):
            if ":" not in part:
                raise ManifestError(f"flow map entry without a key: {part.strip()!r}")
            k, _, v = part.partition(":")
            d[k.strip()] = _flow(v)
        return d
    if t.startswith("[") and t.endswith("]"):
        return [_flow(p) for p in _split_flow(t[1:-1])]
    if t.startswith(("{", "[")) or t.endswith(("}", "]")):
        raise ManifestError(f"unbalanced flow collection: {t!r}")
    return _scalar(t)


def parse(text, where="manifest"):
    """Indent-based parser for the manifest subset. Raises on anything else."""
    lines = text.splitlines()
    i = 0

    def wrapped_flow(indent):
        """Read a flow collection a formatter moved onto the line(s) below its key.

        Joins continuation lines until the collection closes. A collection that never
        closes, or trailing content after it, is an error — the parser reports it rather
        than inventing a reading."""
        nonlocal i
        buf, depth, quote, start = [], 0, None, i + 1
        while i < len(lines):
            cur = lines[i]
            if not cur.strip() or cur.lstrip().startswith("#"):
                i += 1; continue
            ci = len(cur) - len(cur.lstrip())
            if buf and ci <= indent:
                break
            body, end = cur.strip(), None
            for pos, ch in enumerate(body):
                if quote:
                    if ch == quote:
                        quote = None
                    continue
                if ch in "\"'":
                    quote = ch
                elif ch in "{[":
                    depth += 1
                elif ch in "}]":
                    depth -= 1
                    if depth < 0:
                        raise ManifestError(
                            f"{where}: unbalanced flow collection at line {i+1}")
                    if depth == 0:
                        end = pos
                        break
            i += 1
            if end is None:
                buf.append(body)
                continue
            buf.append(body[:end + 1])
            trailing = body[end + 1:].strip()
            if trailing and not trailing.startswith("#"):
                raise ManifestError(f"{where}: content after the flow collection at "
                                    f"line {i}: {trailing!r}")
            break
        if depth != 0:
            raise ManifestError(f"{where}: unterminated flow collection at line {start}")
        return " ".join(buf)

    def block(indent):
        nonlocal i
        out = {}
        while i < len(lines):
            raw = lines[i]
            if not raw.strip() or raw.lstrip().startswith("#"):
                i += 1; continue
            ind = len(raw) - len(raw.lstrip())
            if ind < indent:
                return out
            if ind > indent:
                raise ManifestError(f"{where}: unexpected indent at line {i+1}")
            line = raw.strip()
            if ":" not in line:
                raise ManifestError(f"{where}: not a key at line {i+1}: {line!r}")
            key, _, rest = line.partition(":")
            key = key.strip()
            rest = rest.strip()
            i += 1
            if rest in (">", "|", ">-", "|-"):          # folded/literal scalar
                buf, child = [], None
                while i < len(lines):
                    nxt = lines[i]
                    if not nxt.strip():
                        buf.append(""); i += 1; continue
                    ci = len(nxt) - len(nxt.lstrip())
                    if ci <= indent:
                        break
                    child = ci if child is None else child
                    buf.append(nxt[child:]); i += 1
                joined = " ".join(x.strip() for x in buf if x.strip())
                out[key] = joined
            elif rest == "":               # nested block, block list, or a wrapped flow
                j = i
                while j < len(lines) and (not lines[j].strip()
                                          or lines[j].lstrip().startswith("#")):
                    j += 1
                nxt = lines[j] if j < len(lines) else None
                nind = (len(nxt) - len(nxt.lstrip())) if nxt is not None else -1
                if nxt is not None and nxt.lstrip().startswith("- ") and nind > indent:
                    items, li = [], len(lines[j]) - len(lines[j].lstrip())
                    i = j
                    while i < len(lines):
                        cur = lines[i]
                        if not cur.strip() or cur.lstrip().startswith("#"):
                            i += 1; continue
                        ci = len(cur) - len(cur.lstrip())
                        if ci < li or not cur.lstrip().startswith("- "):
                            break
                        items.append(_flow(cur.lstrip()[2:].split("#", 1)[0].strip()))
                        i += 1
                    out[key] = items
                elif nxt is not None and nind > indent and nxt.lstrip()[0] in "{[":
                    # A formatter (Prettier and friends) moves a flow collection onto the
                    # line after its key. Same document, different layout — so read it,
                    # but only when the collection actually closes. An unbalanced one is
                    # still rejected rather than repaired by guesswork.
                    i = j
                    out[key] = _flow(wrapped_flow(indent))
                else:
                    out[key] = block(indent + 2)
            else:
                # An inline comment is only a comment outside quotes and flow collections.
                if not rest.startswith(("{", "[", '"', "'")):
                    rest = rest.split("#", 1)[0].strip()
                elif rest.startswith(("{", "[")):
                    close = "}" if rest[0] == "{" else "]"
                    cut = rest.rfind(close)
                    if cut == -1:
                        raise ManifestError(f"{where}: unterminated flow at line {i}")
                    rest = rest[:cut + 1]
                out[key] = _flow(rest)
        return out

    doc = block(0)
    if i < len(lines) and any(l.strip() and not l.lstrip().startswith("#") for l in lines[i:]):
        raise ManifestError(f"{where}: trailing content the parser could not place")
    return doc


# ------------------------------------------------------------------ validation
REQUIRED = ("adapter", "name", "contract", "client", "provides", "writes")


def validate(pid, m):
    """Return (errors, warnings). Never raises; never touches the filesystem."""
    err, warn = [], []

    for k in REQUIRED:
        if k not in m:
            err.append(f"missing required key: {k}")
    if err:
        return err, warn

    if m["adapter"] != pid:
        err.append(f"adapter id {m['adapter']!r} != directory name {pid!r}")

    lo, hi = CORE_CONTRACT_RANGE
    c = m["contract"]
    if not isinstance(c, int):
        err.append(f"contract must be an integer, got {c!r}")
    elif not (lo <= c <= hi):
        err.append(f"requires contract {c}; this core supports {lo}..{hi} — DISABLED")

    prov = m["provides"] if isinstance(m["provides"], dict) else {}
    if not isinstance(m["provides"], dict):
        err.append("provides: must be a map")

    for cap, spec in prov.items():
        if not isinstance(spec, dict):
            err.append(f"provides.{cap}: must be a map with path/format/verified"); continue
        for field in ("path", "format", "verified"):
            if field not in spec:
                err.append(f"provides.{cap}: missing required field {field!r}")
        p = spec.get("path")
        if p:
            # THE HARD RULE: never inside the private workspace.
            expanded = Path(os.path.expanduser(str(p)))
            try:
                resolved = expanded if expanded.is_absolute() else (Path.home() / str(p))
                inside = str(resolved).startswith(str(AI_OS_HOME) + os.sep) or \
                         str(resolved) == str(AI_OS_HOME)
            except Exception:
                inside = False
            if inside:
                err.append(f"provides.{cap}.path resolves INSIDE $AI_OS_HOME ({p}) — "
                           f"an adapter may never declare private workspace paths")
            elif not CLIENT_DOMAIN.match(str(p).replace(str(Path.home()), "~").lstrip("~/")
                                         .join(["", ""]) or str(p)):
                pass  # domain shape is advisory; the hard rule above is the enforced one

    writes = m["writes"] if isinstance(m["writes"], list) else []
    if not isinstance(m["writes"], list):
        err.append("writes: must be a list")
    for w in writes:
        if w not in prov:
            err.append(f"writes lists {w!r} which is not in provides")
        elif prov[w].get("verified") is not True:
            err.append(f"writes lists {w!r} but provides.{w}.verified is "
                       f"{prov[w].get('verified')!r} — core MUST NOT write an unverified "
                       f"surface")
        elif prov[w].get("writable") is False:
            err.append(f"writes lists {w!r} but it is marked writable:false")

    for r in (m.get("requires") or []):
        if r not in CORE_RESOURCES:
            err.append(f"requires unknown core resource: {r!r}")

    integ = m.get("integrates")
    if integ is not None and not isinstance(integ, dict):
        err.append("integrates: must be a map")
    elif integ:
        for point, spec in integ.items():
            if point not in CORE_INTEGRATIONS:
                err.append(f"integrates unknown core integration point: {point!r} — "
                           f"core defines these; an adapter may not invent one")
                continue
            if not isinstance(spec, dict):
                err.append(f"integrates.{point}: must be a map with "
                           f"command/format/verified"); continue
            for field in ("command", "format", "verified"):
                if field not in spec:
                    err.append(f"integrates.{point}: missing required field {field!r}")
            cmd = str(spec.get("command") or "")
            if cmd and ("/" in cmd or cmd.startswith(".")):
                err.append(f"integrates.{point}.command must be a bare filename inside "
                           f"adapters/{pid}/ — got {cmd!r}")
            if spec.get("verified") is not True:
                warn.append(f"integrates.{point} verified={spec.get('verified')!r} — core "
                            f"will not call it (a gap stays visible rather than guessed at)")

    client = m.get("client") or {}
    if "consumer_verified" not in client:
        warn.append("client.consumer_verified not declared — assumed false")
    elif client.get("consumer_verified") is not True:
        warn.append("consumer not verified — paths are confirmed, reading is not observed")

    for cap, spec in prov.items():
        if isinstance(spec, dict) and spec.get("verified") is not True and cap not in writes:
            warn.append(f"provides.{cap} verified={spec.get('verified')!r} — not written "
                        f"(correct: a gap stays visible rather than being guessed at)")
    return err, warn


def installed(m):
    for p in (m.get("client") or {}).get("detect") or []:
        if Path(os.path.expanduser(str(p))).exists():
            return True
    return False


def load_all():
    out = []
    if not ADAPTERS.is_dir():
        return out
    for d in sorted(ADAPTERS.iterdir()):
        f = d / "adapter.yaml"
        if not f.is_dir() and f.exists():
            try:
                out.append((d.name, parse(f.read_text(), f"adapters/{d.name}"), None))
            except ManifestError as e:
                out.append((d.name, None, str(e)))
    return out


# ------------------------------------------------------------------ commands
def cmd_list(_):
    rows = load_all()
    if not rows:
        print(f"\n  no adapters in {ADAPTERS}\n"); return 0
    print(f"\n  {B}adapters{X}  {D}{ADAPTERS}{X}\n")
    print(f"  {'ID':<14} {'INSTALLED':<11} {'CONTRACT':<9} {'WRITES':<16} CONSUMER")
    for pid, m, e in rows:
        if e:
            print(f"  {pid:<14} {R}unreadable manifest{X}"); continue
        inst = f"{G}yes{X}" if installed(m) else f"{D}no{X}"
        w = ", ".join(m.get("writes") or []) or f"{D}nothing{X}"
        cv = (m.get("client") or {}).get("consumer_verified")
        cvs = f"{G}verified{X}" if cv is True else f"{Y}unverified{X}"
        print(f"  {pid:<14} {inst:<20} {m['contract']:<9} {w:<16} {cvs}")
    print(f"\n  {D}'writes: nothing' is a valid outcome — see each manifest's notes.{X}")
    print(f"  {D}unverified consumer = path confirmed, reading not observed.{X}\n")
    return 0


def cmd_doctor(_):
    rows = load_all()
    fails = warns = 0
    print(f"\n  {B}adapter doctor{X}  {D}contract range {CORE_CONTRACT_RANGE[0]}.."
          f"{CORE_CONTRACT_RANGE[1]} · workspace {AI_OS_HOME}{X}\n")
    for pid, m, e in rows:
        if e:
            print(f"  {R}FAIL{X}  {pid}: {e}"); fails += 1; continue
        errs, ws = validate(pid, m)
        for x in errs:
            print(f"  {R}FAIL{X}  {pid}: {x}"); fails += 1
        for x in ws:
            print(f"  {Y}WARN{X}  {pid}: {x}"); warns += 1
        if not errs:
            print(f"  {G}ok{X}    {pid}: manifest valid"
                  f"{'' if installed(m) else f'  {D}(client not installed){X}'}")
    print()
    if fails:
        print(f"  {R}{fails} failure(s){X}, {Y}{warns} warning(s){X}\n")
    else:
        print(f"  {G}all manifests valid{X}"
              f"{f', {Y}{warns} warning(s){X}' if warns else ''}\n")
    return fails


def cmd_not_wired(args):
    verb = args[0] if args else "enable"
    print(f"\n  {Y}not wired yet.{X} `ai-os adapter {verb}` would set a registry flag that "
          f"nothing reads:\n"
          f"  ai-sync still resolves clients from its own hardcoded CLIENTS table, not from\n"
          f"  these manifests. Wiring that is Step 8 and needs explicit approval.\n\n"
          f"  Writing a flag now would create state nothing consumes — the exact defect\n"
          f"  this migration already found once. Refusing instead.\n")
    return 2


CMDS = {"list": cmd_list, "doctor": cmd_doctor}
if __name__ == "__main__":
    a = sys.argv[1:] or ["list"]
    if a[0] in ("enable", "disable"):
        sys.exit(cmd_not_wired(a))
    if a[0] not in CMDS:
        print(__doc__); sys.exit(2)
    sys.exit(CMDS[a[0]](a[1:]))
