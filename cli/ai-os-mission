def _render_result(view):
    print(f"\n  {B}mission result{X}  {view['mission_id']} / {view['handoff_id']}")
    print(f"  has result:          {view['has_result']}")
    print(f"  classification:      {view['classification']}")
    if view["has_result"]:
        v = view["verification"]
        print(f"  checks:")
        for c in v["checks"]:
            mark = "ok" if c["ok"] else "FAIL"
            print(f"    - {c['check']}: {mark}" + (f" ({c['detail']})" if c["detail"] else ""))
        if v.get("blocker"):
