def main(argv):
    if not argv or argv[0] in ("help", "--help", "-h"):
        usage()
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == "create":
        return cmd_create(rest)
    if cmd == "approve":
        return cmd_approve(rest)
    if cmd == "show":
        return cmd_show(rest)
    if cmd == "status":
        return cmd_status(rest)
    if cmd == "route":
        return cmd_route(rest)
    if cmd == "validate":
        return cmd_validate(rest)
    if cmd == "plan":
        return cmd_plan(rest)
    if cmd == "run":
        return cmd_run(rest)
    if cmd == "handoff":
        return cmd_handoff(rest)
    if cmd == "verify":
        return cmd_verify(rest)
    if cmd == "result":
        return cmd_result(rest)
    if cmd == "continue":
        return cmd_continue(rest)
    if cmd == "execute":
        return cmd_execute(rest)
    if cmd == "finalize":
        return cmd_finalize(rest)
    die(f"unknown mission subcommand {cmd!r} — one of: create, approve, show, status, "
        f"route, validate, plan, run, handoff, verify, result, continue, execute, finalize")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
