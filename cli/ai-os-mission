    root_task_id, mission_id, rest = args[0], args[1], args[2:]
    values, _lists, _flags = _parse_flags(rest, ("--owner-words", "--idempotency-key"), (),
                                          "mission approve")

    task_dir = _mission_call(lambda: m.resolve_task_dir(root_task_id))
    result = _mission_call(lambda: m.mission_approve(
        task_dir, root_task_id, mission_id, values["--owner-words"],
        values["--idempotency-key"]))

    print(f"\n  {B}mission approve{X}  {root_task_id} / {mission_id}")
    print(f"  state:               {result['state']}")
    print(f"  approval:            {result['approval']}")
    print(f"  approved at:         {result['approved_at']}")
