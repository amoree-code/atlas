#!/usr/bin/env python3
"""ai-os-mission — T-051-S1: Mission Contract and durable Mission Run State layer only.

  ai-os mission create <root-task-id> \\
        --scope <relative-file-path> [--scope <relative-file-path> ...] \\
        --planner <client-id> --executor <client-id> --verifier <client-id> \\
        --budget-usd <non-negative-number> --max-slices <positive-integer> \\
        --max-attempts <positive-integer> --ttl-seconds <positive-integer> \\
        --idempotency-key <key> [--mission-id <id>] [--source-session-id <id>]
  ai-os mission approve <root-task-id> <mission-id> --owner-words <text> \\
        --idempotency-key <key>
  ai-os mission show <root-task-id> <mission-id> [--json]
  ai-os mission status <root-task-id> <mission-id> [--json]
  ai-os mission route <root-task-id> <mission-id> --role <planner|executor|verifier> \\
        [--capability <capability>] [--json]
  ai-os mission validate <root-task-id> <mission-id> [--json]
  ai-os mission plan <root-task-id> <mission-id> --planner-session <id> \
        --invocation-id <id> --idempotency-key <key> [--json]
  ai-os mission run <root-task-id> <mission-id> --executor-session <id> \
        --invocation-prefix <id> --idempotency-key <key> [--json]
  ai-os mission handoff <root-task-id> <mission-id> --scope <approved-scope> \\
        --executor-client <client-id> --executor-session <id> --invocation-id <id> \\
        --gate <gate> --slice-budget-usd <non-negative-number> \\
        --idempotency-key <key> [--json]
  ai-os mission verify <root-task-id> <mission-id> <handoff-id> \\
        --result-file <path> --idempotency-key <key> [--json]
  ai-os mission result <root-task-id> <mission-id> <handoff-id> [--json]
  ai-os mission continue <root-task-id> <mission-id> <handoff-id> --scope <approved-scope> \\
        --executor-client <client-id> --executor-session <id> --invocation-id <id> \\
        --gate <gate> --slice-budget-usd <non-negative-number> \\
        --idempotency-key <key> [--json]
  ai-os mission execute <root-task-id> <mission-id> <handoff-id> \\
        --executor-client <client-id> --executor-session <id> --invocation-id <id> \\
        --idempotency-key <key> [--json]
  ai-os mission finalize <root-task-id> <mission-id> <handoff-id> \\
        --idempotency-key <key> [--json]

This is the safe foundation for a later planner -> executor -> verifier loop
(projects/ai-os/tickets/T-051/task.md) — it does NOT execute that loop. `create` writes only
an unapproved mission (state `created`, approval `none`); `approve` requires explicit
non-empty `--owner-words` and only ever moves a mission from `created` to `approved`, once,
immutably. Neither command invokes any AI, prepares or sends a handoff, acquires a lease or
a file claim, or starts any background process — there is no daemon, queue, worker,
scheduler, or watcher anywhere in this file or in `cli/aios_mission.py`. `show` and `status`
are entirely read-only.

`route` and `validate` (T-051-S2) resolve the mission's declared planner/executor/verifier
client against the existing adapter registry (`adapters/*/adapter.yaml`) and the existing
verified transport registry (`internal/governance/policies/handoff-transports.yaml`) — never
by a hard-coded vendor name, never by inferring a capability from a client or binary name.
Both are entirely read-only: no mission state change, no lease, no file claim, no handoff, no
approval, no send, no dispatch, and no AI invocation.

`handoff` (T-051-S3) creates one bounded, foreground planner-to-executor handoff: a
deterministic packet plus a durable receipt, written only under this mission's own
`mission/<mission-id>/handoffs/` directory. It requires an approved mission, resolves planner
and executor through the existing `route` resolution, and requires the given scope to be
exactly one of the mission's own approved scopes and the given executor client to exactly
match the contract's own `executor_client`. It never invokes any client, never acquires a
T-050 lease or file claim, never writes a V6 handoff record under the ticket, never approves
anything, and never selects a next mission or slice on its own.

`verify` (T-051-S4) validates one executor-returned result — supplied only via an explicit
local `--result-file <path>`, never stdin, never an environment variable, never a network
fetch — against that handoff's own packet, and classifies it into exactly one of PASS /
BLOCKED / FAILED / NEEDS_OWNER. It persists the result and its verification evidence only
under that handoff's own directory; it never touches the mission's own state, never invokes
any client, never acquires a lease or claim, never approves anything, and never creates
another handoff. `result` is the paired read-only inspector of whatever `verify` has already
recorded.

`continue` (T-051-S5) creates AT MOST ONE next bounded handoff (same packet/receipt shape as
`handoff`) from a previous handoff whose own `verify` classification is exactly PASS — never a
raw self-reported status. Every mission limit and contract boundary is revalidated from the
CURRENT contract/state before writing anything: approval, mission state, approval scope hash,
ttl, max_attempts, max_slices, total budget, the exact approved scope, the exact contract
executor identity, the previous handoff's own executor_session (a continuation never moves to
a different session/authority), and all three roles' routing. It never invokes any client,
never dispatches or sends anything, never acquires a lease or claim, never approves anything,
never marks the mission completed, and never calls itself.

`execute` (T-051-S7 execution integration) invokes exactly one bounded foreground subprocess
for an existing handoff whose executor transport is `verified: true`, and converts whatever
the executor returns into the existing `verify` classification by calling `mission_verify`
directly — never a second classifier. It never approves, never expands scope/tools/identity,
never selects a different client, never retries, and never runs in the background.

`finalize` (T-051-S6) reads one existing handoff's own `verify` classification — never a raw
executor status — and, once every mission limit and every piece of evidence checks out
(including a self-contradiction check: S4's own classification priority is recomputed from
the persisted `checks` list and compared to the stored classification), writes exactly one
set of durable final packets under this mission's own `mission/<mission-id>/final/`
directory (`final-report.json`, `session-summary.json`, `notification-packet.json`, plus
`blocker-packet.json` for BLOCKED/FAILED or `owner-decision-packet.json` for NEEDS_OWNER) and
moves the mission into exactly one terminal state: `completed` (PASS, only once every
completion condition is independently reconfirmed), `blocked`, `failed`, or `needs_owner`. A
mission is finalized at most once — every terminal state refuses a second, non-replay
finalize attempt. It never invokes any client, never creates a handoff, never dispatches or
sends, never acquires a lease or claim, and never rewrites owner approval evidence.

`--idempotency-key` on `approve` is not in the literal usage line the S1 prompt's section A
gives for `mission approve` (only `--owner-words` is), but section E requires idempotent
replay of `approve` keyed by "the same idempotency key" — which needs a key parameter to
exist. This file resolves that gap conservatively by requiring `--idempotency-key` on
`approve` too, exactly as `create` already requires one; see
`projects/ai-os/tickets/T-051/T-051-S1-implementation.md` for the explicit note.

Exit: 0 ok · 2 usage or validation refusal · 4 not found (root ticket / mission) ·
5 conflict or blocked (duplicate mission id, invalid state transition, guard timeout,
corrupt record).
Zero non-stdlib dependencies.
"""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import aios_mission as m

G, Y, R, B, D, X = "\033[32m", "\033[33m", "\033[31m", "\033[34m", "\033[2m", "\033[0m"
if not sys.stdout.isatty():
    G = Y = R = B = D = X = ""


def die(msg, code=2):
    print(f"  {R}refused{X} {msg}", file=sys.stderr)
    sys.exit(code)


def usage():
    print(__doc__)


def _parse_flags(rest, single, repeatable, label, boolean=()):
    """One flag-value pass: `single` flags may appear at most once each and take a value;
    `repeatable` flags (only `--scope` today) may appear any number of times and take a
    value, accumulating into a list; `boolean` flags (only `--json` today) take no value.
    Anything else is an unknown-argument refusal."""
    values = {k: None for k in single}
    lists = {k: [] for k in repeatable}
    flags = {k: False for k in boolean}
    seen = set()
    i = 0
    while i < len(rest):
        a = rest[i]
        if a in boolean:
            flags[a] = True
            i += 1
        elif a in single:
            if i + 1 >= len(rest):
                die(f"{a} needs a value")
            if a in seen:
                die(f"{a} was given more than once — one {label} has one {a[2:]}")
            seen.add(a)
            values[a] = rest[i + 1]
            i += 2
        elif a in repeatable:
            if i + 1 >= len(rest):
                die(f"{a} needs a value")
            lists[a].append(rest[i + 1])
            i += 2
        else:
            die(f"unknown argument {a!r}")
    return values, lists, flags


def _mission_call(fn):
    try:
        return fn()
    except m.MissionError as e:
        die(str(e), code=e.code)


def cmd_create(args):
    if not args or args[0].startswith("-"):
        die("usage: ai-os mission create <root-task-id> --scope <path> [--scope <path> ...] "
            "--planner <c> --executor <c> --verifier <c> --budget-usd <n> "
            "--max-slices <n> --max-attempts <n> --ttl-seconds <n> "
            "--idempotency-key <key> [--mission-id <id>] [--source-session-id <id>]")
    root_task_id, rest = args[0], args[1:]
    single = ("--planner", "--executor", "--verifier", "--budget-usd", "--max-slices",
              "--max-attempts", "--ttl-seconds", "--idempotency-key", "--mission-id",
              "--source-session-id")
    values, lists, _flags = _parse_flags(rest, single, ("--scope",), "mission create")

    task_dir = _mission_call(lambda: m.resolve_task_dir(root_task_id))
    project = m.task_field(task_dir, "project", default="unspecified")

    result = _mission_call(lambda: m.mission_create(
        task_dir, root_task_id, project, lists["--scope"],
        values["--planner"], values["--executor"], values["--verifier"],
        values["--budget-usd"], values["--max-slices"], values["--max-attempts"],
        values["--ttl-seconds"], values["--idempotency-key"],
        mission_id=values["--mission-id"], source_session_id=values["--source-session-id"]))

    print(f"\n  {B}mission create{X}  {root_task_id}")
    print(f"  mission id:  {result['mission_id']}")
    print(f"  state:       {result['state']}")
    print(f"  approval:    {result['approval']}")
    print(f"  created at:  {result['created_at']}")
    if result.get("replay"):
        print(f"  {D}(duplicate idempotency key — original result returned, no second "
              f"mission was created){X}")
    print(f"  {D}unapproved: no executor action, no handoff, no lease, no file claim, no "
          f"AI invocation{X}\n")
    return 0


