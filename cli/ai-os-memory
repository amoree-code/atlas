#!/usr/bin/env python3
"""ai-os-memory — the memory engine. Client-agnostic by construction.

Memory is a core Atlas capability, not a feature of whichever client happens to consume
it today. This file therefore contains no client name, no client path, and no branch on
client identity. Everything it knows about a client arrives through the adapter registry.

  ai-os memory status              the canonical store, and every mount adapters declare
  ai-os memory doctor              memory + knowledge health; reports, changes nothing
  ai-os memory attach [PATH...]    point PATH at the canonical store; no PATH = every mount
  ai-os memory attach --here       only the mount(s) serving the current directory

Mounts
------
Some clients keep memory in a directory of their own choosing — scoped per project, per
workspace, or per session. Those clients declare that fact in their adapter manifest:

    integrates:
      memory.mounts: { command: <exe>, format: newline-paths, verified: true }

Core runs `adapters/<id>/<exe> list` to learn the paths, and `... path <dir>` to ask
which mount serves a working directory. Core decides what a healthy mount is; the plugin
decides only where its client's mounts are. Any client can supply that command and get
the whole engine — nothing here is specialized to one.

Public API (importable by any consumer, no client dependency):
    store()            -> Path        the canonical memory store
    mounts()           -> [Mount]     every mount declared by an installed plugin
    attach(path)       -> str         make one path resolve to the store, non-destructively
    validate()         -> (bad, warn) memory + knowledge format validation

Zero dependencies: stdlib only.
"""
import os, re, shutil, subprocess, sys
from collections import defaultdict
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
AI_OS_HOME = Path(os.environ.get("AI_OS_HOME", Path.home() / ".ai-os"))
# One root: since V0.4 an adapter's manifest and its executables are siblings in
# adapters/<id>/, so there is nothing left for a second variable to point at.
ADAPTERS = Path(os.environ.get("AI_OS_ADAPTERS", REPO / "adapters"))

# The store and the knowledge base are being relocated one slice at a time; the engine
# asks where they are now. There is exactly one canonical store either way — two paths
# that both hold data is a conflict the user resolves, never one this tool picks between.
sys.path.insert(0, str(REPO / "cli"))
from aios_paths import private_path_or_die  # noqa: E402

CANON = private_path_or_die("memory")
KNOW_ROOT = private_path_or_die("knowledge")

# Where a pre-existing real memory directory is moved before its path becomes a link.
# Overridable so the runtime layer can keep using its historical location until that
# layer is retired; the default is inside the private workspace, which is where a
# user's rescued data belongs.
QUARANTINE = Path(os.environ.get(
    "AI_OS_MEMORY_QUARANTINE", private_path_or_die("inbox") / "quarantined-memory"))

SECTIONS = ["identity", "education", "career", "projects", "goals",
            "travel", "preferences", "interests"]
KNOWLEDGE = ["task-results", "technical-solutions", "decisions", "architecture",
             "research", "discoveries", "failures"]

G, Y, R, D, X = "\033[32m", "\033[33m", "\033[31m", "\033[2m", "\033[0m"
if not sys.stdout.isatty():
    G = Y = R = D = X = ""


def store() -> Path:
    return CANON


# ------------------------------------------------------------------ mount discovery
class Mount:
    """One directory a client expects its memory to be reachable at.

    `label` is the mount's parent directory name — a display handle only. Core derives it
    positionally and never parses meaning out of it.
    """

    def __init__(self, path: Path, plugin: str):
        self.path, self.plugin = path, plugin
        self.label = path.parent.name

    def state(self) -> str:
        if self.path.is_symlink():
            try:
                return "linked" if self.path.resolve() == CANON.resolve() else "elsewhere"
            except OSError:
                return "broken"
        return "unlinked" if self.path.exists() else "absent"


def _providers():
    """Adapters declaring integrates.memory.mounts, as (adapter_id, executable).

    Discovery is by declaration. An adapter that does not declare the integration is not
    asked, and an unverified declaration is not trusted — the same rule `provides` uses.
    """
    out = []
    if not ADAPTERS.is_dir():
        return out
    sys.path.insert(0, str(REPO / "cli"))
    for d in sorted(ADAPTERS.iterdir()):
        f = d / "adapter.yaml"
        if f.is_dir() or not f.exists():
            continue
        try:
            man = _parse(f.read_text(), str(f))
        except Exception:
            continue
        spec = ((man.get("integrates") or {}).get("memory.mounts")) or {}
        if not isinstance(spec, dict) or spec.get("verified") is not True:
            continue
        cmd = spec.get("command")
        if not cmd:
            continue
        exe = ADAPTERS / d.name / str(cmd)
        if exe.exists() and os.access(exe, os.X_OK):
            out.append((d.name, exe))
    return out


_PARSER = {}


def load_sibling(path):
    """Import an extensionless Atlas tool as a module. Its __main__ guard prevents its
    CLI from executing, so importing one is free of side effects."""
    import importlib.util
    from importlib.machinery import SourceFileLoader
    name = "aios_" + Path(path).name.replace("-", "_")
    spec = importlib.util.spec_from_loader(name, SourceFileLoader(name, str(path)))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def _parse(text, where):
    """Reuse the registry's manifest parser — one parser, one set of rules.

    Loaded as a module, not sliced as text: the file's own __main__ guard keeps its CLI
    from running, so there is no source-splitting to get wrong.
    """
    if not _PARSER:
        _PARSER["parse"] = load_sibling(REPO / "cli" / "ai-os-adapter").parse
    return _PARSER["parse"](text, where)


def _ask(exe, *args):
    try:
        r = subprocess.run([str(exe), *args], capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return []
    if r.returncode != 0:
        return []
    return [ln.strip() for ln in r.stdout.splitlines() if ln.strip()]


def mounts():
    out = []
    for pid, exe in _providers():
        for line in _ask(exe, "list"):
            out.append(Mount(Path(os.path.expanduser(line)), pid))
    return out


def mounts_for(cwd: Path):
    out = []
    for pid, exe in _providers():
        for line in _ask(exe, "path", str(cwd)):
            out.append(Mount(Path(os.path.expanduser(line)), pid))
    return out


# ------------------------------------------------------------------ attach
def attach(target: Path, quiet=False) -> str:
    """Make `target` resolve to the canonical store. Never destroys user data.

    A real directory holding real files is moved to quarantine first, never deleted.
    """
    if not CANON.is_dir():
        return "no-canonical-store"
    target = Path(target)

    if target.is_symlink():
        try:
            if target.resolve() == CANON.resolve():
                return "ok"
        except OSError:
            pass
        target.unlink()                       # pointed somewhere else — repoint
    elif target.exists():
        keep = sorted(p for p in target.iterdir() if p.name != ".DS_Store")
        if keep:
            QUARANTINE.mkdir(parents=True, exist_ok=True)
            dest = QUARANTINE / f"{target.parent.name}-{os.getpid()}"
            shutil.move(str(target), str(dest))
            if not quiet:
                print(f"  {Y}moved{X} pre-existing memory -> {dest}")
                print(f"  {Y}    {X} review it and merge anything worth keeping into {CANON}")
        else:
            target.rmdir()
    target.parent.mkdir(parents=True, exist_ok=True)
    target.symlink_to(CANON, target_is_directory=True)
    return "linked"


# ------------------------------------------------------------------ validation
def _md(root):
    return [p for p in root.rglob("*.md")
            if p.name not in ("README.md", "MEMORY.md", "CONFLICTS.md")]


def validate(check_mounts=True, emit=print):
    """Memory + knowledge format validation. Returns (failures, warnings)."""
    bad = warn = 0

    def fail(m):
        nonlocal bad; emit(f"  {R}FAIL{X} {m}"); bad += 1

    def note(m):
        nonlocal warn; emit(f"  {Y}WARN{X} {m}"); warn += 1

    # --- structure -----------------------------------------------------------
    if not CANON.is_dir():
        fail(f"canonical store missing: {CANON}"); return 1, warn
    for f in ("MEMORY.md", "README.md"):
        if not (CANON / f).exists():
            fail(f"missing memory/{f} — the retrieval index")
    for s in SECTIONS:
        d = CANON / s
        if not d.is_dir():
            fail(f"missing main section: memory/{s}/")
        elif not any(d.glob("*.md")):
            note(f"empty section: memory/{s}/ — remove it or give it content")
    if KNOW_ROOT.is_dir():
        for s in KNOWLEDGE:
            if not (KNOW_ROOT / s).is_dir():
                fail(f"missing knowledge section: knowledge/{s}/")
    else:
        fail("knowledge/ layer missing")

    # --- scoping: every declared mount must resolve to the one store ---------
    if check_mounts:
        for m in mounts():
            if m.state() == "unlinked":
                fail(f"unlinked memory dir: {m.path}  (run: ai-os memory attach)")
            elif m.state() == "elsewhere":
                fail(f"memory dir points outside the canonical store: {m.path}")
            elif m.state() == "broken":
                fail(f"broken memory link: {m.path}")

    # --- per-file checks -----------------------------------------------------
    files = _md(CANON) + (_md(KNOW_ROOT) if KNOW_ROOT.is_dir() else [])
    seen_names, descs = defaultdict(list), defaultdict(list)
    for f in files:
        head = f.read_text()[:1200]
        rel = f.relative_to(AI_OS_HOME)
        if not head.startswith("---"):
            fail(f"no frontmatter: {rel}"); continue
        name = re.search(r"^name:\s*(\S+)", head, re.M)
        desc = re.search(r"^description:\s*(.+)", head, re.M)
        status = re.search(r"^\s*status:\s*(\S+)", head, re.M)
        if not name:
            fail(f"no name: in frontmatter: {rel}")
        else:
            seen_names[name.group(1)].append(rel)
        if not desc:
            fail(f"no description: in frontmatter: {rel}  (retrieval matches on it)")
        else:
            descs[desc.group(1).strip().lower()[:60]].append(rel)
        if status and status.group(1) in ("outdated", "temporary"):
            note(f"{status.group(1)}: {rel}")

    for n, ps in seen_names.items():
        if len(ps) > 1:
            fail(f"duplicate name '{n}' in: {', '.join(str(x) for x in ps)}")
    for d, ps in descs.items():
        if len(ps) > 1:
            note(f"near-identical descriptions — possible duplicate memory: "
                 f"{', '.join(str(x) for x in ps)}")

    # --- broken wiki-links ---------------------------------------------------
    targets = {str(f.relative_to(CANON)).removesuffix(".md") for f in CANON.rglob("*.md")}
    if KNOW_ROOT.is_dir():
        for f in KNOW_ROOT.rglob("*.md"):
            targets.add(str(f.relative_to(KNOW_ROOT)).removesuffix(".md"))
            m = re.search(r"^name:\s*(\S+)", f.read_text()[:600], re.M)
            if m:
                targets.add(m.group(1))
    for f in list(CANON.rglob("*.md")) + (list(KNOW_ROOT.rglob("*.md")) if KNOW_ROOT.is_dir() else []):
        for link in re.findall(r"\[\[([^\]]+)\]\]", f.read_text()):
            if link not in targets:
                fail(f"broken link [[{link}]] in {f.relative_to(AI_OS_HOME)}")

    # --- orphans: the index does not list it ---------------------------------
    index = (CANON / "MEMORY.md").read_text() if (CANON / "MEMORY.md").exists() else ""
    for f in _md(CANON):
        rel = str(f.relative_to(CANON)).removesuffix(".md")
        if rel not in index:
            note(f"not in MEMORY.md index: memory/{rel}.md")

    # --- conflicts -----------------------------------------------------------
    cf = CANON / "CONFLICTS.md"
    if cf.exists():
        n = cf.read_text().count("\n### ")
        if n:
            note(f"{n} unresolved conflict(s) in memory/CONFLICTS.md — "
                 f"they need a human decision")

    emit(f"\n  {len(files)} memory+knowledge files checked")
    if bad:
        emit(f"  {R}{bad} problem(s){X}" + (f", {warn} warning(s)" if warn else ""))
    else:
        emit(f"  {G}OK{X} structure, frontmatter, links and scoping are sound"
             + (f" · {warn} warning(s)" if warn else ""))
    return bad, warn


# ------------------------------------------------------------------ commands
def cmd_status(_):
    n = len(list(CANON.glob("*.md"))) if CANON.is_dir() else 0
    print(f"\n  canonical store  {CANON}  {D}({n} memories){X}")
    print(f"  git              "
          f"{'yes' if (AI_OS_HOME / '.git').exists() else R + 'NO — not yet version-controlled' + X}\n")
    for m in sorted(mounts(), key=lambda m: m.label):
        st = m.state()
        if st == "absent":
            continue
        if st == "linked":
            print(f"  {G}linked{X}   {m.label}")
        elif st == "elsewhere":
            print(f"  {Y}elsewhere{X} {m.label} -> {m.path.resolve()}")
        elif st == "broken":
            print(f"  {R}broken{X}   {m.label}")
        else:
            print(f"  {R}unlinked{X} {m.label}  {D}(real dir — run: ai-os memory attach){X}")
    print()
    return 0


def cmd_doctor(_):
    bad, _w = validate()
    return bad


def cmd_attach(args):
    """attach [--here] [PATH...]

    --here attaches only the mounts serving the current working directory. Which mounts
    those are is a question core asks the adapters — core has no notion of what makes a
    directory correspond to a mount, and does not acquire one here.
    """
    here = "--here" in args
    paths = [a for a in args if not a.startswith("--")]
    unknown = [a for a in args if a.startswith("--") and a != "--here"]
    if unknown:
        print(f"  unknown option: {unknown[0]}")
        return 2
    if here and paths:
        print("  --here takes no PATH arguments")
        return 2

    if paths:
        for a in paths:
            p = Path(os.path.expanduser(a)).resolve()
            print(f"  {attach(p):<8} {p}")
        return 0

    if here:
        cwd = Path.cwd()
        ms = mounts_for(cwd)
        if not ms:
            print(f"  {'skipped':<8} {cwd}  (no client declares a mount for it)")
            return 0
        for m in ms:
            print(f"  {attach(m.path):<8} {cwd}")
        return 0

    ms = mounts()
    if not ms:
        print("  no client declares memory mounts — nothing to attach")
        return 0
    for m in sorted(ms, key=lambda m: m.label):
        print(f"  {attach(m.path, quiet=True):<8} {m.label}")
    return 0


CMDS = {"status": cmd_status, "doctor": cmd_doctor, "attach": cmd_attach}

if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd not in CMDS:
        print(__doc__); sys.exit(2)
    sys.exit(CMDS[cmd](sys.argv[2:]) or 0)
