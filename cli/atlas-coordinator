# --- T-050-S7: coordinator begin / finalize — the explicit foreground coordination workflow.
# begin = lease acquire + file claim acquire + handoff prepare, in one call, with explicit
# compensation on any partial failure. finalize = read-only review + cost, then explicit
# claim release + lease release. Neither ever approves, sends, dispatches, receives, or
# selects a next hop — those remain manual, exactly as they are today. Both reuse the
# existing S6/S6-R1 library (`atlas_coordination.py`) and the existing V6 handoff/review/cost
# logic above; nothing here is a second implementation of any of that.
def _print_begin(result, replay=False):
    print(f"\n  {B}begin{X}  {result['task_id']} / {result['handoff_id']}")
    print(f"  task id:                {result['task_id']}")
    print(f"  lease id:               {result['lease_id']}")
    print(f"  claimed path:           {result['claimed_path']}")
    print(f"  handoff id:             {result['handoff_id']}")
    print(f"  destination:            {result['destination']}")
    print(f"  gate:                   {result['gate']}")
    print(f"  scope:                  {result['scope']}")
    print(f"  owner approval command: {result['approval_command']}")
    print(f"  next required action:   {result['next_action']}")
    if replay:
        print(f"  {D}(duplicate idempotency key — original begin result returned, no second "
              f"lease/claim/handoff was created){X}")
    print(f"  {D}begin only: lease active, claim active, handoff waiting-owner — approval "
          f"none, sent no. Nothing was approved, dispatched, sent or received here.{X}\n")


def cmd_begin(args):
    if not args or args[0].startswith("-"):
        die("usage: atlas coordinator begin <task-id> --intent <intent> --scope <path> "
            "--source-client <client-id> --source-session <session-id> "
            "--invocation <invocation-id> --ttl-seconds <n> --idempotency-key <key> "
            "[--id <handoff-id>] [--summary <text>]")
    task_id, rest = args[0], args[1:]
    v = _parse_flags(rest, ("--intent", "--scope", "--source-client", "--source-session",
                            "--invocation", "--ttl-seconds", "--idempotency-key", "--id",
                            "--summary"), "begin")
    intent = v.get("--intent")
    scope = v.get("--scope")
    source_client = v.get("--source-client")
    source_session = v.get("--source-session")
    invocation = v.get("--invocation")
    ttl_seconds = v.get("--ttl-seconds")
    idem_key = v.get("--idempotency-key")
    handoff_id = v.get("--id")
    summary = v.get("--summary")

    hoff = _load_sibling("atlas-handoff")
    # Same resolver every other coordinator/handoff command uses: refuses (exit 4) if the
    # task id is malformed or resolves to no ticket at all — before anything else runs.
    d = hoff.task_dir(task_id)

    # --- every check below runs before any lease/claim/handoff is written --------------------
    if not intent or not intent.strip():
        die("--intent is required — begin with no intent is not a workflow")
    intent = intent.strip()

    if not source_client or not source_client.strip():
        die("--source-client is required — begin never records an unspecified source")
    if not source_session or not source_session.strip():
        die("--source-session is required — begin never records an unspecified source")
    source_client = source_client.strip()
    source_session = source_session.strip()
    if not hoff.IDENTITY.fullmatch(source_client):
        die(f"not a client identifier: {source_client!r} — one token of [A-Za-z0-9._-]")
    if not hoff.IDENTITY.fullmatch(source_session):
        die(f"not a session identifier: {source_session!r} — one token of [A-Za-z0-9._-]")

    if not invocation or not str(invocation).strip():
        die("--invocation is required")
    if not idem_key or not str(idem_key).strip():
        die("--idempotency-key is required")

    coord = _coord()
    try:
        idem_key = coord.require_token(idem_key, "idempotency-key")
    except coord.CoordinationError as e:
        die(str(e), code=e.code)

    roles, intents = load_policy()
    if intent not in intents:
        die(f"unknown intent {intent!r} — one of: {', '.join(sorted(intents))}")
    role = intents[intent]
    if role not in roles:
        die(f"routing policy is malformed: intent {intent!r} names role {role!r}, which has "
            f"no entry in 'roles' — refusing rather than guessing a client")
    client = roles[role]

    gate = GATE_BY_INTENT.get(intent)
    if gate is None or gate not in hoff.GATES:
        die(f"policy mismatch: intent {intent!r} has no known gate mapping in this "
            f"coordinator's own GATE_BY_INTENT table — refusing rather than guessing a gate")

    scope = validate_scope(scope)

    spec, binary, unavailable = hoff.resolve_transport(client)
    if unavailable:
        die(f"cannot prepare a handoff to {client!r}: {unavailable}")

    if handoff_id is None:
        handoff_id = intent
    if not hoff.SAFE.fullmatch(handoff_id):
        die(f"not a handoff id: {handoff_id!r} — [A-Za-z0-9._-], one segment")

    # Idempotent replay, checked before the "handoff already exists" guard below and before
    # anything is acquired: a repeated identical idempotency key must return the exact
    # original result, even though the first call's own successful prepare has, by design,
    # already left a real handoff record on disk — which would otherwise make a legitimate
    # replay collide with the very next check ("record already exists") instead of ever
    # reaching it. The delegated `atlas handoff prepare` itself has no idempotency concept of
    # its own, so this check must run first, and it never touches lease_acquire, claim_acquire
    # or handoff prepare a second time once it finds a cached result.
    begin_target = f"{task_id}:{handoff_id}"
    try:
        with coord.ticket_guard(d):
            cached = coord.idempotency_check(d, idem_key, "coordinator_begin", begin_target)
    except coord.CoordinationError as e:
        die(str(e), code=e.code)
    if cached is not None:
        _print_begin(cached, replay=True)
        return 0

    existing = hoff.record_path(d, handoff_id)
    if existing.exists():
        die(f"handoff {handoff_id} already exists at {existing} for task {task_id} — begin "
            f"refuses to overwrite an existing handoff; approve it, or pass a different --id "
            f"for a new one", code=2)
    # -----------------------------------------------------------------------------------

    # A fresh per-attempt namespace for the underlying lease/claim idempotency keys, so a
    # retried begin call after a genuine failure (never cached above, since only a success
    # is stored) always acquires fresh coordination state rather than replaying a prior
    # attempt's now-released lease/claim.
    attempt = coord.uuid.uuid4().hex[:12]

    try:
        lease = coord.lease_acquire(d, task_id, source_client, source_session, invocation,
                                    ttl_seconds, _sub_key(idem_key, f"lease-{attempt}"))
    except coord.CoordinationError as e:
        die(str(e), code=e.code)  # lease acquisition itself failed: nothing was written

    try:
        claim = coord.claim_acquire(d, task_id, lease["lease_id"], scope, source_client,
                                    source_session, _sub_key(idem_key, f"claim-{attempt}"))
    except coord.CoordinationError as e:
        try:
            coord.lease_release(d, task_id, lease["lease_id"], source_client, source_session,
                                invocation, _sub_key(idem_key, f"lease-cleanup-{attempt}"))
        except coord.CoordinationError as e2:
            die(f"BLOCKED: file claim acquisition failed ({e}); the lease-release cleanup "
                f"ALSO failed ({e2}) — lease {lease['lease_id']} on task {task_id} remains "
                f"active and requires explicit owner inspection ('coordinator lease release' "
                f"or 'coordinator lease clear-stale')", code=5)
        die(f"file claim acquisition failed: {e} — the lease acquired for this attempt was "
            f"explicitly released; no coordination state remains", code=e.code)

    approval_command = (f"atlas handoff approve {task_id} {handoff_id} --gate {gate} --to "
                        f"{client} --scope {scope} --owner-words <text>")

    def _compensate_claim_and_lease(reason):
        errors = []
        try:
            coord.claim_release(d, task_id, lease["lease_id"], scope, source_client,
                                source_session, _sub_key(idem_key, f"claim-cleanup-{attempt}"))
        except coord.CoordinationError as ce:
            errors.append(f"claim release failed: {ce}")
        try:
            coord.lease_release(d, task_id, lease["lease_id"], source_client, source_session,
                                invocation, _sub_key(idem_key, f"lease-cleanup2-{attempt}"))
        except coord.CoordinationError as le:
            errors.append(f"lease release failed: {le}")
        if errors:
            die(f"BLOCKED: {reason}, and cleanup could not fully complete: "
                f"{'; '.join(errors)} — task {task_id} lease {lease['lease_id']} / claim "
                f"{claim['path']} require explicit owner inspection", code=5)

    # --- delegate: the one and only place a V6 handoff record is written is
    # `cli/atlas-handoff`'s own `cmd_prepare` — identical to `coordinator prepare`'s own
    # delegation above. Unlike `prepare`, a failure here must compensate the lease/claim
    # this call itself just acquired: `hoff.cmd_prepare` calls `die()`, which raises
    # `SystemExit` rather than returning a code, so that failure is caught here, compensated,
    # and only then re-raised unchanged. -------------------------------------------------
    prepare_args = [task_id, "--to", client, "--gate", gate, "--scope", scope,
                    "--id", handoff_id, "--status", "waiting-owner",
                    "--source-client", source_client, "--source-session", source_session]
    if summary:
        prepare_args += ["--summary", summary]
    try:
        rc = hoff.cmd_prepare(prepare_args)
    except SystemExit as e:
        _compensate_claim_and_lease(f"handoff prepare failed (exit {e.code})")
        raise
    if rc:
        _compensate_claim_and_lease(f"handoff prepare returned exit code {rc}")
        return rc
    # -----------------------------------------------------------------------------------

    result = {
        "task_id": task_id, "lease_id": lease["lease_id"], "claimed_path": claim["path"],
        "handoff_id": handoff_id, "destination": client, "gate": gate, "scope": scope,
        "approval_command": approval_command,
        "next_action": "owner runs the approval command above via the existing `atlas "
                       "handoff approve`; after that, `atlas coordinator dispatch` sends it, "
                       "the owner reviews the reply, and `atlas coordinator finalize` "
                       "releases the claim and lease",
    }
    with coord.ticket_guard(d):
        coord.idempotency_store(d, idem_key, "coordinator_begin", begin_target, result)

    _print_begin(result, replay=False)
    return 0


def _print_finalize(result, replay=False):
    print(f"\n  {B}finalize{X}  {result['task_id']} / {result['handoff_id']}")
    print(f"  released claim:        {result['released_claim'] or 'n/a'}")
    print(f"  released lease:        {result['released_lease']}")
    print(f"  cost status:           {result['cost_status']}")
    print(f"  reduction signal:      {result['reduction_signal']}")
    if replay:
        print(f"  {D}(duplicate idempotency key — original finalize result returned, no "
              f"second release was performed){X}")
    print(f"  {D}finalize only: no ticket completion performed, no next hop selected — "
          f"nothing approved, sent, dispatched or received here{X}\n")


def cmd_finalize(args):
    if len(args) < 2 or args[0].startswith("-") or args[1].startswith("-"):
        die("usage: atlas coordinator finalize <task-id> <handoff-id> --lease-id <lease-id> "
            "--client <client-id> --session <session-id> --invocation <invocation-id> "
            "--idempotency-key <key>")
    task_id, handoff_id, flag_args = args[0], args[1], args[2:]
    v = _parse_flags(flag_args, ("--lease-id", "--client", "--session", "--invocation",
                                 "--idempotency-key"), "finalize")
    lease_id, client, session = v.get("--lease-id"), v.get("--client"), v.get("--session")
    invocation, idem_key = v.get("--invocation"), v.get("--idempotency-key")
    for name, val in (("--lease-id", lease_id), ("--client", client), ("--session", session),
                      ("--invocation", invocation), ("--idempotency-key", idem_key)):
        if not val or not str(val).strip():
            die(f"{name} is required")

    coord = _coord()
    try:
        idem_key = coord.require_token(idem_key, "idempotency-key")
    except coord.CoordinationError as e:
        die(str(e), code=e.code)

    hoff = _load_sibling("atlas-handoff")
    d = hoff.task_dir(task_id)
    # `load_record` itself fails closed: exit 4 for a missing/unknown handoff id, and a
    # refusal for a handoff_id mismatch between the filename and the record's own field —
    # the same "match task id and handoff id" requirement finalize needs, reused rather than
    # re-checked.
    p, text, meta = hoff.load_record(d, handoff_id)

    if meta.get("task_id") not in (None, task_id):
        die(f"handoff {handoff_id} belongs to task {meta.get('task_id')!r}, not {task_id!r} "
            f"— finalize refused")

    # --- the one status gate this command enforces, identical wording to `review`'s own ----
    status = meta.get("status")
    if status not in ("returned", "reviewed"):
        die(f"handoff {handoff_id} is {status!r}; finalize requires 'returned' or 'reviewed' "
            f"— the existing `atlas handoff receive` is what gets it there. finalize never "
            f"receives, approves, sends or dispatches, and has no code path that could move "
            f"a handoff to that state itself.")

    # Idempotent replay, checked before any lease/claim state is touched.
    target = f"{task_id}:{handoff_id}:{lease_id}"
    try:
        with coord.ticket_guard(d):
            cached = coord.idempotency_check(d, idem_key, "coordinator_finalize", target)
    except coord.CoordinationError as e:
        die(str(e), code=e.code)
    if cached is not None:
        _print_finalize(cached, replay=True)
        return 0

    # --- validation only below this line. Nothing is released until every one of these
    # --- checks passes; a failure here releases nothing and leaves the lease/claim exactly
    # --- as they were. Reuses the exact same read-only lease/claim verification `coordinator
    # --- dispatch` already applies (`verify_dispatch_conflict_protection`), plus the
    # --- explicit invocation match this command additionally requires. --------------------
    try:
        _, lease = coord._load_active_lease_or_die(d, task_id)
        if lease.get("lease_id") != lease_id:
            coord.refuse(f"--lease-id {lease_id!r} does not match the active lease "
                        f"{lease.get('lease_id')!r} on task {task_id} — finalize refused")
        if lease.get("client_id") != client or lease.get("session_id") != session:
            coord.refuse(f"the active lease on task {task_id} is held by "
                        f"{lease.get('client_id')}/{lease.get('session_id')}, not "
                        f"{client}/{session} — finalize refused")
        if lease.get("invocation_id") != invocation:
            coord.refuse(f"the active lease on task {task_id} was acquired under invocation "
                        f"{lease.get('invocation_id')!r}, not {invocation!r} — finalize "
                        f"refused")
        coord.verify_dispatch_conflict_protection(d, task_id, meta.get("scope"), lease_id,
                                                  client, session)
        scope_paths = coord.resolve_scope_paths(meta.get("scope"))
    except coord.CoordinationError as e:
        die(str(e), code=e.code)
    # -----------------------------------------------------------------------------------

    # --- read-only review, exactly as `coordinator review` runs it, plus the per-handoff
    # --- cost status/reduction signal exactly as `coordinator cost` computes it. Neither
    # --- writes anything, changes any status, or picks a next hop. ------------------------
    review = _build_review_report(task_id, handoff_id, text, meta, hoff)
    _print_review_report(review)
    cost = _build_cost_report(task_id, handoff_id, text, meta, hoff)
    print(f"  cost status:            {cost['cost_status']}")
    print(f"  reduction signal:       {cost['reduction_signal']}\n")
    # -----------------------------------------------------------------------------------

    # --- release: claim(s) first, then the lease, exactly in that order. A failure at
    # --- either step releases nothing further and is reported BLOCKED, naming exactly what
    # --- remains — never retried automatically. ------------------------------------------
    released_claims = []
    for raw_path in scope_paths:
        try:
            rel = coord.claim_release(d, task_id, lease_id, raw_path, client, session,
                                      _sub_key(idem_key, f"claim-release-{raw_path}"))
        except coord.CoordinationError as e:
            die(f"BLOCKED: claim release failed for {raw_path!r}: {e} — lease {lease_id} "
                f"and this claim remain active; no retry performed automatically", code=5)
        released_claims.append(rel)

    try:
        coord.lease_release(d, task_id, lease_id, client, session, invocation,
                            _sub_key(idem_key, "lease-release"))
    except coord.CoordinationError as e:
        die(f"BLOCKED: claim release succeeded but lease release failed: {e} — lease "
            f"{lease_id} remains and must be released explicitly", code=5)

    for rel in released_claims:
        obj, corrupt = coord._read_json(coord._claim_path(rel["path"]))
        if corrupt or obj is None or obj.get("state") not in ("released", "cleared"):
            die(f"BLOCKED: lease release succeeded but claim {rel['path']} did not end up "
                f"released — requires explicit owner inspection", code=5)
    # -----------------------------------------------------------------------------------

    result = {
        "task_id": task_id, "handoff_id": handoff_id,
        "released_claim": ", ".join(r["path"] for r in released_claims) or None,
        "released_lease": lease_id,
        "cost_status": cost["cost_status"], "reduction_signal": cost["reduction_signal"],
    }
    with coord.ticket_guard(d):
        coord.idempotency_store(d, idem_key, "coordinator_finalize", target, result)

    _print_finalize(result, replay=False)
    return 0


CMDS = {"route": cmd_route, "prepare": cmd_prepare, "dispatch": cmd_dispatch,
        "review": cmd_review, "cost": cmd_cost, "lease": cmd_lease, "claim": cmd_claim,
        "transition": cmd_transition, "begin": cmd_begin, "finalize": cmd_finalize,
        "apply": cmd_apply}

if __name__ == "__main__":
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__)
        sys.exit(0 if a else 2)
    if a[0] not in CMDS:
        print(f"  atlas coordinator: unknown command {a[0]!r}", file=sys.stderr)
        print(__doc__, file=sys.stderr)
        sys.exit(2)
    sys.exit(CMDS[a[0]](a[1:]))
