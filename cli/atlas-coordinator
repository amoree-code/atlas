# --- T-103: revision-checked result application -------------------------------------------
def cmd_apply(args):
    """The one enforcement entry point T-103 adds: `coord.apply_result` — an active,
    matching claim (the same check `dispatch`/`finalize` already require) plus a fresh
    base revision, both checked before anything is written, and the claim always released
    afterward. `--content` is written to `--path` verbatim; this command performs no other
    kind of write."""
    if not args or args[0].startswith("-"):
        die("usage: atlas coordinator apply <task-id> --path <relative-path> --lease-id "
            "<lease-id> --client <client-id> --session <session-id> --base-revision "
            "<sha256-hex, or 64 zeros for 'no prior content'> --content <text> "
            "--idempotency-key <key>")
    task_id, flag_args = args[0], args[1:]
    v = _parse_flags(flag_args, ("--path", "--lease-id", "--client", "--session",
                                 "--base-revision", "--content", "--idempotency-key"),
                     "apply")
    if v.get("--content") is None:
        die("--content is required — apply writes exactly this text to the claimed path, "
            "nothing is inferred")
    hoff = _load_sibling("atlas-handoff")
    d = hoff.task_dir(task_id)
    content = v.get("--content")
    coord_for_write = _coord()

    def do_apply():
        canonical = coord_for_write.canonicalize_path(v.get("--path"))
        coord_for_write.atomic_text_write(canonical, content)
        return {"bytes_written": len(content.encode())}

    coord, result = _coord_call(lambda c: c.apply_result(
        d, task_id, v.get("--lease-id"), v.get("--path"), v.get("--client"),
        v.get("--session"), v.get("--base-revision"), do_apply, v.get("--idempotency-key")))
    _print_kv("apply", task_id, result.get("path"), result,
             [("base revision:", "base_revision"), ("new revision:", "new_revision")])
    return 0


