#!/usr/bin/env bash
# atlas-status — one screen, read-only. Where the three layers are, and whether the
# contract between them is holding. Never mutates anything.
set -uo pipefail

ATLAS_HOME="${ATLAS_HOME:-${ATLAS_HOME:-$HOME/atlas}}"
ATLAS_RUNTIME="${ATLAS_RUNTIME:-$HOME/.ai}"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(dirname "$SELF_DIR")"
VERSION="$(cat "$REPO/VERSION" 2>/dev/null || echo unknown)"

if [ -t 1 ]; then G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; B=$'\033[34m'; D=$'\033[2m'; X=$'\033[0m'
else G=; Y=; R=; B=; D=; X=; fi
row() { printf '  %-12s %s\n' "$1" "$2"; }

printf '\n%sAtlas%s  %sv%s%s\n\n' "$B" "$X" "$D" "$VERSION" "$X"

row "public"  "$REPO  ${D}(software)${X}"
row "runtime" "$ATLAS_RUNTIME  ${D}(execution — implementation detail of V0.x)${X}"
row "private" "$ATLAS_HOME  ${D}(your data)${X}"

# T-046: $ATLAS_HOME itself no longer has to exist — its roots may live under $ATLAS_HOME.
ATLAS_HOME_DEFAULT="${ATLAS_HOME:-$HOME/atlas}"
if [ ! -d "$ATLAS_HOME" ] && [ ! -d "$ATLAS_HOME_DEFAULT/personal" ]; then
  printf '\n  %sno workspace%s — run: atlas init\n\n' "$Y" "$X"; exit 1
fi

# "Initialized" is a fact this tool asks for rather than infers. The directory existing
# only proves `atlas init` ran; it says nothing about whether the workspace knows who the
# user is. atlas-onboard owns that answer, and its exit code carries it.
printf '\n%ssetup%s\n' "$B" "$X"
if [ -x "$SELF_DIR/atlas-onboard" ]; then
  ob=$("$SELF_DIR/atlas-onboard" status 2>&1); obrc=$?
  case "$obrc" in
    0)  row "onboarding" "$(printf '%s' "$ob" | head -n1)" ;;
    10) row "onboarding" "${Y}not started${X} — run: atlas onboard" ;;
    11) row "onboarding" "${Y}incomplete${X} — resume: atlas onboard" ;;
    12) row "onboarding" "${R}inconsistent${X} — atlas onboard status" ;;
    *)  row "onboarding" "${Y}unknown${X}" ;;
  esac
else
  row "onboarding" "${Y}unknown${X} — atlas-onboard not found"
fi

# Private roots may sit in either layout while compatibility remains. Sourcing the
# resolver sets ATLAS_PATH_*/ATLAS_LAYOUT_* directly — the answers never become text, so
# a workspace path containing a space cannot come back as a command to run. A root with
# no single answer comes back with a layout and no path.
. "$SELF_DIR/atlas-paths"
atlas_paths_export

printf '\n%sworkspace%s\n' "$B" "$X"
for s in "memory:${ATLAS_PATH_MEMORY:-}" "knowledge:${ATLAS_PATH_KNOWLEDGE:-}" \
         "projects:${ATLAS_PATH_PROJECTS:-}" "sessions:${ATLAS_PATH_SESSIONS:-}" \
         "daily:${ATLAS_PATH_DAILY:-}" "skills:${ATLAS_PATH_SKILLS:-}"; do
  label="${s%%:*}"; d="${s#*:}"
  # Count through the directory, not at it. Some sections are reachable by a compatibility
  # symlink while a move settles, and `find` stops at a symlink instead of descending —
  # which would report an empty section as 0 files rather than as where it actually is.
  [ -d "$d" ] && d="$(cd "$d" && pwd -P)"
  if [ -z "$d" ]; then printf '  %-12s %sconflict%s — atlas-paths check\n' "$label" "$R" "$X"
  elif [ -d "$d" ]; then printf '  %-12s %s files\n' "$label" "$(find "$d" -type f -not -path '*/.git/*' | wc -l | tr -d ' ')"
  else printf '  %-12s %smissing%s\n' "$label" "$R" "$X"
  fi
done
# Layout is reported only while it is still interesting: a workspace entirely on the old
# layout is the normal case today and does not need a line about it.
moved=""
for r in memory knowledge projects work rules runtime \
         config policies daily templates skills agents helpers schemas professional inbox sessions; do
  v="ATLAS_LAYOUT_$(printf '%s' "$r" | tr 'a-z' 'A-Z')"; l="${!v:-old}"
  [ "$l" = "old" ] || moved="${moved}${moved:+ }$r=$l"
done
[ -n "$moved" ] && row "layout" "$moved  ${D}— atlas-paths list${X}"

printf '\n%sgit safety%s\n' "$B" "$X"
if [ -d "$ATLAS_HOME/.git" ]; then
  if [ -n "$(git -C "$ATLAS_HOME" remote -v 2>/dev/null)" ]; then
    row "private" "${R}REMOTE CONFIGURED${X} — the workspace must be local-only"
  else
    row "private" "${G}local-only${X}, $(git -C "$ATLAS_HOME" rev-list --count HEAD 2>/dev/null || echo 0) snapshot(s)$(
      [ -n "$(git -C "$ATLAS_HOME" status --porcelain 2>/dev/null)" ] && printf ', %suncommitted changes%s' "$Y" "$X")"
  fi
else
  row "private" "${Y}not versioned${X}"
fi
if [ -d "$REPO/.git" ]; then
  pr=$(git -C "$REPO" remote get-url origin 2>/dev/null || echo "no remote")
  row "public" "$(git -C "$REPO" rev-list --count HEAD 2>/dev/null || echo 0) commit(s), $pr"
fi

printf '\n%smemory%s\n' "$B" "$X"
if [ -n "${ATLAS_PATH_MEMORY:-}" ] && [ -d "$ATLAS_PATH_MEMORY" ]; then
  links=$(find "$HOME/.claude/projects" -maxdepth 2 -name memory -type l 2>/dev/null | wc -l | tr -d ' ')
  row "store" "$(find "$ATLAS_PATH_MEMORY" -name '*.md' | wc -l | tr -d ' ') files, $(find "$ATLAS_PATH_MEMORY" -maxdepth 1 -mindepth 1 -type d | wc -l | tr -d ' ') sections"
  row "access" "$links client link(s) -> the canonical store  ${D}(access, not ownership)${X}"
  cf="$ATLAS_PATH_MEMORY/CONFLICTS.md"
  [ -f "$cf" ] && n=$(grep -c '^### ' "$cf" 2>/dev/null || echo 0) && [ "${n:-0}" -gt 0 ] \
    && row "conflicts" "${Y}$n unresolved${X} — see memory/CONFLICTS.md"
fi
row "knowledge" "$(find "${ATLAS_PATH_KNOWLEDGE:-/nonexistent}" -name '*.md' 2>/dev/null | wc -l | tr -d ' ') entries across $(find "${ATLAS_PATH_KNOWLEDGE:-/nonexistent}" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l | tr -d ' ') kinds"

printf '\n%sskills%s\n' "$B" "$X"
row "public" "$(find "$REPO/extensions/skills" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
row "yours" "$(find "${ATLAS_PATH_SKILLS:-$ATLAS_HOME/internal/extensions/skills}" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')  ${D}(yours win on a name collision)${X}"

printf '\n%sadapter%s\n' "$B" "$X"
adapter=$(grep -m1 '^active_adapter:' "${ATLAS_PATH_CONFIG:-$ATLAS_HOME/internal/config}/settings.yaml" 2>/dev/null | cut -d: -f2 | tr -d ' ')
row "active" "${adapter:-claude-code ${D}(default)${X}}"
provider_file="$ATLAS_HOME/internal/config/providers.json"
if [ -f "$provider_file" ]; then
  primary=$(grep -m1 '"primary_provider"' "$provider_file" | sed 's/.*: *"\([^"]*\)".*/\1/')
  selected=$(grep -c '"id"' "$provider_file" 2>/dev/null || true)
  row "providers" "${primary:-other}, ${selected:-0} configured"
fi

printf '\n%shealth%s\n' "$B" "$X"
if [ -x "$SELF_DIR/atlas-doctor" ]; then
  out=$("$SELF_DIR/atlas-doctor" --quiet 2>&1); rc=$?
  w=$(printf '%s' "$out" | grep -c 'WARN' || true)
  if [ "$rc" -eq 0 ] && [ "${w:-0}" -eq 0 ]; then row "contract" "${G}clean${X}"
  elif [ "$rc" -eq 0 ];                        then row "contract" "${G}holds${X}, ${Y}$w warning(s)${X}  ${D}— atlas doctor${X}"
  else                                              row "contract" "${R}$rc problem(s)${X}, ${Y}$w warning(s)${X}  ${D}— atlas doctor${X}"
  fi
else
  row "contract" "${Y}unknown${X} — atlas-doctor not found"
fi
printf '\n'
