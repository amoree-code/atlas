#!/usr/bin/env bash
# ai-os — T-031 (Phase H, Slice 2) compatibility alias for `atlas`, the canonical CLI name.
# Kept for the deprecation window (migration-plan.md §Compatibility shims, row "`ai-os`
# binary name"): both names must resolve identically, so this execs the same file `atlas`
# does, with the same arguments, from the same directory. Not removed by this ticket —
# removal is a later, separately-approved slice (Phase I3) once every adapter manifest,
# doc and script references only `atlas` and a deprecation window has passed.
set -euo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# T-050-S1: `coordinator` is dispatched directly from this alias rather than added to
# `atlas`'s own case statement — `atlas` is the canonical CLI and out of this ticket's
# approved write paths, so a new subcommand that must "work through engine/cli/ai-os"
# is wired here instead, alongside it, not inside it. Every other command is untouched
# and still resolves through `atlas` exactly as before.
if [ "${1:-}" = "coordinator" ]; then
  shift
  exec "$SELF_DIR/ai-os-coordinator" "$@"
fi
exec "$SELF_DIR/atlas" "$@"
