#!/usr/bin/env python3
"""ai-os-handoff — task-bound agent handoff records.

  ai-os handoff prepare <task-id> --to <client> --gate <gate> --scope <scope>
                        [--summary <text>] [--status draft|waiting-owner] [--id <handoff-id>]
  ai-os handoff approve <task-id> <handoff-id> --gate <gate> --to <client> --scope <scope>
                        --owner-words <text>
  ai-os handoff send <task-id> <handoff-id> [--dry-run]
  ai-os handoff receive <task-id> <handoff-id> --from <client> --file <path>
                        [--status returned|reviewed]
  ai-os handoff show <task-id> <handoff-id>
  ai-os handoff list <task-id>

A handoff record is a **written record and nothing more** — the same thing the canonical
template describes, produced by a command instead of by hand so that the metadata is
consistent and the record lands beside the task it belongs to. It is:

  not hidden agent-to-agent messaging   nothing is sent; nothing leaves this machine
  not a workflow engine                 it sequences nothing
  not an agent runtime                  it runs, schedules and dispatches nothing
  not orchestration                     it assigns and triggers no agent

Records are flat Markdown files beside the durable task:

  $AI_OS_HOME/tasks/<ID>/handoff-<handoff_id>.md

There is no global handoff directory, no index, no queue, no bus, no daemon state and no
background worker. `list` finds records by globbing that one directory, so what you can
see in the task folder is the whole of what exists.

## Sending

`send` is the only command that reaches outside this file, and it is fenced on every side:

  - it sends only what the owner approved, for the exact handoff id, gate, destination and
    scope recorded by `approve` — a mismatch on any one of them is a refusal;
  - it never writes an approval, and nothing in it can create one;
  - the transport is not invented here. It is declared in
    `governance/policies/handoff-transports.yaml`, must be marked `verified: true`, must pin the
    client's own read-only mode, and takes the packet on stdin — never in argv;
  - the call is a single foreground subprocess with a timeout. No shell, no retry, no
    polling, no backoff, no background, no daemon, no MCP and no connector;
  - the destination's reply is never captured, read or stored by this file. It goes
    straight to the terminal the owner is watching. Attaching a reply is `receive`, V5.

If no verified transport exists for the destination, `send` refuses and records a **blocker**
in the record instead of pretending that printing or copying was a send. The approval stays
valid, so enabling a transport later needs no second approval.

## Receiving

`receive` attaches a reply to the handoff that was sent, and stops:

  - it reads a file the owner can open — it never captures a client's output itself, and
    never invents the text it attaches;
  - the reply is stored verbatim, between markers, and is never read, interpreted,
    summarised or acted on by this file;
  - it accepts a reply only from the client the packet actually went to, only once, and
    only for a handoff whose status is `sent`;
  - it moves `sent` to `returned` or `reviewed`. It cannot write `approved`, `sent` or
    `closed`, and there is no code path here that could;
  - it leaves `next_holder` at `undecided`. Choosing the next hop is a new handoff, with
    its own approval — the loop comes back to the owner and waits.

## Refusals — each writes nothing and exits non-zero

  task id missing or not a safe single path segment
  task directory does not exist under $AI_OS_HOME/tasks/
  --to missing, unknown, or naming more than one destination
  --gate missing or outside the template's gate vocabulary
  --scope missing or empty
  --status outside {draft, waiting-owner}
  --id already used by an existing record in that task
  the outgoing packet carries a credential-shaped value
  receive only — the record's status is not `sent`; a returned block is already
  attached; `--from` is missing, unknown, plural, or is not the client the packet went to;
  `--file` is missing, absent, empty, larger than the cap, or contains the block markers

  send only — the record is already sent; status is not `approved`; approval is not
  `recorded`; any of approved_at / approved_gate / approved_to / approved_scope /
  owner_words is empty; the approved gate, destination or scope differs from the record's
  own; the record names no destination or more than one; the destination is not a known
  client; the outgoing packet is missing or empty

Exit: 0 ok · 2 usage or refusal · 4 not found ·
5 blocked, no verified transport · 7 the transport itself failed.
Zero non-stdlib dependencies.
"""
import hashlib, json, os, re, shutil, subprocess, sys, time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
AI_OS_HOME = Path(os.environ.get("AI_OS_HOME", Path.home() / ".ai-os"))
sys.path.insert(0, str(REPO / "cli"))
from aios_paths import private_path_or_die  # noqa: E402

# Task records are moving into per-project work, where there is no single root any more.
# Until a handoff learns that lookup it refuses rather than writing to a stale tasks/.
TASKS = private_path_or_die("work")
ADAPTERS = Path(os.environ.get("AI_OS_ADAPTERS", REPO / "adapters"))
# Declared transports, exactly as adapters/ and capabilities/ are declared: a registry
# file in the public repo, overridable for tests, never synthesised at runtime.
TRANSPORTS = Path(os.environ.get("AI_OS_HANDOFF_TRANSPORTS",
                                 REPO / "governance" / "policies" / "handoff-transports.yaml"))

# The canonical written form. Read for reference by a human, never parsed by this file —
# the packet below mirrors its sections, and the private copy is where the full rules live.
TEMPLATE_REF = "$AI_OS_HOME/system/templates/agent-handoff.md"

# The template's gate vocabulary, verbatim. A gate has to be a closed set: a later approval
# is valid only for one exact gate, and "exact" means nothing against free text.
GATES = ("plan-scope", "execute", "review", "next-step", "remote-or-destructive", "resume")

# The outgoing packet is delimited, so what gets hashed and sent is exactly what a reader
# sees in the record — not a re-render that could drift from it.
PACKET_BEGIN, PACKET_END = "<!-- packet:begin -->", "<!-- packet:end -->"

# A reply is quoted inside the record, so it needs its own boundary — and a reply that
# contains that boundary is refused rather than allowed to forge one.
RETURNED_BEGIN, RETURNED_END = "<!-- returned:begin -->", "<!-- returned:end -->"

# The two statuses receive may write. `approved`, `sent` and `closed` are absent on purpose:
# receiving a reply is not approval, is not a send, and does not finish anything.
RECEIVE_STATUSES = ("returned", "reviewed")

# A returned block is read by a person inside a record. Past this, the file belongs beside
# the task and the record should reference it instead of swallowing it.
MAX_RETURNED_BYTES = 262144

# The only two statuses prepare may write. approve is the only V3 transition and can move
# waiting-owner -> approved. sent/returned/reviewed/blocked/stopped/closed belong later.
STATUSES = ("draft", "waiting-owner")

# A single path segment, no traversal, no separators. Used for both the task id and the
# handoff id because both become part of a filesystem path.
SAFE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}\Z")

# Credential shapes, kept deliberately narrow — the same families ai-os-privacy-scan treats
# as unrecoverable. A handoff packet is a durable file; a secret must never reach one.
CREDENTIAL = [
    ("private key block",   re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH |PGP |DSA )?PRIVATE KEY-----")),
    ("AWS access key id",   re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b")),
    ("GitHub token",        re.compile(r"\b(?:gh[pousr]_[A-Za-z0-9]{16,}|github_pat_[A-Za-z0-9_]{20,})")),
    ("Slack token",         re.compile(r"\bxox[abposr]-[A-Za-z0-9-]{10,}")),
    ("Anthropic API key",   re.compile(r"\bsk-ant-[A-Za-z0-9_\-]{20,}")),
    ("OpenAI API key",      re.compile(r"\bsk-(?:proj-)?[A-Za-z0-9]{32,}")),
    ("Google API key",      re.compile(r"\bAIza[0-9A-Za-z_\-]{35}\b")),
    ("connection string with password",
        re.compile(r"\b(?:postgres(?:ql)?|mysql|mongodb(?:\+srv)?|redis|amqp)://[^\s:@/]+:[^\s:@/]+@")),
    ("assigned secret literal",
        re.compile(r"(?i)\b(?:api[_\-]?key|secret[_\-]?key|access[_\-]?token|auth[_\-]?token"
                   r"|client[_\-]?secret|password|passwd)\b\s*[:=]\s*[\"'][^\"'\s]{12,}[\"']")),
]

G, Y, R, B, D, X = "\033[32m", "\033[33m", "\033[31m", "\033[34m", "\033[2m", "\033[0m"
if not sys.stdout.isatty():
    G = Y = R = B = D = X = ""


def die(msg, code=2):
    print(f"  {R}refused{X} {msg}", file=sys.stderr)
    sys.exit(code)


def yv(s):
    """One frontmatter value. Quoted only when a bare scalar would be ambiguous.

    `ensure_ascii=False` matters: the owner's own words go through here, and an owner who
    writes in Arabic must be able to read back what he wrote. A record whose approval line
    says `\u0648\u0627...` is not a record a person can inspect, which is the one thing
    every handoff record is for. The escaped form is still valid YAML — it is just useless
    to the only reader that counts."""
    s = str(s)
    if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9 ._\-/:,+()]*", s) and not s.endswith(" "):
        return s
    return json.dumps(s, ensure_ascii=False)


def known_clients():
    if not ADAPTERS.is_dir():
        return []
    return sorted(d.name for d in ADAPTERS.iterdir()
                  if d.is_dir() and (d / "adapter.yaml").is_file())


def task_dir(task_id):
    if not task_id:
        die("a task id is required: ai-os handoff prepare <task-id> ...")
    if not SAFE.fullmatch(task_id):
        die(f"not a task id: {task_id!r} — one path segment of [A-Za-z0-9._-], nothing else")
    d = TASKS / task_id
    if not d.is_dir():
        die(f"no task directory at {d} — a handoff is bound to a task that already exists", code=4)
    return d


def task_field(d, key):
    """One frontmatter value from the task's own record, or '-' if it says nothing."""
    f = d / "task.md"
    if not f.is_file():
        return "-"
    try:
        text = f.read_text(errors="replace")
    except OSError:
        return "-"
    if not text.startswith("---"):
        return "-"
    head = text.split("---", 2)[1] if text.count("---") >= 2 else ""
    for line in head.splitlines():
        k, sep, v = line.partition(":")
        if sep and k.strip() == key and v.strip():
            return v.strip()
    return "-"


def scan_credentials(*texts):
    for text in texts:
        for label, rx in CREDENTIAL:
            if rx.search(text or ""):
                die(f"the outgoing packet carries a {label}. Nothing was written. "
                    f"A handoff record is durable — report key names only, never values.")


def records(d):
    return sorted(d.glob("handoff-*.md"))


def record_path(d, handoff_id):
    return d / f"handoff-{handoff_id}.md"


def load_record(d, handoff_id):
    if not SAFE.fullmatch(handoff_id or ""):
        die(f"not a handoff id: {handoff_id!r}")
    p = record_path(d, handoff_id)
    if not p.is_file():
        die(f"no such handoff: {p}", code=4)
    text = p.read_text(errors="replace")
    meta = parse_frontmatter(text)
    if meta.get("handoff_id") not in (None, handoff_id):
        die(f"handoff id mismatch: file is {handoff_id!r}, record says {meta.get('handoff_id')!r}")
    return p, text, meta


def parse_frontmatter(text):
    if not text.startswith("---\n"):
        return {}
    try:
        head = text.split("---", 2)[1]
    except IndexError:
        return {}
    meta = {}
    for line in head.splitlines():
        k, sep, v = line.partition(":")
        if not sep:
            continue
        val = v.strip()
        if val.startswith('"'):
            try:
                val = json.loads(val)
            except json.JSONDecodeError:
                val = val.strip('"')
        meta[k.strip()] = val
    return meta


def replace_frontmatter(text, updates, add_order=()):
    if not text.startswith("---\n"):
        die("handoff record has no frontmatter; refusing to update it")
    head, body = text.split("---", 2)[1:]
    seen = set()
    lines = []
    for line in head.splitlines():
        k, sep, _v = line.partition(":")
        key = k.strip()
        if sep and key in updates:
            lines.append(f"{key}: {yv(updates[key])}")
            seen.add(key)
        else:
            lines.append(line)
    for key in add_order:
        if key in updates and key not in seen:
            lines.append(f"{key}: {yv(updates[key])}")
            seen.add(key)
    return "---\n" + "\n".join(lines).strip() + "\n---" + body


def replace_section(text, heading, new_body):
    marker = f"\n{heading}\n"
    start = text.find(marker)
    if start < 0:
        die(f"handoff record is missing {heading!r}; refusing to update it")
    body_start = start + len(marker)
    next_heading = text.find("\n## ", body_start)
    if next_heading < 0:
        return text[:body_start] + "\n" + new_body.rstrip() + "\n"
    return text[:body_start] + "\n" + new_body.rstrip() + "\n" + text[next_heading:]


def next_id(d):
    stamp = time.strftime("%Y%m%d")
    used = {p.stem[len("handoff-"):] for p in records(d)}
    for n in range(1, 1000):
        candidate = f"{stamp}-{n:03d}"
        if candidate not in used:
            return candidate
    die(f"999 handoff records already exist for {stamp} — name one explicitly with --id")


def argv_shown(parts):
    """One readable command line. Empty and spaced arguments are quoted so a reader can
    see them — an invisible argument in an audit record is a missing argument."""
    return " ".join(a if a and not re.search(r"\s", a) else json.dumps(a) for a in parts)


def extract_packet(text, p):
    """The exact bytes between the packet markers. Never re-rendered, never reformatted."""
    start, end = text.find(PACKET_BEGIN), text.find(PACKET_END)
    if start < 0 or end < 0 or end <= start:
        die(f"handoff record has no outgoing packet between the markers: {p}")
    packet = text[start + len(PACKET_BEGIN):end].strip()
    if not packet:
        die(f"the outgoing packet in {p} is empty; there is nothing to send")
    return packet


def load_transports():
    """The declared transport registry, parsed with the repo's one manifest parser.

    Loaded lazily: prepare, approve, show and list have no transport and must not acquire
    a dependency on one."""
    if not TRANSPORTS.is_file():
        return {}
    import importlib.machinery, importlib.util
    src = Path(__file__).resolve().parent / "ai-os-adapter"
    if not src.exists():
        die("cli/ai-os-adapter is missing; it owns the manifest parser")
    spec = importlib.util.spec_from_loader(
        "_ai_os_adapter", importlib.machinery.SourceFileLoader("_ai_os_adapter", str(src)))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    try:
        doc = mod.parse(TRANSPORTS.read_text(errors="replace"), str(TRANSPORTS))
    except mod.ManifestError as e:
        die(f"transport registry will not parse: {e}")
    got = doc.get("transports")
    return got if isinstance(got, dict) else {}


def resolve_transport(client):
    """(spec, binary_path, unavailable_reason). Never raises and never sends.

    Every path that ends without a binary returns a reason instead, because a refused send
    has to be able to say in the record exactly why it refused."""
    spec = load_transports().get(client)
    if not spec:
        return None, None, f"no transport is declared for {client!r} in {TRANSPORTS}"
    if not isinstance(spec, dict):
        return None, None, f"the {client!r} transport entry is malformed in {TRANSPORTS}"
    if spec.get("verified") is not True:
        return spec, None, (f"the {client!r} transport is declared but not verified — "
                            f"verified: false in {TRANSPORTS}")
    argv = spec.get("argv")
    if not isinstance(argv, list) or not all(isinstance(a, str) for a in argv):
        return spec, None, f"the {client!r} transport has no argv list of strings"
    binary = spec.get("binary")
    if not isinstance(binary, str) or not binary or re.search(r"[\s;|&$<>]", binary):
        return spec, None, f"the {client!r} transport names no plain binary"
    found = shutil.which(binary)
    if not found:
        return spec, None, f"the {client!r} transport needs {binary!r}, which is not on PATH"
    return spec, found, None


def set_fenced_lines(text, heading, updates, append_missing=True):
    """Replace `key:` lines inside the fenced block under `heading`.

    Line surgery rather than a rewrite: these blocks accumulate across versions — prepare
    wrote most of the audit, approve rewrote one line of it — and replacing a block
    wholesale would erase what an earlier command recorded."""
    marker = f"\n{heading}\n"
    start = text.find(marker)
    if start < 0:
        die(f"handoff record is missing {heading!r}; refusing to update it")
    opened = text.find("```", start + len(marker))
    closed = text.find("```", opened + 3) if opened >= 0 else -1
    if opened < 0 or closed < 0:
        die(f"{heading!r} has no fenced block; refusing to update it")
    lines, seen = text[opened + 3:closed].splitlines(), set()
    # Match the column the block already aligns its values on, rather than imposing one —
    # a rewritten line that no longer lines up reads as damage to a record a person reads.
    cols = []
    for line in lines:
        k, sep, v = line.partition(":")
        if sep and k.strip() and not k.startswith(" ") and v.strip():
            cols.append(len(k) + 1 + (len(v) - len(v.lstrip())))
    # The column most lines already use — a block can be slightly ragged, and the
    # majority is what a reader perceives as its alignment.
    col = max(set(cols), key=cols.count) if cols else 19
    fmt = lambda key, val: f"{key}:{' ' * max(1, col - len(key) - 1)}{val}"
    for idx, line in enumerate(lines):
        k, sep, _v = line.partition(":")
        key = k.strip()
        if sep and key in updates and key not in seen:
            lines[idx] = fmt(key, updates[key])
            seen.add(key)
    for key, val in updates.items():
        if key not in seen and append_missing:
            lines.append(fmt(key, val))
    while lines and not lines[0].strip():
        lines.pop(0)
    while lines and not lines[-1].strip():
        lines.pop()
    return text[:opened + 3] + "\n" + "\n".join(lines) + "\n" + text[closed:]


def set_audit_lines(text, updates):
    return set_fenced_lines(text, "## 6. Audit", updates)


def sync_metadata_block(text, meta):
    """Re-state section 1 from the frontmatter, for the keys section 1 already shows.

    Section 1 exists so a person can read the record's state without parsing frontmatter.
    Any command that changes state has to keep it true, or the record contradicts itself.
    Nothing is added: a key section 1 does not already carry is not invented here."""
    shown = ("status", "current_holder", "next_holder", "owner_action_required")
    return set_fenced_lines(text, "## 1. Handoff metadata",
                            {k: meta[k] for k in shown if k in meta},
                            append_missing=False)


# ---------------------------------------------------------------------------------------
def render(*, handoff_id, task_id, status, created, to, gate, scope, summary, project, title,
           argv_shown):
    owner_action = "approve" if status == "waiting-owner" else "none"
    summary_text = summary or "none — no summary was given at prepare time"
    return f"""---
handoff_id: {yv(handoff_id)}
task_id: {yv(task_id)}
status: {yv(status)}
created: {yv(created)}
to: {yv(to)}
gate: {yv(gate)}
scope: {yv(scope)}
current_holder: owner
next_holder: {yv(to)}
owner_action_required: {yv(owner_action)}
approval: none
sent: no
returned: none
---

# Handoff {handoff_id} — {task_id}

Written by `ai-os handoff prepare`. Nothing has been approved and nothing has been sent.
The record sits with the owner; `{to}` is only where it *would* go if the owner approved it.
Canonical written form: `{TEMPLATE_REF}`.

## 1. Handoff metadata

```
handoff_id:            {handoff_id}
task_id:               {task_id}
project:               {project}
task_title:            {title}
status:                {status}
created:               {created}
gate:                  {gate}
scope:                 {scope}
current_holder:        owner
next_holder:           {to}
owner_action_required: {owner_action}
```

## 2. Outgoing packet

The text between the markers is what a destination client is handed **if the owner approves
this handoff**. `prepare` does not copy, open, transmit or hand it to anything: only
`ai-os handoff send` does, only after `ai-os handoff approve` has recorded the owner's own
words for this exact id, gate, destination and scope, and only over a transport declared
`verified` in `governance/policies/handoff-transports.yaml`.

<!-- packet:begin -->
### Handoff {handoff_id} — {task_id}

```
handoff_id:  {handoff_id}
date:        {created[:10]}
project:     {project}
task_id:     {task_id}
executor_ai: unknown — prepare records no executor identity
reviewer_ai: {to}
owner:       (this workspace's owner)
gate:        {gate}
scope:       {scope}
```

**Task.** {title}

**Summary.** {summary_text}

**What is being asked.** Act on the gate above, inside the scope above, and nothing else.
Name every file touched outside that scope.

**Verification.** Not run. Nothing described in this packet has been executed or verified
by the command that wrote it.
<!-- packet:end -->

## 3. Owner approval

No approval recorded. `prepare` cannot record one — an approval is the owner's grant in the
owner's own words, and only `ai-os handoff approve` writes it.

## 4. Send

Nothing sent. `prepare` has no send path of any kind — no network, no subprocess, no
clipboard, no connector. `ai-os handoff send` refuses until the approval above exists and a
verified transport for the destination is declared.

## 5. Returned block

Nothing returned. `prepare` has no receive path: only `ai-os handoff receive` attaches a
returned block, only from the client the packet went to, and only once it has been sent.

## 6. Audit

```
prepared_by:      ai-os handoff prepare
prepared_command: {argv_shown}
prepared_at:      {created}
approved:         no — V2 did not approve this handoff and has no code path that could
sent:             no — V2 did not send this handoff; nothing left this machine
transport:        none
clients_contacted: none
payload_hash:     n/a — nothing was transmitted, so there is nothing to hash
```
"""


# ---------------------------------------------------------------------------------------
def cmd_prepare(args):
    if not args or args[0].startswith("-"):
        die("usage: ai-os handoff prepare <task-id> --to <client> --gate <gate> --scope <scope> "
            "[--summary <text>] [--status draft|waiting-owner] [--id <handoff-id>]")
    task_id, rest = args[0], args[1:]
    to = gate = scope = summary = handoff_id = None
    status = "draft"
    seen = set()
    i = 0
    while i < len(rest):
        a = rest[i]
        if a in ("--to", "--gate", "--scope", "--summary", "--status", "--id"):
            if i + 1 >= len(rest):
                die(f"{a} needs a value")
            if a in seen:
                die(f"{a} was given more than once — one handoff has one {a[2:]}")
            seen.add(a)
            v = rest[i + 1]
            if a == "--to":       to = v
            elif a == "--gate":   gate = v
            elif a == "--scope":  scope = v
            elif a == "--summary": summary = v
            elif a == "--status": status = v
            else:                 handoff_id = v
            i += 2
        else:
            die(f"unknown argument {a!r}")

    # --- every check below runs before a single byte is written ------------------------
    d = task_dir(task_id)

    if to is None:
        die("--to is required — a handoff with no destination is not a handoff")
    clients = known_clients()
    if re.search(r"[,\s]", to):
        die(f"--to names more than one destination: {to!r}. One handoff goes to one client.")
    if clients and to not in clients:
        die(f"unknown destination client {to!r} — known clients: {', '.join(clients)}")

    if not gate:
        die("--gate is required — an approval is only ever valid for one exact gate")
    if gate not in GATES:
        die(f"unknown gate {gate!r} — one of: {', '.join(GATES)}")

    if not scope or not scope.strip():
        die("--scope is required — an approval is only ever valid for one exact scope")

    if status not in STATUSES:
        die(f"--status {status!r} is not writable by V2 — one of: {', '.join(STATUSES)}")

    if handoff_id is not None:
        if not SAFE.fullmatch(handoff_id):
            die(f"not a handoff id: {handoff_id!r} — [A-Za-z0-9._-], one segment")
    else:
        handoff_id = next_id(d)

    p = record_path(d, handoff_id)
    if p.exists():
        die(f"handoff {handoff_id} already exists at {p} — records are never overwritten", code=2)

    scan_credentials(scope, summary or "")

    created = time.strftime("%Y-%m-%d %H:%M:%S")
    argv_shown = " ".join(["ai-os handoff prepare", task_id, "--to", to, "--gate", gate,
                           "--scope", "<scope>"] + (["--summary", "<summary>"] if summary else []))
    p.write_text(render(handoff_id=handoff_id, task_id=task_id, status=status, created=created,
                        to=to, gate=gate, scope=scope, summary=summary,
                        project=task_field(d, "project"), title=task_field(d, "title"),
                        argv_shown=argv_shown))
    print(f"  {G}prepared{X}  {handoff_id}  {D}{p}{X}")
    print(f"  status: {status} · gate: {gate} · next holder: {to}")
    print(f"  {D}not approved, not sent — V2 writes the record and stops there{X}")
    return 0


def cmd_show(args):
    if len(args) < 2:
        die("usage: ai-os handoff show <task-id> <handoff-id>")
    d = task_dir(args[0])
    p, _text, _meta = load_record(d, args[1])
    sys.stdout.write(p.read_text(errors="replace"))
    return 0


def cmd_approve(args):
    if len(args) < 2:
        die("usage: ai-os handoff approve <task-id> <handoff-id> --gate <gate> --to <client> "
            "--scope <scope> --owner-words <text>")
    task_id, handoff_id, rest = args[0], args[1], args[2:]
    gate = to = scope = owner_words = None
    seen = set()
    i = 0
    while i < len(rest):
        a = rest[i]
        if a in ("--gate", "--to", "--scope", "--owner-words"):
            if i + 1 >= len(rest):
                die(f"{a} needs a value")
            if a in seen:
                die(f"{a} was given more than once — an approval is one exact tuple")
            seen.add(a)
            v = rest[i + 1]
            if a == "--gate":          gate = v
            elif a == "--to":          to = v
            elif a == "--scope":       scope = v
            else:                      owner_words = v
            i += 2
        else:
            die(f"unknown argument {a!r}")

    d = task_dir(task_id)
    p, text, meta = load_record(d, handoff_id)

    if not gate:
        die("--gate is required — approval is only valid for one exact gate")
    if gate not in GATES:
        die(f"unknown gate {gate!r} — one of: {', '.join(GATES)}")
    if not to:
        die("--to is required — approval is only valid for one exact destination")
    if re.search(r"[,\s]", to):
        die(f"--to names more than one destination: {to!r}. One approval goes to one client.")
    clients = known_clients()
    if clients and to not in clients:
        die(f"unknown destination client {to!r} — known clients: {', '.join(clients)}")
    if not scope or not scope.strip():
        die("--scope is required — approval is only valid for one exact scope")
    if not owner_words or not owner_words.strip():
        die("--owner-words is required — approval must be explicit owner-provided text")

    scan_credentials(owner_words)

    expected = {
        "handoff_id": handoff_id,
        "gate": gate,
        "to": to,
        "scope": scope,
    }
    for key, actual in expected.items():
        record_val = meta.get(key)
        if record_val != actual:
            die(f"approval tuple mismatch for {key}: record has {record_val!r}, command has {actual!r}")

    status = meta.get("status")
    if status == "approved":
        die(f"handoff {handoff_id} is already approved — approvals are not overwritten")
    if status != "waiting-owner":
        die(f"handoff {handoff_id} is {status!r}; V3 can approve only waiting-owner records")

    approved_at = time.strftime("%Y-%m-%d %H:%M:%S")
    updated = replace_frontmatter(text, {
        "status": "approved",
        "owner_action_required": "none",
        "approval": "recorded",
        "approved_at": approved_at,
        "approved_gate": gate,
        "approved_to": to,
        "approved_scope": scope,
        "owner_words": owner_words,
    }, add_order=("approved_at", "approved_gate", "approved_to", "approved_scope", "owner_words"))

    approval_body = f"""Approval recorded by `ai-os handoff approve`.

```
approved:      yes
approved_at:   {approved_at}
handoff_id:    {handoff_id}
gate:          {gate}
to:            {to}
scope:         {scope}
owner_words:   {owner_words}
```

This approval is valid only for the exact tuple above. It does not send the packet and
does not approve any later gate.
"""
    updated = replace_section(updated, "## 3. Owner approval", approval_body)
    updated = updated.replace(
        "approved:         no — V2 did not approve this handoff and has no code path that could",
        f"approved:         yes — V3 recorded explicit owner approval at {approved_at}"
    )
    p.write_text(updated)
    print(f"  {G}approved{X}  {handoff_id}  {D}{p}{X}")
    print(f"  gate: {gate} · to: {to} · scope: {scope}")
    print(f"  {D}not sent — V3 records approval and stops there{X}")
    return 0


def _approval_ref(meta):
    return (f"recorded {meta.get('approved_at')} · gate {meta.get('approved_gate')} · "
            f"to {meta.get('approved_to')} · scope {meta.get('approved_scope')}")


def _record_blocked(p, text, meta, to, spec, packet, digest, reason):
    """A blocker, written into the record. Not a send, and never dressed up as one."""
    at = time.strftime("%Y-%m-%d %H:%M:%S")
    body = f"""Not sent — **blocked**. There is no verified transport for `{to}`.

```
sent:              no
blocked_at:        {at}
reason:            {reason}
transport:         {(spec or {}).get('name', 'none declared')}
destination:       {to}
approval:          {_approval_ref(meta)}
payload_sha256:    {digest}
payload_bytes:     {len(packet.encode())}
unblocks_when:     the owner runs that client's one-shot mode by hand against a real
                   packet, then sets verified: true in governance/policies/handoff-transports.yaml
```

Nothing was sent. Nothing was copied, printed to another process, spawned, queued or put on
a network. The owner approval in section 3 is untouched and remains valid, so enabling a
transport later needs no second approval — the approval is for the destination, not for the
mechanism that reaches it.
"""
    updated = replace_section(text, "## 4. Send", body)
    updated = set_audit_lines(updated, {
        "sent": f"no — blocked {at}: {reason}",
        "transport": "none available",
        "clients_contacted": "none",
        "payload_hash": f"sha256 {digest} (of the packet that was NOT sent)",
    })
    p.write_text(updated)
    print(f"  {Y}blocked{X}  {reason}", file=sys.stderr)
    print(f"  {D}recorded in {p} · nothing was sent{X}", file=sys.stderr)
    return 5


def _record_failed(p, text, meta, to, spec, argv, packet, digest, started, detail):
    """The transport ran and did not succeed. Recorded once; never retried."""
    at = time.strftime("%Y-%m-%d %H:%M:%S")
    body = f"""Not sent — the transport **failed**. The packet did not arrive.

```
sent:              no
attempted_at:      {started}
failed_at:         {at}
destination:       {to}
transport:         {spec.get('name')}
command:           {argv_shown(argv)}
failure:           {detail}
approval:          {_approval_ref(meta)}
payload_sha256:    {digest}
payload_bytes:     {len(packet.encode())}
```

One attempt was made, in the foreground, and it failed. Nothing was retried and nothing was
queued for later. The status stays `approved`: fix the cause and run `ai-os handoff send`
again, or record a blocker if the transport turns out not to work.
"""
    updated = replace_section(text, "## 4. Send", body)
    updated = set_audit_lines(updated, {
        "sent": f"no — transport failed {at}: {detail}",
        "transport": f"{spec.get('name')} (attempted, failed)",
        "clients_contacted": f"{to} — attempted, delivery not confirmed",
        "payload_hash": f"sha256 {digest}",
        "sent_command": argv_shown(argv),
    })
    p.write_text(updated)
    print(f"\n  {R}failed{X}  {detail}", file=sys.stderr)
    print(f"  {D}recorded in {p} · not retried{X}", file=sys.stderr)
    return 7


def _record_sent(p, text, meta, to, spec, argv, packet, digest, sent_at):
    body = f"""Sent by `ai-os handoff send`, in the foreground, in one call.

```
sent:              yes
sent_at:           {sent_at}
destination:       {to}
transport:         {spec.get('name')}
command:           {argv_shown(argv)}
approval:          {_approval_ref(meta)}
owner_words:       section 3 of this record — stored verbatim there, not repeated here
payload_sha256:    {digest}
payload_bytes:     {len(packet.encode())}
return_expected:   section 5 of this record, attached by `ai-os handoff receive` (V5)
```

What was sent is exactly the text between the packet markers in section 2 — the hash above
is of those bytes and of nothing else. The packet went to the client on stdin, so it never
appeared in a process listing.

The destination's reply went to the terminal the owner was watching. This command does not
capture, read, interpret or store it, and it has not advanced anything: the handoff now
sits with `{to}`, and bringing an answer back is the owner's next decision.
"""
    updated = replace_frontmatter(text, {
        "status": "sent",
        "sent": "yes",
        "sent_at": sent_at,
        "sent_to": to,
        "sent_transport": spec.get("name"),
        "payload_sha256": digest,
        "current_holder": to,
        "next_holder": "owner",
        "owner_action_required": "none",
    }, add_order=("sent_at", "sent_to", "sent_transport", "payload_sha256"))
    updated = replace_section(updated, "## 4. Send", body)
    updated = sync_metadata_block(updated, {
        "status": "sent", "current_holder": to, "next_holder": "owner",
        "owner_action_required": "none",
    })
    updated = set_audit_lines(updated, {
        "sent": f"yes — {sent_at}, foreground, one call, no retry",
        "transport": spec.get("name"),
        "clients_contacted": to,
        "payload_hash": f"sha256 {digest}",
        "sent_command": argv_shown(argv),
        "approval_ref": _approval_ref(meta),
        "owner_words_ref": "section 3 of this record, verbatim",
        "return_expected": "section 5 of this record, via ai-os handoff receive (V5)",
    })
    p.write_text(updated)
    print(f"\n  {G}sent{X}  {meta.get('handoff_id')} → {to}  {D}{p}{X}")
    print(f"  status: sent · sha256 {digest[:16]}… · reply is above, and is not stored")
    return 0


def cmd_send(args):
    dry, rest = False, []
    for a in args:
        if a == "--dry-run":
            if dry:
                die("--dry-run was given more than once")
            dry = True
        elif a.startswith("-"):
            die(f"unknown argument {a!r}")
        else:
            rest.append(a)
    if len(rest) != 2:
        die("usage: ai-os handoff send <task-id> <handoff-id> [--dry-run]")
    task_id, handoff_id = rest

    d = task_dir(task_id)
    p, text, meta = load_record(d, handoff_id)

    # --- preflight. Nothing here writes, and nothing below it runs until all of it
    # --- passes. Every one of these is a refusal that leaves the record untouched. -----
    if meta.get("sent") == "yes" or meta.get("status") == "sent":
        die(f"handoff {handoff_id} was already sent at {meta.get('sent_at', 'an unrecorded time')}; "
            f"a packet is never sent twice")
    if meta.get("status") != "approved":
        die(f"handoff {handoff_id} is {meta.get('status')!r}, not 'approved'. "
            f"Send is refused and nothing was sent.")
    if meta.get("approval") != "recorded":
        die(f"no owner approval is recorded for {handoff_id!r}. "
            f"Send is refused and nothing was sent.")
    missing = [k for k in ("approved_at", "approved_gate", "approved_to", "approved_scope",
                           "owner_words") if not str(meta.get(k) or "").strip()]
    if missing:
        die(f"the approval in {p} is incomplete: missing {', '.join(missing)}. "
            f"An incomplete approval is not an approval.")
    for approved_key, record_key in (("approved_gate", "gate"), ("approved_to", "to"),
                                     ("approved_scope", "scope")):
        if meta.get(approved_key) != meta.get(record_key):
            die(f"approval tuple mismatch in {p}: {approved_key} is "
                f"{meta.get(approved_key)!r} but {record_key} is {meta.get(record_key)!r}. "
                f"An approval is valid for one exact tuple only.")
    to = str(meta.get("to") or "")
    if not to or re.search(r"[,\s]", to):
        die(f"the record names {to!r} as its destination; exactly one destination is required")
    clients = known_clients()
    if clients and to not in clients:
        die(f"unknown destination client {to!r} — known clients: {', '.join(clients)}")
    packet = extract_packet(text, p)
    scan_credentials(packet)
    # -----------------------------------------------------------------------------------

    digest = hashlib.sha256(packet.encode()).hexdigest()
    spec, binary, unavailable = resolve_transport(to)
    argv = [binary] + list(spec.get("argv") or []) if binary else []

    if dry:
        print(f"\n  {B}dry run{X}  handoff {handoff_id} → {to}   "
              f"{D}nothing is sent and nothing is written{X}\n")
        print(f"  approval:       {_approval_ref(meta)}")
        print(f"  transport:      {spec.get('name') if spec else 'none declared'}")
        if unavailable:
            print(f"  {Y}unavailable{X}     {unavailable}")
            print(f"  {D}a real send would be refused and recorded as a blocker{X}")
        else:
            print(f"  command:        {argv_shown(argv)}")
            print(f"  {D}packet on stdin — never in argv{X}")
        print(f"  payload_sha256: {digest}")
        print(f"  payload_bytes:  {len(packet.encode())}")
        print(f"\n{D}--- packet begins ---{X}\n{packet}\n{D}--- packet ends ---{X}\n")
        return 0

    if unavailable:
        return _record_blocked(p, text, meta, to, spec, packet, digest, unavailable)

    timeout = spec.get("timeout")
    if not isinstance(timeout, int) or timeout <= 0:
        timeout = 300
    started = time.strftime("%Y-%m-%d %H:%M:%S")
    print(f"\n  {B}sending{X}  handoff {handoff_id} → {to}")
    print(f"  transport: {spec.get('name')}")
    print(f"  command:   {argv_shown(argv)}")
    print(f"  payload:   sha256 {digest} · {len(packet.encode())} bytes, on stdin")
    print(f"  {D}foreground, one call, {timeout}s cap, no retry — its output follows{X}\n")

    # The one and only call out of this file. A list argv executed directly: no shell, so
    # nothing in the packet can be interpreted as a command. stdout and stderr are NOT
    # captured — they are inherited, so the reply lands in front of the owner and this
    # command never holds it. Reading a reply is `receive`, and that is V5.
    try:
        proc = subprocess.run(argv, input=packet, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return _record_failed(p, text, meta, to, spec, argv, packet, digest, started,
                              f"no response within the {timeout}s cap")
    except (OSError, subprocess.SubprocessError) as e:
        return _record_failed(p, text, meta, to, spec, argv, packet, digest, started,
                              f"{type(e).__name__}: {e}")
    if proc.returncode != 0:
        return _record_failed(p, text, meta, to, spec, argv, packet, digest, started,
                              f"the transport exited {proc.returncode}")
    return _record_sent(p, text, meta, to, spec, argv, packet, digest,
                        time.strftime("%Y-%m-%d %H:%M:%S"))


def cmd_receive(args):
    if len(args) < 2 or args[0].startswith("-") or args[1].startswith("-"):
        die("usage: ai-os handoff receive <task-id> <handoff-id> --from <client> "
            "--file <path> [--status returned|reviewed]")
    task_id, handoff_id, rest = args[0], args[1], args[2:]
    frm = src_arg = None
    new_status = "returned"
    seen = set()
    i = 0
    while i < len(rest):
        a = rest[i]
        if a in ("--from", "--file", "--status"):
            if i + 1 >= len(rest):
                die(f"{a} needs a value")
            if a in seen:
                die(f"{a} was given more than once — one returned block has one {a[2:]}")
            seen.add(a)
            v = rest[i + 1]
            if a == "--from":     frm = v
            elif a == "--file":   src_arg = v
            else:                 new_status = v
            i += 2
        else:
            die(f"unknown argument {a!r}")

    d = task_dir(task_id)
    p, text, meta = load_record(d, handoff_id)

    # --- preflight. Nothing here writes. Every branch is a refusal that leaves the
    # --- record, the approval and the send audit exactly as they were. -----------------
    if not frm:
        die("--from is required — a returned block has to say which client it came from")
    if re.search(r"[,\s]", frm):
        die(f"--from names more than one client: {frm!r}. One reply comes from one client.")
    clients = known_clients()
    if clients and frm not in clients:
        die(f"unknown client {frm!r} — known clients: {', '.join(clients)}")
    if not src_arg:
        die("--file is required — a returned block is a file the owner can open and read, "
            "never text this command invents")
    src = Path(src_arg).expanduser()
    if not src.is_file():
        die(f"no such file: {src}", code=4)
    if new_status not in RECEIVE_STATUSES:
        die(f"--status {new_status!r} is not writable by receive — one of: "
            f"{', '.join(RECEIVE_STATUSES)}. Receiving never approves and never closes.")

    # Checked before the status, because a record that already carries a reply has moved
    # off `sent` — and "a block is already attached" tells the owner far more than
    # "the status is not sent" would.
    if meta.get("returned") not in (None, "", "none"):
        die(f"handoff {handoff_id} already carries a returned block "
            f"({meta.get('returned')!r}); a returned block is never overwritten. "
            f"A second reply is a new handoff.")
    if meta.get("status") != "sent":
        die(f"handoff {handoff_id} is {meta.get('status')!r}, not 'sent'. Nothing was sent to "
            f"this destination, so there is no reply to attach.")
    sent_to = meta.get("sent_to") or meta.get("to")
    if frm != sent_to:
        die(f"this handoff was sent to {sent_to!r}, so a reply from {frm!r} is not its reply. "
            f"A returned block only ever comes back from where the packet went.")

    try:
        returned = src.read_text(errors="replace")
    except OSError as e:
        die(f"cannot read {src}: {e}", code=4)
    raw_size = len(returned.encode())
    if not returned.strip():
        die(f"{src} is empty; an empty returned block records nothing")
    if raw_size > MAX_RETURNED_BYTES:
        die(f"{src} is {raw_size} bytes; the cap is {MAX_RETURNED_BYTES}. A returned block is "
            f"meant to be read by a person — keep the file beside the task and reference it.")
    if RETURNED_BEGIN in returned or RETURNED_END in returned:
        die(f"{src} contains the returned-block markers itself, which would break the "
            f"boundary between the record and the text it quotes")
    scan_credentials(returned)
    # -----------------------------------------------------------------------------------

    # Hash and count the bytes that actually land in the block, not the bytes on disk:
    # the record has to be verifiable from itself, and what a reader can re-hash is what
    # sits between the markers.
    returned = returned.strip("\n")
    size = len(returned.encode())
    digest = hashlib.sha256(returned.encode()).hexdigest()
    at = time.strftime("%Y-%m-%d %H:%M:%S")

    body = f"""Returned by `ai-os handoff receive` from `{frm}` at {at}.

```
returned:          attached
received_at:       {at}
received_from:     {frm}
source_file:       {src}
returned_sha256:   {digest}
returned_bytes:    {size}
next_hop:          not chosen — receiving never decides one
```

The block below is `{frm}`'s own text, attached verbatim. This command did not read it,
interpret it, summarise it, act on it, or turn any part of it into a next step.

{RETURNED_BEGIN}
{returned}
{RETURNED_END}

The handoff stops here, with the owner. Whatever the block above recommends is a
recommendation: acting on it takes a new handoff, prepared and approved on its own terms.
`receive` never approves, never sends, never closes the task, and never picks the next
holder — the approval in section 3 stays exactly what the owner wrote, for the hop that has
already happened.
"""
    updated = replace_frontmatter(text, {
        "status": new_status,
        "returned": "attached",
        "received_at": at,
        "received_from": frm,
        "received_file": str(src),
        "returned_sha256": digest,
        "current_holder": "owner",
        "next_holder": "undecided",
        "owner_action_required": "resume",
    }, add_order=("received_at", "received_from", "received_file", "returned_sha256"))
    updated = replace_section(updated, "## 5. Returned block", body)
    updated = sync_metadata_block(updated, {
        "status": new_status, "current_holder": "owner", "next_holder": "undecided",
        "owner_action_required": "resume",
    })
    updated = set_audit_lines(updated, {
        "returned_from": f"{frm} — {at}",
        "returned_file": str(src),
        "returned_hash": f"sha256 {digest}",
        "next_hop": "not chosen — receive never advances the loop",
    })
    p.write_text(updated)
    print(f"\n  {G}received{X}  {handoff_id} ← {frm}  {D}{p}{X}")
    print(f"  status: {new_status} · sha256 {digest[:16]}… · {size} bytes attached verbatim")
    print(f"  {D}nothing approved, nothing sent, no next hop chosen — it is the owner's move{X}")
    return 0


def cmd_list(args):
    if not args:
        die("usage: ai-os handoff list <task-id>")
    d = task_dir(args[0])
    rows = records(d)
    if not rows:
        print(f"\n  no handoff records in {d}\n")
        return 0
    print(f"\n  {B}handoffs{X}  {D}{d}{X}\n")
    print(f"  {'HANDOFF ID':<20} {'STATUS':<15} {'TO':<14} GATE")
    for f in rows:
        meta = {}
        for line in f.read_text(errors="replace").splitlines()[1:40]:
            if line.strip() == "---":
                break
            k, sep, v = line.partition(":")
            if sep:
                meta[k.strip()] = v.strip().strip('"')
        print(f"  {meta.get('handoff_id', f.stem):<20} {meta.get('status', '?'):<15} "
              f"{meta.get('to', '?'):<14} {meta.get('gate', '?')}")
    print()
    return 0


CMDS = {"prepare": cmd_prepare, "show": cmd_show, "list": cmd_list,
        "approve": cmd_approve, "send": cmd_send, "receive": cmd_receive}

if __name__ == "__main__":
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__)
        sys.exit(0 if a else 2)
    if a[0] not in CMDS:
        print(f"  ai-os handoff: unknown command {a[0]!r}", file=sys.stderr)
        print(__doc__, file=sys.stderr)
        sys.exit(2)
    sys.exit(CMDS[a[0]](a[1:]))
