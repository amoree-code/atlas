#!/usr/bin/env python3
"""Safe additive migration for private Atlas data.

  atlas migrate plan --source <old-private-root> [--json]
  atlas migrate apply --source <old-private-root> --approve [--json]
  atlas migrate rollback --receipt <path> --approve [--json]

Only private data roots are considered. The command never reads file contents, never
overwrites an existing destination, and never copies credential-shaped files.
"""
import hashlib, json, os, re, shutil, subprocess, sys, time
from pathlib import Path

ATLAS = Path(os.environ.get("ATLAS_HOME", Path.home() / "atlas"))
ROOTS = ("personal", "projects", "sessions", "internal/config")
SECRET = re.compile(r"(^|[._-])(env|token|secret|credential|password|key)([._-]|$)", re.I)

def die(msg):
    print(f"migrate: {msg}", file=sys.stderr); raise SystemExit(2)

def parse(args, required):
    out = {"json": False, "approve": False}
    i = 0
    while i < len(args):
        if args[i] in ("--json", "--approve"):
            out[args[i][2:]] = True; i += 1; continue
        if args[i].startswith("--") and i + 1 < len(args):
            key = args[i][2:]
            if key not in required and key not in ("source", "receipt"):
                die(f"unknown argument {args[i]!r}")
            if key in out: die(f"--{key} was given more than once")
            out[key] = args[i + 1]; i += 2; continue
        die(f"unknown or incomplete argument {args[i]!r}")
    for key in required:
        if not out.get(key): die(f"--{key} is required")
    return out

def files(source):
    result = []
    for root in ROOTS:
        base = source / root
        if not base.is_dir(): continue
        for path in sorted(p for p in base.rglob("*") if p.is_file()):
            rel = path.relative_to(source)
            if any(SECRET.search(part) for part in rel.parts):
                result.append((str(rel), "secret-shaped")); continue
            result.append((str(rel), "candidate"))
    return result

def build_plan(source):
    rows = []
    for rel, kind in files(source):
        dst = ATLAS / rel
        if kind != "candidate": action = "skip"
        elif dst.exists(): action = "preserve-existing"
        else: action = "copy"
        rows.append({"path": rel, "action": action})
    return {"source": str(source), "destination": str(ATLAS), "files": rows,
            "copy_count": sum(r["action"] == "copy" for r in rows),
            "skip_count": sum(r["action"] != "copy" for r in rows)}

def emit(value, as_json):
    if as_json: print(json.dumps(value, sort_keys=True))
    else:
        print(f"source: {value['source']}\ndestination: {value['destination']}")
        print(f"copy: {value.get('copy_count', 0)}  preserve/skip: {value.get('skip_count', 0)}")
        for row in value.get("files", []): print(f"  {row['action']:<18} {row['path']}")

def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

def doctor_exit():
    return subprocess.run([str(Path(__file__).with_name("atlas-doctor")), "--quiet"],
                          env=os.environ.copy(), capture_output=True).returncode

def cmd_plan(args):
    opt = parse(args, {"source"}); source = Path(opt["source"]).expanduser()
    if not source.is_dir(): die(f"source is not a directory: {source}")
    emit(build_plan(source), opt["json"]); return 0

def cmd_apply(args):
    opt = parse(args, {"source"});
    if not opt["approve"]: die("apply requires explicit --approve")
    source = Path(opt["source"]).expanduser()
    if not source.is_dir(): die(f"source is not a directory: {source}")
    plan = build_plan(source); created = []
    for row in plan["files"]:
        if row["action"] != "copy": continue
        src, dst = source / row["path"], ATLAS / row["path"]
        if dst.exists(): continue
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dst); created.append(row["path"])
    receipt = ATLAS / "runtime" / "migrations" / f"migration-{time.strftime('%Y%m%d-%H%M%S')}-{os.urandom(3).hex()}.json"
    receipt.parent.mkdir(parents=True, exist_ok=True)
    value = {"kind": "atlas-migration", "source": str(source), "destination": str(ATLAS),
             "created": [{"path": rel, "sha256": digest(ATLAS / rel)} for rel in created],
             "created_at": time.strftime("%Y-%m-%d %H:%M:%S"),
             "doctor_exit": doctor_exit()}
    receipt.write_text(json.dumps(value, indent=2) + "\n")
    value["receipt"] = str(receipt); emit(value, opt["json"]); return 0

def cmd_rollback(args):
    opt = parse(args, {"receipt"})
    if not opt["approve"]: die("rollback requires explicit --approve")
    receipt = Path(opt["receipt"]).expanduser()
    if not receipt.is_file(): die(f"receipt is not a file: {receipt}")
    try: value = json.loads(receipt.read_text())
    except (OSError, json.JSONDecodeError): die("receipt is unreadable")
    if value.get("kind") != "atlas-migration" or value.get("destination") != str(ATLAS):
        die("receipt does not belong to this Atlas root")
    removed = []
    preserved = []
    for item in value.get("created", []):
        rel = item.get("path") if isinstance(item, dict) else item
        path = ATLAS / rel
        expected = item.get("sha256") if isinstance(item, dict) else None
        if path.is_file() and (expected is None or digest(path) == expected):
            path.unlink(); removed.append(rel)
        elif path.exists():
            preserved.append(rel)
    result = {"receipt": str(receipt), "removed": removed, "preserved": preserved,
              "removed_count": len(removed), "doctor_exit": doctor_exit()}
    emit(result, opt["json"]); return 0

CMDS = {"plan": cmd_plan, "apply": cmd_apply, "rollback": cmd_rollback}
if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in CMDS:
        print(__doc__); raise SystemExit(2)
    raise SystemExit(CMDS[sys.argv[1]](sys.argv[2:]))
