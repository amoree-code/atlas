def cmd_list(_args):
    if not RUNTIME_DIR.is_dir() or not any(RUNTIME_DIR.glob("*.json")):
        print(f"\n  no Agentic runs in {RUNTIME_DIR}\n")
        return 0
    print(f"\n  {D}{RUNTIME_DIR}{X}\n")
    print(f"  {'RUN ID':<34} {'STATUS':<12} {'CONFIRM':<10} {'CONTEXT':<8} GOAL.TICKET")
    for f in sorted(RUNTIME_DIR.glob("*.json")):
        try:
            r = json.loads(f.read_text())
        except (json.JSONDecodeError, OSError):
            continue
        confirmation = r.get("confirmation") or {}
        print(f"  {r.get('run_id', f.stem):<34} {r.get('status', '?'):<12} "
              f"{confirmation.get('status', 'missing'):<10} "
              f"{(confirmation.get('context_policy') or {}).get('mode', '-'):<8} "
              f"{r.get('goal', {}).get('ticket', '?')}")
    print()
    return 0


def cmd_transition(args):
    if not args:
        die("usage: atlas agentic transition <run_id> --status <state> --reason <text> "
            "[--stage <name>] [--workflow <name>]")
    run_id = args[0]
    status, reason, stage, workflow = None, None, None, None
    i = 1
    while i < len(args):
        if args[i] in ("--status", "--reason", "--stage", "--workflow") and i + 1 < len(args):
            key = args[i][2:]
            if {"status": status, "reason": reason, "stage": stage,
                "workflow": workflow}[key] is not None:
                die(f"{args[i]} was given more than once")
            if key == "status": status = args[i + 1]
            elif key == "reason": reason = args[i + 1]
            elif key == "stage": stage = args[i + 1]
            else: workflow = args[i + 1]
            i += 2
        else:
            die(f"unknown or incomplete argument {args[i]!r}")
    if status not in LIFECYCLE:
        die(f"--status must be one of {LIFECYCLE}")
    if not _nonempty_str(reason):
        die("--reason is required and must be non-empty")
    rec, p = load_run(run_id)
    current = rec.get("status")
    if status not in TRANSITIONS.get(current, set()):
        die(f"invalid lifecycle transition {current!r} -> {status!r}", code=5)
    rec["status"] = status
    if stage is not None:
        if not _nonempty_str(stage):
            die("--stage must be non-empty")
        rec["stage"] = stage.strip()
    if workflow is not None:
        if not _nonempty_str(workflow):
            die("--workflow must be non-empty")
        rec["workflow"] = workflow.strip()
    rec["updated_at"] = time.strftime("%Y-%m-%d %H:%M:%S")
    rec.setdefault("events", []).append({"kind": "transition", "from": current,
        "to": status, "reason": reason.strip(), "at": rec["updated_at"]})
    save_run(rec, p)
    print(f"  {G}transitioned{X}  {run_id}: {current} -> {status}")
    return 0


def _safe_routing_ref(value):
    if not _nonempty_str(value) or value.startswith("/"):
        return False
    parts = Path(value).parts
    return ".." not in parts and not value.startswith("personal/inbox/")


def cmd_capture(args):
    if not args:
        die("usage: atlas agentic capture <run_id> --kind <context|artifact> --ref <path> "
            "--classification <label>")
    run_id = args[0]
    opts = {"kind": None, "ref": None, "classification": None}
    i = 1
    while i < len(args):
        if args[i].startswith("--") and args[i][2:] in opts and i + 1 < len(args):
            key = args[i][2:]
            if opts[key] is not None:
                die(f"{args[i]} was given more than once")
            opts[key] = args[i + 1]
            i += 2
        else:
            die(f"unknown or incomplete argument {args[i]!r}")
    if opts["kind"] not in ("context", "artifact"):
        die("--kind must be 'context' or 'artifact'")
    if not _safe_routing_ref(opts["ref"]):
        die("--ref must be a non-absolute, contained path and may not target personal/inbox")
    if not _nonempty_str(opts["classification"]):
        die("--classification is required and must be non-empty")
    rec, p = load_run(run_id)
    if rec.get("status") in TERMINAL:
        die(f"cannot capture into terminal run {run_id}", code=5)
    ts = time.strftime("%Y-%m-%d %H:%M:%S")
    rec.setdefault("routing", []).append({"kind": opts["kind"], "ref": opts["ref"],
        "classification": opts["classification"].strip(), "at": ts})
    rec["updated_at"] = ts
    save_run(rec, p)
    print(f"  {G}captured{X}  {opts['kind']} reference in {run_id}")
    return 0


def cmd_check(args):
    if not args:
        die("usage: atlas agentic check <run_id> [--capability <id>.<op> --scope <target> "
            "[--execute]] | [--permission-change]")
    run_id = args[0]
    opts = {"capability": None, "scope": None, "permission-change": False, "execute": False}
    i = 1
    while i < len(args):
        a = args[i]
        if a == "--capability" and i + 1 < len(args):
            opts["capability"] = args[i + 1]; i += 2
        elif a == "--scope" and i + 1 < len(args):
            opts["scope"] = args[i + 1]; i += 2
        elif a == "--permission-change":
            opts["permission-change"] = True; i += 1
        elif a == "--execute":
            opts["execute"] = True; i += 1
        else:
            die(f"unknown argument {a!r}")

    if bool(opts["capability"]) == bool(opts["permission-change"]):
        die("pass exactly one of --capability <id>.<op> or --permission-change")

    rec, p = load_run(run_id)

    if opts["permission-change"]:
        if opts["execute"]:
            die("--execute has no meaning with --permission-change — this command never "
                "performs a permission change itself, only decides whether one may proceed")
        allowed, reason, entry = check_permission_change(rec)
    else:
        if "." not in (opts["capability"] or ""):
            die("--capability must be '<capability>.<operation>'")
        if not opts["scope"]:
            die("--scope is required with --capability — an action with no declared "
                "target scope cannot be checked against the run's claims.scope")
        cap_id, _, op_name = opts["capability"].partition(".")
        allowed, reason, entry = check_capability_action(rec, cap_id, op_name, opts["scope"])

    rec.setdefault("permission_log", []).append(entry)
    rec["updated_at"] = time.strftime("%Y-%m-%d %H:%M:%S")
    save_run(rec, p)

    if not allowed:
        print(f"  {R}denied{X}  {reason}")
        return 5

    print(f"  {G}allowed{X}  {reason}")
    if opts["execute"]:
        # The one and only place this file ever reaches toward execution — and only after
        # `allowed` is already True. Always --dry-run: this boundary decides; it never
        # performs the action itself, verified or not.
        proc = subprocess.run([str(CLI_DIR / "atlas-capability"), "invoke",
                              opts["capability"], "--dry-run"], capture_output=True, text=True)
        print(proc.stdout.rstrip("\n"))
        return proc.returncode
    return 0


def cmd_approve(args):
    if not args:
        die("usage: atlas agentic approve <run_id> --owner-words \"…\"")
    run_id = args[0]
    owner_words = None
    i = 1
    while i < len(args):
        if args[i] == "--owner-words" and i + 1 < len(args):
            owner_words = args[i + 1]; i += 2
        else:
            die(f"unknown argument {args[i]!r}")
    if not (owner_words or "").strip():
        die("--owner-words is required and must be non-empty — approval is never inferred")

    rec, p = load_run(run_id)
    approval = rec.get("approval") or {"approval": "none", "approved_at": None,
                                       "owner_words": None}
    if approval.get("approval") == "recorded":
        die(f"{run_id} already has recorded approval evidence — approval is recorded at "
            f"most once; a second attempt after approval is refused, not overwritten",
            code=1)

    ts = time.strftime("%Y-%m-%d %H:%M:%S")
    rec["approval"] = {"approval": "recorded", "approved_at": ts,
                       "owner_words": owner_words.strip()}
    rec["updated_at"] = ts
    save_run(rec, p)
    print(f"  {G}recorded{X}  approval evidence for {run_id}")
    print(f"  owner words: {owner_words.strip()}")
    return 0


def cmd_confirm(args):
    if not args:
        die("usage: atlas agentic confirm <run_id> --packet-file <path> "
            "--tickets <T-###,...> --scope-ref <ref> --token-limit N --cost-limit-usd N")
    run_id = args[0]
    opts = {"packet-file": None, "tickets": None, "scope-ref": None,
            "token-limit": None, "cost-limit-usd": None}
    i = 1
    while i < len(args):
        key = args[i][2:] if args[i].startswith("--") else None
        if key in opts and i + 1 < len(args):
            if opts[key] is not None:
                die(f"--{key} was given more than once")
            opts[key] = args[i + 1]
            i += 2
        else:
            die(f"unknown or incomplete argument {args[i]!r}")
    if any(opts[key] is None for key in opts):
        die("confirmation requires --packet-file, --tickets, --scope-ref, "
            "--token-limit, and --cost-limit-usd")
    run, path = load_run(run_id)
    if run.get("confirmation", {}).get("status") == "confirmed":
        die(f"{run_id} already has confirmation — refusing to overwrite it", code=1)
    tickets = [ticket.strip() for ticket in opts["tickets"].split(",") if ticket.strip()]
    if not tickets or any(parse_ticket_id(ticket) is None for ticket in tickets):
        die("--tickets must be a comma-separated list of valid ticket ids")
    if len(set(tickets)) != len(tickets):
        die("--tickets must not contain duplicates")
    if run.get("goal", {}).get("ticket") not in tickets:
        die("--tickets must include the run's goal.ticket")
    if opts["scope-ref"] != (run.get("claims") or {}).get("scope"):
        die("--scope-ref must exactly equal the run's claims.scope")
    try:
        token_limit = int(opts["token-limit"])
        cost_limit = float(opts["cost-limit-usd"])
        if token_limit <= 0 or not math.isfinite(cost_limit) or cost_limit <= 0:
            raise ValueError("limits must be positive")
        packet_path = Path(opts["packet-file"]).expanduser().resolve()
        runtime_packets = (_ATLAS_HOME / "runtime" / "packets").resolve()
        if packet_path == runtime_packets or not str(packet_path).startswith(str(runtime_packets) + os.sep):
            die("--packet-file must be inside runtime/packets")
        packet = json.loads(packet_path.read_text(encoding="utf-8"))
        _context_packet.validate_packet(packet)
        if packet["root"]["ticket"] not in tickets:
            die("packet ticket is not included in --tickets")
        if packet["root"]["scope"] != opts["scope-ref"]:
            die("packet scope does not match --scope-ref")
    except (OSError, json.JSONDecodeError, TypeError, ValueError) as exc:
        die(f"confirmation refused: {exc}")
    now = time.strftime("%Y-%m-%d %H:%M:%S")
    run["confirmation"] = {
        "status": "confirmed", "ticket_ids": tickets,
        "owner": run.get("actor", {}), "scope_ref": opts["scope-ref"],
        "packet_hash": _context_packet.packet_hash(packet),
        "context_policy": {"mode": "lazy", "max_files": 0, "max_ranges": 0},
        "token_limit": token_limit, "cost_limit_usd": cost_limit,
        "confirmed_at": now,
    }
    run["updated_at"] = now
    run.setdefault("events", []).append({"kind": "ticket-confirmation", "at": now,
                                         "ticket_ids": tickets, "scope_ref": opts["scope-ref"],
                                         "context_mode": "lazy"})
    save_run(run, path)
    print(f"  {G}confirmed{X}  {run_id}")
    print(f"  tickets: {','.join(tickets)}  scope: {opts['scope-ref']}  context: lazy")
    return 0


def cmd_preflight(args):
    if not args:
        die("usage: atlas agentic preflight <run_id> --packet-file <path> "
            "--estimated-cost-usd N --cost-limit-usd N "
            "--transport-verified <true|false> [--unresolved]")
    run_id = args[0]
    opts = {"packet-file": None, "estimated-cost-usd": None,
            "cost-limit-usd": None, "transport-verified": None, "unresolved": False}
    i = 1
    while i < len(args):
        key = args[i][2:] if args[i].startswith("--") else None
        if key == "unresolved":
            if opts[key]:
                die("--unresolved was given more than once")
            opts[key] = True
            i += 1
        elif key in opts and i + 1 < len(args):
            if opts[key] is not None:
                die(f"--{key} was given more than once")
            opts[key] = args[i + 1]
            i += 2
        else:
            die(f"unknown or incomplete argument {args[i]!r}")

    run, _ = load_run(run_id)  # prove this preflight belongs to a real Agentic run
    if opts["transport-verified"] not in ("true", "false"):
        die("--transport-verified must be true or false")
    try:
        packet_path = Path(opts["packet-file"]).expanduser()
        runtime_packets = (_ATLAS_HOME / "runtime" / "packets").resolve()
        packet_real = packet_path.resolve()
        if packet_real != runtime_packets and not str(packet_real).startswith(str(runtime_packets) + os.sep):
            die("--packet-file must be inside runtime/packets")
        packet = json.loads(packet_real.read_text(encoding="utf-8"))
        _context_packet.validate_packet(packet)
        confirmation = _preflight.confirmation_check(
            run, packet, _context_packet.packet_hash(packet))
        used_tokens, token_limit = _preflight.packet_budget(packet, run)
        result = _preflight.evaluate(
            used_tokens=used_tokens,
            token_limit=min(token_limit, confirmation["token_limit"]),
            estimated_cost_usd=float(opts["estimated-cost-usd"]),
            cost_limit_usd=min(float(opts["cost-limit-usd"]),
                               confirmation["cost_limit_usd"]),
            transport_verified=opts["transport-verified"] == "true",
            unresolved=opts["unresolved"],
        )
    except (TypeError, ValueError, _preflight.PreflightError) as exc:
        die(f"preflight refused: {exc}")
    print(json.dumps({"run_id": run_id, **result}, sort_keys=True))
    return 0 if result["decision"] == "CONTINUE" else 5


def cmd_reconcile(args):
    if not args:
        die("usage: atlas agentic reconcile <run_id> --usage-file <path> "
            "[--actual-cost-usd N] [--cost-limit-usd N]")
    run_id = args[0]
    opts = {"usage-file": None, "actual-cost-usd": None, "cost-limit-usd": None}
    i = 1
    while i < len(args):
        key = args[i][2:] if args[i].startswith("--") else None
        if key in opts and i + 1 < len(args):
            if opts[key] is not None:
                die(f"--{key} was given more than once")
            opts[key] = args[i + 1]
            i += 2
        else:
            die(f"unknown or incomplete argument {args[i]!r}")
    run, path = load_run(run_id)
    if "reconciliation" in run:
        die(f"{run_id} already has usage reconciliation — refusing to overwrite it", code=1)
    try:
        usage_path = Path(opts["usage-file"]).expanduser().resolve()
        report = json.loads(usage_path.read_text(encoding="utf-8"))
        actual = (float(opts["actual-cost-usd"])
                  if opts["actual-cost-usd"] is not None else None)
        limit = (float(opts["cost-limit-usd"])
                 if opts["cost-limit-usd"] is not None else None)
        reconciliation = _preflight.reconcile_usage(report, actual, limit)
    except (OSError, json.JSONDecodeError, TypeError, ValueError, _preflight.PreflightError) as exc:
        die(f"usage reconciliation refused: {exc}")
    now = time.strftime("%Y-%m-%d %H:%M:%S")
    run["reconciliation"] = {"source": str(usage_path), **reconciliation, "at": now}
    run.setdefault("events", []).append({"kind": "usage-reconciliation", "at": now,
                                         "cost_status": reconciliation["cost_status"],
                                         "total_tokens": reconciliation["total_tokens"]})
    run["updated_at"] = now
    save_run(run, path)
    print(json.dumps({"run_id": run_id, **reconciliation}, sort_keys=True))
    return 0 if reconciliation["reduction_signal"] != "over_budget" else 5


