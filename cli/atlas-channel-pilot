#!/usr/bin/env python3
"""Read-only CLI channel pilot packet builder."""

import argparse
import importlib.util
from importlib.machinery import SourceFileLoader
import json
import os
import sqlite3
import sys


def load_resolver():
    path = os.path.join(os.path.dirname(__file__), "atlas-channel")
    loader = SourceFileLoader("atlas_channel_resolver", path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def fail(message):
    print(json.dumps({"decision": "refused", "execution_allowed": False, "refusal_reason": message}, sort_keys=True))
    return 1


def main(argv):
    parser = argparse.ArgumentParser(prog="atlas channel pilot")
    for name in ("project", "session", "ticket", "mission", "scope", "role", "provider", "capability", "approval", "budget_usd"):
        parser.add_argument("--" + name.replace("_", "-"), required=True)
    parser.add_argument("--channel", choices=("cli", "extension", "desktop", "obsidian"), default="cli")
    parser.add_argument("--note")
    parser.add_argument("--knowledge-db")
    args = parser.parse_args(argv)

    try:
        budget = float(args.budget_usd)
    except ValueError:
        return fail("invalid_budget")
    if budget <= 0:
        return fail("invalid_budget")
    if args.approval != "approved":
        return fail("approval_not_granted")

    resolver = load_resolver()
    try:
        values = resolver.parse_args([
            "resolve", "--project", args.project, "--session", args.session,
            "--ticket", args.ticket, "--mission", args.mission, "--scope", args.scope,
        ])
        ticket_path = resolver.resolve_ticket_path(os.path.dirname(__file__), args.project, args.ticket)
        mission_path = resolver.resolve_contained_path(ticket_path, args.mission, "mission")
        with open(os.path.join(mission_path, "contract.json"), encoding="utf-8") as handle:
            contract = json.load(handle)
        with open(os.path.join(mission_path, "state.json"), encoding="utf-8") as handle:
            state = json.load(handle)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        return fail("invalid_mission:%s" % exc.__class__.__name__)

    if state.get("approval") != "recorded" or state.get("state") != "approved":
        return fail("mission_not_approved")
    role_field = {"planner": "planner_client", "executor": "executor_client", "verifier": "verifier_client"}.get(args.role)
    if role_field is None:
        return fail("invalid_role")
    if contract.get(role_field) != args.provider:
        return fail("provider_mismatch")
    allowed_tools = contract.get("allowed_tools", [])
    if args.capability not in allowed_tools:
        return fail("capability_outside_mission_boundary")

    if args.channel == "obsidian":
        if not args.note or not args.knowledge_db:
            return fail("obsidian_channel_requires_note_and_knowledge_db")
        db_path = os.path.abspath(args.knowledge_db)
        if not os.path.isfile(db_path):
            return fail("knowledge_db_not_found")
        try:
            conn = sqlite3.connect("file:%s?mode=ro" % db_path, uri=True)
            row = conn.execute(
                "SELECT 1 FROM notes WHERE path = ? AND removed = 0", (args.note,)
            ).fetchone()
            conn.close()
        except sqlite3.Error:
            return fail("knowledge_db_invalid")
        if row is None:
            return fail("note_not_indexed")

    packet = {
        "approval": args.approval,
        "budget_usd": budget,
        "capability": args.capability,
        "channel": args.channel,
        "decision": "bound",
        "execution_allowed": False,
        "mission_id": args.mission,
        "project_id": args.project,
        "provider": args.provider,
        "role": args.role,
        "scope": args.scope,
        "session_id": args.session,
        "ticket_id": args.ticket,
    }
    if args.note:
        packet["note"] = args.note
    print(json.dumps(packet, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
