#!/usr/bin/env bash
# ai-os-doctor — report problems, change nothing.
set -uo pipefail

AI_OS_HOME="${AI_OS_HOME:-$HOME/.ai-os}"
problems=0

echo "ai-os doctor — workspace: $AI_OS_HOME"
echo

if [ ! -d "$AI_OS_HOME" ]; then
  echo "FAIL  $AI_OS_HOME does not exist. Run ai-os-init first."
  exit 1
fi

for section in config memory knowledge projects sessions daily skills; do
  dir="$AI_OS_HOME/$section"
  if [ -d "$dir" ]; then
    count=$(find "$dir" -type f | wc -l | tr -d ' ')
    echo "OK    $section/  ($count files)"
  else
    echo "FAIL  $section/ missing"
    problems=$((problems + 1))
  fi
done

echo
if [ ! -f "$AI_OS_HOME/memory/MEMORY.md" ]; then
  echo "WARN  memory/MEMORY.md (retrieval index) missing"
  problems=$((problems + 1))
fi
if [ ! -f "$AI_OS_HOME/knowledge/README.md" ]; then
  echo "WARN  knowledge/README.md missing"
  problems=$((problems + 1))
fi

echo
if [ "$problems" -eq 0 ]; then
  echo "Clean."
else
  echo "$problems problem(s) found."
fi
exit "$problems"
